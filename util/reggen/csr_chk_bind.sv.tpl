//
// ${mod_base}_csr_chk_bind: binds the generated CSR checker into every instance of the
//   ${mod_name} register block. Generated by reggen (util/reggen/csr_chk_bind.sv.tpl). Do not
//   edit. The checker takes every port of the register block by name.
`default_nettype none

module ${mod_base}_csr_chk_bind;

  bind ${mod_name} ${mod_base}_csr_chk u_csr_chk (.*);

endmodule

`default_nettype wire
