<%
  from reggen import gen_rtl
  from reggen.multi_register import MultiRegister

  lblock = block.name.lower()
  alias_impl = "_" + block.alias_impl if block.alias_impl else ""
  reg_pkg = f'{lblock}{alias_impl}_reg_pkg'
  reg2hw_t = gen_rtl.get_iface_tx_type(block, if_name, False)
  hw2reg_t = gen_rtl.get_iface_tx_type(block, if_name, True)
  has_reg2hw = rb.get_n_bits(["q", "qe", "re"]) > 0
  has_hw2reg = rb.get_n_bits(["d", "de"]) > 0
  has_shadow = rb.has_internal_shadowed_reg()
  racl_support = (block.bus_interfaces.racl_support[if_name] or
                  block.bus_interfaces.static_racl_support[if_name])
  dynamic_racl = block.bus_interfaces.racl_support[if_name]
  num_wins = len(rb.windows)
  win_array_decl = f'  [{num_wins}]' if num_wins > 1 else ''
  addr_width = rb.get_addr_width()
  regs = rb.flat_regs
  finst = rb.field_inst_names()

  assert block.regwidth == 32, "csr_chk.sv.tpl: only 32-bit registers are supported"

  def camel(name):
    return ''.join(part.capitalize() for part in name.lower().split('_'))

  sw_enum = {'none': 'SwNone', 'ro': 'SwRo', 'rc': 'SwRc', 'rw': 'SwRw', 'r0w1c': 'SwR0w1c',
             'rw1s': 'SwRw1s', 'rw1c': 'SwRw1c', 'rw0c': 'SwRw0c', 'wo': 'SwWo'}

  by_name = {r.name: r for r in regs}

  def regwen_reg(r):
    return by_name[r.regwen] if r.regwen else None

  # Phase 1: a register is mirrored when it is stored in the block, in the block's own clock
  # domain, with no in-register write enable. Its REGWEN must be mirrored too.
  def mirrored(r):
    if r.hwext or r.shadowed or r.async_clk or r.sync_clk or r.inregwen:
      return False
    wen = regwen_reg(r)
    return wen is None or mirrored(wen)

  def permit_mask(r):
    width = r.get_width()
    return 0b1111 if width > 24 else 0b0111 if width > 16 else 0b0011 if width > 8 else 0b0001

  mirrored_regs = [r for r in regs if mirrored(r)]
  skipped_regs = [r for r in regs if not mirrored(r)]

  def fields_of(r):
    '''(field, finst_name, fsig_name, width, resval, sw enum) per field, lsb first'''
    out = []
    for f in r.fields:
      fsig_name, finst_name = finst[(r, f)]
      out.append((f, finst_name, fsig_name, f.bits.width(), f.resval or 0,
                  sw_enum[f.swaccess.key]))
    return out
%>\
//
// ${mod_base}_csr_chk: CSR checker of the ${lblock} register block, generated by reggen from
//   ${lblock}.hjson (util/reggen/csr_chk.sv.tpl). Do not edit. A mirror of every register field,
//   predicted from the bus and the hardware interface by the register tool's rules
//   (csr_chk_pkg), and the properties that compare the register block with it.
// Data path: tl_i, tl_o -> request events, address decode -> error prediction -> per-register
//   software write -> mirror per field (with hw2reg) -> field properties; one tracked access ->
//   read data and error answer checks.
// Obligations: field content, reset value, software and hardware writes, regwen, qe, read data,
//   error answers (REQ_CSR_01 to 24, 30 to 32, 34).
// Spec: util/reggen/README.md (register definitions per type, regwen, error responses);
//   hw/ip/tlul/README.md (explicit error cases).
// Naming: x_d next value, x_q current value; mir_<field>_q the mirror of a field; hit_<reg> the
//   address decode of a register; labels assert_, assume_, cover_<Feature>_<Name>.
module ${mod_base}_csr_chk
  import tlul_pkg::*;
  import csr_chk_pkg::*;
(
  input logic clk_i,
  input logic rst_ni,
% if has_shadow:
  input logic rst_shadowed_ni,
% endif
% for clock in rb.clocks.values():
  input logic ${clock.clock},
  input logic ${clock.reset},
% endfor
% for reinit in rb.reinit_list:
  input logic ${reinit.name},
% endfor
  input tlul_pkg::tl_h2d_t tl_i,
  input tlul_pkg::tl_d2h_t tl_o,
% if num_wins != 0:
  input tlul_pkg::tl_h2d_t tl_win_o${win_array_decl},
  input tlul_pkg::tl_d2h_t tl_win_i${win_array_decl},
% endif
% if has_reg2hw:
  input ${reg_pkg}::${reg2hw_t} reg2hw,
% endif
% if has_hw2reg:
  input ${reg_pkg}::${hw2reg_t} hw2reg,
% endif
% if has_shadow:
  input logic shadowed_storage_err_o,
  input logic shadowed_update_err_o,
% endif
% if dynamic_racl:
  input top_racl_pkg::racl_policy_vec_t racl_policies_i,
% endif
% if racl_support:
  input top_racl_pkg::racl_error_log_t racl_error_o,
% endif
  input logic intg_err_o
);

  localparam int unsigned AW   = ${addr_width};
  localparam int unsigned SrcW = top_pkg::TL_AIW;

  // Ports of the register block no check reads yet (phase 1: no shadow, hwext, async, window or
  // RACL checks; the integrity error check has its own task).
  /* verilator lint_off UNUSEDSIGNAL */
  logic unused_ports;
  assign unused_ports = ^{intg_err_o${', rst_shadowed_ni, shadowed_storage_err_o, shadowed_update_err_o' if has_shadow else ''}\
% for clock in rb.clocks.values():
, ${clock.clock}, ${clock.reset}\
% endfor
% if num_wins != 0:
, tl_win_o, tl_win_i\
% endif
% if dynamic_racl:
, racl_policies_i\
% endif
% if racl_support:
, racl_error_o\
% endif
};
  /* verilator lint_on UNUSEDSIGNAL */

  // The access the tracker follows. FPV: undriven, so the formal tool picks it in every cycle.
  // Simulation: 1, so the tracker follows the next access whenever it is free.
`ifdef FPV_ON
  /* verilator lint_off UNDRIVEN */
  logic pick;
  /* verilator lint_on UNDRIVEN */
`else
  logic pick;
  assign pick = 1'b1;
`endif

  default clocking @(posedge clk_i); endclocking
  /* verilator lint_off SYNCASYNCNET */
  default disable iff (!rst_ni);
  /* verilator lint_on SYNCASYNCNET */

  /////////////////
  // Environment //
  /////////////////

  // The crossbar plays the TL-UL host: the ABVIP assumes its rules and checks the block's answers.
  // A register block accepts one request at a time and answers in the next cycle, never earlier
  // and never later (REQ_CSR_39), so the ABVIP asserts all three instead of leaving covers open.
  logic req_fire, rsp_fire;
  /* verilator lint_off PINCONNECTEMPTY */
  tlul_abvip #(
    .Role              (tlul_abvip_pkg::PlayHost),
    .DevSameCycleRsp   (1'b0),
    .DevMaxOutstanding (1),
    .DevRspBound       (1)
  ) u_tl_abvip (
    .clk_i,
    .rst_ni,
    .h2d_i             (tl_i),
    .d2h_i             (tl_o),
    .a_fire_o          (req_fire),
    .d_fire_o          (rsp_fire),
    .num_outstanding_o (),
    .oldest_src_o      ()
  );
  /* verilator lint_on PINCONNECTEMPTY */

  // Every request carries correct command and data integrity; the integrity task leaves this
  // rule out.
  assume_Csr_IntegrityCorrect : assume property (
    tl_i.a_valid |-> (tl_i.a_user.cmd_intg == get_cmd_intg(tl_i)) &&
                     (tl_i.a_user.data_intg == get_data_intg(tl_i.a_data)));

  // The instruction-type user bit holds a valid multi-bit encoding, True or False: a host sends
  // nothing else, and the block refuses any other value.
  assume_Csr_InstrTypeValid : assume property (
    tl_i.a_valid |-> (tl_i.a_user.instr_type inside {prim_mubi_pkg::MuBi4True,
                                                      prim_mubi_pkg::MuBi4False}));

  ////////////////////
  // Request events //
  ////////////////////

  // One accepted request: a read or a write, its word address (excess bits stripped), data.
  logic          req_is_write, req_is_read;
  logic [AW-1:0] req_addr;

  assign req_is_write = req_fire && (tl_i.a_opcode inside {PutFullData, PutPartialData});
  assign req_is_read  = req_fire && (tl_i.a_opcode == Get);
% if addr_width > 2:
  assign req_addr     = {tl_i.a_address[AW-1:2], 2'b00};
% else:
  assign req_addr     = '0;
% endif

  ////////////////////
  // Address decode //
  ////////////////////

% for r in regs:
  logic hit_${r.name.lower()};
% endfor
  logic any_hit, req_in_window;

% for r in regs:
  assign hit_${r.name.lower()} = (req_addr == AW'('h${f'{r.offset:x}'}));
% endfor
  assign any_hit = |{
% for r in regs:
    hit_${r.name.lower()}${'' if loop.last else ','}
% endfor
  };
% if num_wins == 0:
  assign req_in_window = 1'b0;
% else:
  assign req_in_window =
% for w in rb.windows:
    ((req_addr >= AW'('h${f'{w.offset:x}'})) && (req_addr < AW'('h${f'{w.offset + w.size_in_bytes:x}'})))${';' if loop.last else ' ||'}
% endfor
% endif

  //////////////////////
  // Error prediction //
  //////////////////////

  // The bytes a write must enable, per register: the register's width in bytes.
  logic [DataW/8-1:0] permit_sel;
  always_comb begin
    permit_sel = '0;
    unique case (1'b1)
% for r in regs:
      hit_${r.name.lower()}: permit_sel = 4'b${f'{permit_mask(r):04b}'};
% endfor
      default: permit_sel = '0;
    endcase
  end

  // An access answered with an error and performed on no register: unmapped offset, a write
  // narrower than the register, a sub-word write not word aligned, an instruction fetch (a
  // register block serves no instruction fetches: a DV reading).
  logic req_unmapped, req_narrow, req_unaligned, req_ifetch, req_err;
  assign req_unmapped  = !any_hit && !req_in_window;
  assign req_narrow    = req_is_write && !wr_permitted(tl_i.a_mask, permit_sel);
  assign req_unaligned = req_is_write && (tl_i.a_size < top_pkg::TL_SZW'(2)) &&
                         (tl_i.a_address[1:0] != 2'b00);
  assign req_ifetch    = (tl_i.a_user.instr_type == prim_mubi_pkg::MuBi4True);
  assign req_err       = req_unmapped || req_narrow || req_unaligned || req_ifetch;

  ////////////
  // Mirror //
  ////////////
% for r in mirrored_regs:
<%
  rn = r.name.lower()
  wen = regwen_reg(r)
  wen_field = fields_of(wen)[0] if wen else None
  needs_wr_q = any(f.hwqe and f.hwaccess.allows_read() for f in r.fields)
  needs_rd = any(f.swaccess.key == 'rc' for f in r.fields)
%>

  // ${r.name}${f', write enable {r.regwen}' if r.regwen else ''}
  logic sw_wr_${rn}${f', sw_rd_{rn}' if needs_rd else ''};
% if wen:
  logic regwen_open_${rn};
  assign regwen_open_${rn} = regwen_open(1'b${1 if wen_field[0].mubi else 0}, ${wen_field[3]},
                                         DataW'(mir_${wen_field[1]}_q));
% endif
  assign sw_wr_${rn} = req_is_write && hit_${rn} && !req_err${f' && regwen_open_{rn}' if wen else ''};
% if needs_rd:
  assign sw_rd_${rn} = req_is_read && hit_${rn} && !req_err;
% endif
% if needs_wr_q:
  logic sw_wr_${rn}_q;
  always_ff @(posedge clk_i or negedge rst_ni) begin
    if (!rst_ni) sw_wr_${rn}_q <= 1'b0;
    else         sw_wr_${rn}_q <= sw_wr_${rn};
  end
% endif
% for f, fin, fsig, w, resval, sw in fields_of(r):
<%
  hw_rd = f.hwaccess.allows_read()
  hw_wr = f.hwaccess.allows_write()
  base = f'hw_{fin}' if hw_wr else f'DataW\'(mir_{fin}_q)'
  wd = f'DataW\'(tl_i.a_data[{f.bits.msb}:{f.bits.lsb}])' if f.bits.msb != f.bits.lsb else f'DataW\'(tl_i.a_data[{f.bits.msb}])'
  rc = f.swaccess.key == 'rc'
%>
  // ${r.name}.${f.name}: ${f.swaccess.key} / ${f.hwaccess.key}, reset 'h${f'{resval:x}'}
  logic [${w-1}:0] mir_${fin}_q, mir_${fin}_d;
% if hw_wr:
  logic [DataW-1:0] hw_${fin};
  assign hw_${fin} = hw_next(hw2reg.${fsig}.de, DataW'(hw2reg.${fsig}.d), DataW'(mir_${fin}_q));
% endif
  assign mir_${fin}_d =
% if r.reinit:
    ${r.reinit} ? ${w}'('h${f'{resval:x}'}) :
% endif
    sw_wr_${rn} ? ${w}'(sw_next(${sw}, ${base}, ${wd})) :
% if rc:
    sw_rd_${rn} ? ${w}'(0) :
% endif
                  ${w}'(${base});
  always_ff @(posedge clk_i or negedge rst_ni) begin
    if (!rst_ni) mir_${fin}_q <= ${w}'('h${f'{resval:x}'});
    else         mir_${fin}_q <= mir_${fin}_d;
  end
% endfor
% endfor

  ///////////////
  // Read data //
  ///////////////

  // What a read of each mirrored register returns: every readable field in its bit position.
% for r in mirrored_regs:
<% rn = r.name.lower() %>
  logic [DataW-1:0] rdata_${rn};
  always_comb begin
    rdata_${rn} = '0;
% for f, fin, fsig, w, resval, sw in fields_of(r):
% if f.swaccess.allows_read():
    rdata_${rn}[${f.bits.msb}:${f.bits.lsb}] = ${w}'(rd_value(${sw}, DataW'(mir_${fin}_q)));
% endif
% endfor
  end
% endfor

  logic [DataW-1:0] exp_rdata;
  logic             any_mirrored_hit;
  always_comb begin
    exp_rdata = '0;
    unique case (1'b1)
% for r in mirrored_regs:
      hit_${r.name.lower()}: exp_rdata = rdata_${r.name.lower()};
% endfor
      default: exp_rdata = '0;
    endcase
  end
  assign any_mirrored_hit = |{
% for r in mirrored_regs:
    hit_${r.name.lower()}${'' if loop.last else ','}
% endfor
  };

  /////////////
  // Tracker //
  /////////////

  // One access chosen by pick, captured when accepted, matched to its answer by source ID
  // (TileLink 1.9.3, section 6.4: a source is unique while outstanding).
  typedef enum logic {TrkIdle, TrkPending} trk_e;
  trk_e            trk_q, trk_d;
  logic            trk_start, trk_end, rsp_for_trk, rsp_same_cycle;
  logic [SrcW-1:0] trk_src_q;
  logic            trk_is_read_q, trk_exp_err_q, trk_data_known_q, trk_err_known_q;
  logic [DataW-1:0] trk_exp_data_q;

  assign rsp_same_cycle = rsp_fire && (tl_o.d_source == tl_i.a_source);
  assign rsp_for_trk    = (trk_q == TrkPending) && rsp_fire && (tl_o.d_source == trk_src_q);
  assign trk_start      = (trk_q == TrkIdle) && req_fire && pick && !rsp_same_cycle;
  assign trk_end        = rsp_for_trk;

  assign trk_d = trk_start ? TrkPending :
                 trk_end   ? TrkIdle    :
                             trk_q;

  always_ff @(posedge clk_i or negedge rst_ni) begin
    if (!rst_ni) begin
      trk_q            <= TrkIdle;
      trk_src_q        <= '0;
      trk_is_read_q    <= 1'b0;
      trk_exp_err_q    <= 1'b0;
      trk_data_known_q <= 1'b0;
      trk_err_known_q  <= 1'b0;
      trk_exp_data_q   <= '0;
    end else begin
      trk_q <= trk_d;
      if (trk_start) begin
        trk_src_q        <= tl_i.a_source;
        trk_is_read_q    <= req_is_read;
        trk_exp_err_q    <= req_err;
        trk_data_known_q <= any_mirrored_hit && !req_err;
        trk_err_known_q  <= !req_in_window;
        trk_exp_data_q   <= exp_rdata;
      end
    end
  end

  ////////////////
  // Properties //
  ////////////////

  // Field content: the block's q equals the mirror in every cycle (reset value, every software
  // write by its type, hardware updates, collisions, regwen, no change without a cause).
% for r in mirrored_regs:
<% rn = r.name.lower() %>
% for f, fin, fsig, w, resval, sw in fields_of(r):
% if f.hwaccess.allows_read():
  // ${r.name}.${f.name} equals its mirror.
  // REQ_CSR_01 to 11, 15 to 17, 20, 21; csr_field
  assert_Field_${camel(fin)}QMatchesMirror : assert property (reg2hw.${fsig}.q == mir_${fin}_q);
% endif
% if f.swaccess.allows_write():
  cover_Field_${camel(fin)}SwWriteChanges : cover property (sw_wr_${rn} && (mir_${fin}_d != mir_${fin}_q));
% endif
% if f.hwaccess.allows_write():
  cover_Field_${camel(fin)}HwUpdates : cover property (hw2reg.${fsig}.de);
% if f.swaccess.allows_write():
  cover_Field_${camel(fin)}Collision : cover property (sw_wr_${rn} && hw2reg.${fsig}.de);
% endif
% endif
% if f.hwqe and f.hwaccess.allows_read():
  // qe pulses in the cycle q takes a software write, and never otherwise.
  // REQ_CSR_18; csr_qe
  assert_Qe_${camel(fin)}PulseOnWrite : assert property (sw_wr_${rn} |=> reg2hw.${fsig}.qe);
  assert_Qe_${camel(fin)}OnlyOnWrite  : assert property (reg2hw.${fsig}.qe |-> sw_wr_${rn}_q);
% endif
% endfor
% if r.regwen:
  cover_Regwen_${camel(rn)}LockedWrite : cover property (req_is_write && hit_${rn} && !req_err && !regwen_open_${rn});
% endif
% endfor

  // Read data: the tracked read of a mirrored register returns the mirror's readable bits.
  // REQ_CSR_12, 13; csr_read
  assert_Rd_DataIsMirror : assert property (
    rsp_for_trk && trk_is_read_q && trk_data_known_q && !tl_o.d_error |->
    tl_o.d_data == trk_exp_data_q);

  // Error answer: the tracked access gets d_error exactly when the rules predict one.
  // REQ_CSR_30, 31, 32, 34; csr_errors
  assert_Rsp_ErrorAsPredicted : assert property (
    rsp_for_trk && trk_err_known_q |-> tl_o.d_error == trk_exp_err_q);

  cover_Rd_TrackedAnswered  : cover property (rsp_for_trk && trk_is_read_q && trk_data_known_q);
  cover_Wr_TrackedAnswered  : cover property (rsp_for_trk && !trk_is_read_q);
  cover_Rsp_ErrorAnswered   : cover property (rsp_for_trk && tl_o.d_error);
  cover_Err_Unmapped        : cover property (req_fire && req_unmapped);
  cover_Err_NarrowWrite     : cover property (req_fire && req_narrow && !req_unmapped);
  cover_Err_Unaligned       : cover property (req_fire && req_unaligned && !req_unmapped);
  cover_Err_InstrFetch      : cover property (req_fire && req_ifetch && !req_unmapped);
  cover_Trk_Pending         : cover property (trk_q == TrkPending);

endmodule
