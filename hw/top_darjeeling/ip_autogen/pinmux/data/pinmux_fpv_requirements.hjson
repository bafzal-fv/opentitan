          ]
          kind: "spec"
          testpoint: "wakeup_cause"
          checks: ["request follows cause (assert_WakeupCause_RequestFollowsCause)"]
          why: '''It wants `pin_wkup_req_o` 1 within 2 cycles of any cause bit rising, and while any has held 1 for 3 cycles in a row.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open: not reviewed for this top"
        }
        {
          name: REQ_WKUP_18b
          desc: '''`pin_wkup_req_o` shall be 0 while every cause bit is 0.'''
          source: [
            '''[Inter-Module Signals](hw/top_darjeeling/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[Wakeup Detectors](hw/top_darjeeling/ip_autogen/pinmux/doc/theory_of_operation.md#wakeup-detectors)'''
