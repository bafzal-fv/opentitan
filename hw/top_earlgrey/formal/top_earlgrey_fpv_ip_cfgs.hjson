// This batch script runs all IP blocks that used FPV to verify.
{
  flow: formal

  sub_flow: fpv

  // This is the primary cfg hjson for FPV. It imports ALL individual FPV
  // cfgs of the IPs and the full chip used in top_earlgrey. This enables to run
  // them all as a regression in one shot.
  name: top_earlgrey_ip_fpv

  import_cfgs: [// common server configuration for results upload
                "{proj_root}/hw/data/common_project_cfg.hjson"]

  rel_path: "hw/top_earlgrey/formal/ip/summary"

  use_cfgs: [
             // Use non-parameterized pinmux.
             {
               name: pinmux_fpv
               dut: pinmux_tb
               fusesoc_core: lowrisc:earlgrey_fpv:pinmux_fpv
               import_cfgs: ["{proj_root}/hw/formal/tools/dvsim/common_fpv_cfg.hjson"]
               rel_path: "hw/top_earlgrey/ip_autogen/pinmux/{sub_flow}/{tool}"
               defines: "FPV_ALERT_NO_SIGINT_ERR"
               exp_fail_hjson: "{proj_root}/hw/top_earlgrey/ip_autogen/pinmux/fpv/pinmux_expected_failure.hjson"
               cov: true
             }

             // Use chip_earlgrey_asic parameters to verify pinmux.
             {
               name: pinmux_chip_fpv
               dut: pinmux_chip_tb
               fusesoc_core: lowrisc:earlgrey_fpv:pinmux_chip_fpv
               import_cfgs: ["{proj_root}/hw/formal/tools/dvsim/common_fpv_cfg.hjson"]
               rel_path: "hw/top_earlgrey/ip_autogen/pinmux/{sub_flow}/{tool}"
               defines: "FPV_ALERT_NO_SIGINT_ERR"
               cov: true
               exp_fail_hjson: "{proj_root}/hw/top_earlgrey/ip_autogen/pinmux/fpv/pinmux_chip_expected_failure.hjson"
             }

             // Pinmux FPV environment bound into pinmux (fpv/env): the main run, both clocks at
             // one rate and one reset at the start.
             {
               name: pinmux_env_fpv
               dut: pinmux
               fusesoc_core: lowrisc:earlgrey_fpv:pinmux_env_fpv
               import_cfgs: ["{proj_root}/hw/formal/tools/dvsim/common_fpv_cfg.hjson"]
               rel_path: "hw/top_earlgrey/ip_autogen/pinmux/{sub_flow}/{tool}/env"
               defines: "FPV_ALERT_NO_SIGINT_ERR"
               cov: true
               // "-batch", or empty under dvsim --gui, so a run can tell batch from GUI.
               exports: [{JG_BATCH_MODE: "{batch_mode_prefix}"}, {PINMUX_FPV_RUN: "main"}]
               // LOCAL ONLY, not for an upstream pull request: Jasper runs the script that
               // PINMUX_JG_SCRIPT names (taken from the environment) instead of fpv.tcl.
               overrides: [
                 {
                   name:  "build_opts"
                   value: ["{batch_mode_prefix} {PINMUX_JG_SCRIPT}",
                           "-proj jgproject",
                           "-allow_unsupported_OS"]
                 }
               ]
             }

             // The same environment with the always-on clock at a quarter of the main clock.
             {
               name: pinmux_env_fpv_slow_aon
               dut: pinmux
               fusesoc_core: lowrisc:earlgrey_fpv:pinmux_env_fpv
               import_cfgs: ["{proj_root}/hw/formal/tools/dvsim/common_fpv_cfg.hjson"]
               rel_path: "hw/top_earlgrey/ip_autogen/pinmux/{sub_flow}/{tool}/env_slow_aon"
               defines: "FPV_ALERT_NO_SIGINT_ERR+PINMUX_FPV_AON_RATIO=4"
               cov: false
               exports: [{JG_BATCH_MODE: "{batch_mode_prefix}"}, {PINMUX_FPV_RUN: "slow_aon"}]
               // LOCAL ONLY, not for an upstream pull request: Jasper runs the script that
               // PINMUX_JG_SCRIPT names (taken from the environment) instead of fpv.tcl.
               overrides: [
                 {
                   name:  "build_opts"
                   value: ["{batch_mode_prefix} {PINMUX_JG_SCRIPT}",
                           "-proj jgproject",
                           "-allow_unsupported_OS"]
                 }
               ]
             }

             {
               name: rv_plic_fpv
               dut: rv_plic_tb
               fusesoc_core: lowrisc:earlgrey_ip:rv_plic_fpv
               import_cfgs: ["{proj_root}/hw/formal/tools/dvsim/common_fpv_cfg.hjson"]
               rel_path: "hw/top_earlgrey/ip_autogen/rv_plic/{sub_flow}/{tool}"
               cov: true
               exp_fail_hjson: "{proj_root}/hw/top_earlgrey/ip_autogen/rv_plic/fpv/rv_plic_expected_failure.hjson"
               after_load: ["{proj_root}/hw/top_earlgrey/ip_autogen/rv_plic/fpv/tb/coverage.tcl"]
             }
            ]
}
