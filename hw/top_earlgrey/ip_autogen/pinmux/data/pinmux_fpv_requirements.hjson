{
  name: "pinmux_fpv"
  // The requirements of the pinmux FPV testplan (doc/fpv/README.md), one entry each:
  //   name, desc   the requirement ID and its statement
  //   source      where the rule comes from: !!REGISTER.FIELD names a register field
  //               (reggen's form), a Markdown link names a document section or a key
  //   kind        "spec": a specification states the rule; "RTL": none does, and the
  //               rule follows the design's present behaviour or leaves the outcome
  //               to a specification question
  //   testpoint   its testpoint in pinmux_env_fpv_testplan.hjson
  //   checks      what decides it: "<check name> (<planned assertion>)", the CSR
  //               checker, another testbench, or a check out of scope or waiting
  //   why         why those checks prove it
  //   milestone   the verification stage of its testpoint: V1, V2 or V2S
  //   priority    the order of work within a stage: "1" before "2"
  //   security    true when a security property depends on it
  //   state       "open" until its checks are proven; with a reason where no check
  //               of this plan decides it
  // The file holds, besides the entries:
  //   written_for   the top the plan was written for and read against
  //   rendered_for  the top of this copy; other tops render it from the same
  //                 template with their own parameters, and their requirements
  //                 are not reviewed
  //   terms         the words the requirements use, each with its meaning
  //   groups        the requirements by feature; a group's conditions say when
  //                 its requirements hold and define its own words
  written_for: "earlgrey"
  rendered_for: "earlgrey"
  terms: [
    {
      name: '''`n`'''
      desc: '''MIO peripheral input (0 to 93)'''
    }
    {
      name: '''`k`'''
      desc: '''MIO peripheral output (0 to 103)'''
    }
    {
      name: '''`p`'''
      desc: '''MIO pad (0 to 46)'''
    }
    {
      name: '''`d`'''
      desc: '''DIO pad (0 to 15)'''
    }
    {
      name: '''Watched signal'''
      desc: '''The pad input that `MIODIO` and `PADSEL` pick'''
    }
    {
      name: '''Forwarded value'''
      desc: '''The watched signal sampled each `clk_aon_i` cycle, through the filter when `FILTER` is 1'''
    }
    {
      name: '''Asleep, awake'''
      desc: '''A pad is asleep while its sleep status bit is 1, awake while it is 0'''
    }
    {
      name: '''AON'''
      desc: '''The always-on domain: the logic on `clk_aon_i` and `rst_aon_ni`'''
    }
    {
      name: '''Lands'''
      desc: '''A written or sampled value lands in the cycle the register or flop it is meant for takes it'''
    }
    {
      name: '''Hardware write'''
      desc: '''A write to a register field made by the pinmux logic, not by software over the bus'''
    }
    {
      name: '''Full reset'''
      desc: '''A reset that asserts `rst_sys_ni`, which the top connects to the system reset tree ([top_earlgrey.hjson `module.pinmux`](hw/top_earlgrey/data/top_earlgrey.hjson))'''
    }
    {
      name: '''NDM reset'''
      desc: '''A reset that asserts `rst_ni` and `rst_aon_ni`, not `rst_sys_ni`: the top connects those two to the life cycle reset tree ([top_earlgrey.hjson `module.pinmux`](hw/top_earlgrey/data/top_earlgrey.hjson)), the tree a non-debug module reset request asserts outside PROD and PROD_END ([Summary](hw/top_earlgrey/ip_autogen/rstmgr/doc/theory_of_operation.md#summary)); what is on `rst_sys_ni` survives it ([Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset))'''
    }
    {
      name: '''On, Off'''
      desc: '''On is 4'b0101 and Off 4'b1010, the life cycle controller's values ([Control Signal Propagation](hw/ip/lc_ctrl/doc/interfaces.md#control-signal-propagation))'''
    }
    {
      name: '''The latch'''
      desc: '''The latched debug enable, seen on `pinmux_hw_debug_en_o` and through the RISC-V TAP'''
    }
    {
      name: '''A clear'''
      desc: '''`lc_hw_debug_clr_i`, `lc_check_byp_en_i` or `lc_escalate_en_i` at any value other than Off ([Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset); [Control Signal Propagation](hw/ip/lc_ctrl/doc/interfaces.md#control-signal-propagation) for the debug clear and the escalation input); it turns the latch Off'''
    }
    {
      name: '''Connected'''
      desc: '''A TAP is connected while the TAP straps name it and its gate is open: the life cycle TAP at straps 01; the RISC-V TAP at straps 10 while the latch is On; the DFT TAP at straps 11 while `lc_dft_en_i` is On; on a top with the RRAM TAP (`enable_rram_tap`), the RRAM TAP at straps 00 while `RRAM_JTAG_SEL` is `kMultiBitBool4True` and `lc_nvm_debug_en_i` is On; at straps 00, no TAP otherwise ([Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation), [Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset))'''
    }
    {
      name: '''Owns'''
      desc: '''A TAP owns the JTAG pads while it is connected: the pads then carry the TAP's signals, not what the pad muxes select'''
    }
    {
      name: '''Cut'''
      desc: '''A TAP is cut while its gate is shut, or while the TAP straps name another TAP or none'''
    }
    {
      name: '''Allowed pad'''
      desc: '''For a signal: its `pads` list names the pad, or the list is empty'''
    }
    {
      name: '''Main pad'''
      desc: '''A pad of bank VIOA or VIOB: IOA, IOB and the SPI pads, 34 of 61'''
    }
    {
      name: '''Main off'''
      desc: '''The Main section's reset with the AON resets high. A Main peripheral's input then has no requirement, as that peripheral is off.'''
    }
  ]
  groups: [
    {
      name: '''Input selection'''
      conditions: [
        '''every row holds in every cycle, except for a JTAG pad while a TAP owns it.'''
      ]
      requirements: [
        {
          name: REQ_IN_01
          desc: '''MIO peripheral input `n` shall read 0 while `MIO_PERIPH_INSEL_n` is 0.'''
          source: [
            '''!!MIO_PERIPH_INSEL.IN'''
          ]
          kind: "spec"
          testpoint: "pad_listen"
          checks: ["reads tie 0 (assert_PadListen_ReadsTie0)"]
          why: '''In every cycle the check compares each MIO peripheral input whose select is 0 with 0.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_IN_02
          desc: '''MIO peripheral input `n` shall read 1 while `MIO_PERIPH_INSEL_n` is 1.'''
          source: [
            '''!!MIO_PERIPH_INSEL.IN'''
          ]
          kind: "spec"
          testpoint: "pad_listen"
          checks: ["reads tie 1 (assert_PadListen_ReadsTie1)"]
          why: '''In every cycle the check compares each MIO peripheral input whose select is 1 with 1.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_IN_03
          desc: '''MIO peripheral input `n` shall read the input of MIO pad `p`, in the same cycle, while `MIO_PERIPH_INSEL_n` is 2 + `p` (`p` from 0 to 46).'''
          source: [
            '''!!MIO_PERIPH_INSEL.IN'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `n_mio_pads`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "pad_listen"
          checks: ["reads selected pad (assert_PadListen_ReadsSelectedPad)"]
          why: '''For each select from 2 to 48 the check compares the input with `mio_in_i` of pad select minus 2, in the same cycle.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_IN_04
          desc: '''MIO peripheral input `n` shall read 0 while `MIO_PERIPH_INSEL_n` is 49 to 63, the values that name no pad.'''
          source: [
            '''!!MIO_PERIPH_INSEL'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `n_mio_pads`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "RTL"
          testpoint: "pad_listen"
          checks: ["no pad reads 0 (assert_PadListen_NoPadReads0)"]
          why: '''For selects 49 to 63, which name no pad, the check compares the input with 0.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_IN_05
          desc: '''DIO peripheral input `d` shall read the input of DIO pad `d`, in the same cycle, whatever the registers hold.'''
          source: [
            '''[MIO and DIO Signal Categories](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#mio-and-dio-signal-categories)'''
          ]
          kind: "spec"
          testpoint: "pad_listen"
          checks: ["DIO reads its pad (assert_PadListen_DioReadsItsPad)"]
          why: '''The check compares each DIO peripheral input with its own pad's `dio_in_i` in the same cycle, whatever the registers hold.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_IN_06
          desc: '''After reset, every MIO peripheral input shall read 0 until software writes its select.'''
          source: [
            '''[Pinmux Configuration](hw/top_earlgrey/ip_autogen/pinmux/doc/programmers_guide.md#pinmux-configuration)'''
            '''[MIO and DIO Signal Categories](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#mio-and-dio-signal-categories)'''
            '''!!MIO_PERIPH_INSEL.IN'''
          ]
          kind: "spec"
          testpoint: "reset_state"
          checks: ["reads tie 0 (assert_PadListen_ReadsTie0)", "the CSR checker"]
          why: '''The CSR checker keeps each input select at 0 until written, and _reads tie 0_ makes such an input read 0.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
      ]
    }
    {
      name: '''Output selection'''
      conditions: [
        '''every row holds while the pad's sleep mode is not active (Sleep retention) and no TAP owns the pad.'''
      ]
      requirements: [
        {
          name: REQ_OUT_01a
          desc: '''The output of MIO pad `p` shall be 0 while `MIO_OUTSEL_p` is 0.'''
          source: [
            '''!!MIO_OUTSEL.OUT'''
          ]
          kind: "spec"
          testpoint: "pad_output"
          checks: ["tie 0 drives 0 (assert_PadOutput_Tie0Drives0)"]
          why: '''While an awake pad's select is 0, the check compares the pad's output with 0 in every cycle.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_OUT_01b
          desc: '''The output enable of MIO pad `p` shall be 1 while `MIO_OUTSEL_p` is 0, so the pad drives 0.'''
          source: [
            '''!!MIO_OUTSEL.OUT'''
          ]
          kind: "spec"
          testpoint: "pad_output"
          checks: ["tie 0 drives 0 (assert_PadOutput_Tie0Drives0)"]
          why: '''Under select 0 the check compares the pad's output enable with 1 in every cycle.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_OUT_02a
          desc: '''The output of MIO pad `p` shall be 1 while `MIO_OUTSEL_p` is 1.'''
          source: [
            '''!!MIO_OUTSEL.OUT'''
          ]
          kind: "spec"
          testpoint: "pad_output"
          checks: ["tie 1 drives 1 (assert_PadOutput_Tie1Drives1)"]
          why: '''While an awake pad's select is 1, the check compares the pad's output with 1 in every cycle.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_OUT_02b
          desc: '''The output enable of MIO pad `p` shall be 1 while `MIO_OUTSEL_p` is 1, so the pad drives 1.'''
          source: [
            '''!!MIO_OUTSEL.OUT'''
          ]
          kind: "spec"
          testpoint: "pad_output"
          checks: ["tie 1 drives 1 (assert_PadOutput_Tie1Drives1)"]
          why: '''Under select 1 the check compares the pad's output enable with 1 in every cycle.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_OUT_03a
          desc: '''The output enable of MIO pad `p` shall be 0 while `MIO_OUTSEL_p` is 2: the pad is high-Z.'''
          source: [
            '''!!MIO_OUTSEL.OUT'''
          ]
          kind: "spec"
          testpoint: "pad_output"
          checks: ["select 2 is high-Z (assert_PadOutput_Select2IsHighZ)"]
          why: '''While an awake pad's select is 2, the check compares the pad's output enable with 0 in every cycle.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_OUT_03b
          desc: '''The output of MIO pad `p` shall be 0 while `MIO_OUTSEL_p` is 2.'''
          source: [
            '''!!MIO_OUTSEL.OUT'''
          ]
          kind: "spec"
          testpoint: "pad_output"
          checks: ["select 2 is high-Z (assert_PadOutput_Select2IsHighZ)"]
          why: '''Under select 2 the check compares the pad's output with 0 in every cycle.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_OUT_04a
          desc: '''MIO pad `p` shall carry peripheral output `k`, in the same cycle, while `MIO_OUTSEL_p` is 3 + `k` (`k` from 0 to 103).'''
          source: [
            '''!!MIO_OUTSEL.OUT'''
            '''[Muxing Matrix](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#muxing-matrix)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `n_mio_periph_out`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "pad_output"
          checks: ["drives selected output (assert_PadOutput_DrivesSelectedOutput)"]
          why: '''For each select from 3 to 106 the check compares the pad's output with `periph_to_mio_i[k]`, `k` the select minus 3, in the same cycle.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_OUT_04b
          desc: '''MIO pad `p` shall carry output enable `k`, in the same cycle, while `MIO_OUTSEL_p` is 3 + `k` (`k` from 0 to 103).'''
          source: [
            '''!!MIO_OUTSEL.OUT'''
            '''[Muxing Matrix](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#muxing-matrix)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `n_mio_periph_out`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "pad_output"
          checks: ["drives selected output (assert_PadOutput_DrivesSelectedOutput)"]
          why: '''The check compares the pad's output enable with `periph_to_mio_oe_i[k]`, `k` as for the data, in the same cycle.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_OUT_05a
          desc: '''The output enable of MIO pad `p` shall be 0 while `MIO_OUTSEL_p` is 107 to 127, the values that name no peripheral output: the pad is high-Z.'''
          source: [
            '''!!MIO_OUTSEL'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `n_mio_periph_out`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "RTL"
          testpoint: "pad_output"
          checks: ["no output is high-Z (assert_PadOutput_NoOutputIsHighZ)"]
          why: '''For selects 107 to 127, which name no output, the check compares the pad's output enable with 0.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_OUT_05b
          desc: '''The output of MIO pad `p` shall be 0 while `MIO_OUTSEL_p` is 107 to 127, the values that name no peripheral output.'''
          source: [
            '''!!MIO_OUTSEL'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `n_mio_periph_out`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "RTL"
          testpoint: "pad_output"
          checks: ["no output is high-Z (assert_PadOutput_NoOutputIsHighZ)"]
          why: '''For selects 107 to 127 the check compares the pad's output with 0.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_OUT_06a
          desc: '''DIO pad `d` shall carry its peripheral's output, in the same cycle.'''
          source: [
            '''[MIO and DIO Signal Categories](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#mio-and-dio-signal-categories)'''
          ]
          kind: "spec"
          testpoint: "pad_output"
          checks: ["DIO drives its peripheral (assert_PadOutput_DioDrivesItsPeripheral)"]
          why: '''The check compares each awake DIO pad's output with `periph_to_dio_i[d]` in the same cycle, whatever the registers hold.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_OUT_06b
          desc: '''DIO pad `d` shall carry its peripheral's output enable, in the same cycle.'''
          source: [
            '''[MIO and DIO Signal Categories](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#mio-and-dio-signal-categories)'''
          ]
          kind: "spec"
          testpoint: "pad_output"
          checks: ["DIO drives its peripheral (assert_PadOutput_DioDrivesItsPeripheral)"]
          why: '''The check compares each awake DIO pad's output enable with `periph_to_dio_oe_i[d]` in the same cycle, whatever the registers hold.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_OUT_07
          desc: '''After reset, every MIO pad shall be high-Z until software writes its select.'''
          source: [
            '''[MIO and DIO Signal Categories](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#mio-and-dio-signal-categories)'''
            '''[Pinmux Configuration](hw/top_earlgrey/ip_autogen/pinmux/doc/programmers_guide.md#pinmux-configuration)'''
            '''!!MIO_OUTSEL.OUT'''
          ]
          kind: "spec"
          testpoint: "reset_state"
          checks: ["select 2 is high-Z (assert_PadOutput_Select2IsHighZ)", "the CSR checker"]
          why: '''The CSR checker keeps each output select at 2 until written; _select 2 is high-Z_ then makes an awake pad high-Z.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
      ]
    }
    {
      name: '''Pad attributes'''
      conditions: [
        '''every row holds in every cycle, asleep or awake, except on a JTAG pad while a TAP owns it. "Written" means a write the register block accepts, its lock open (Register locks); "reads back" means what a read of the register returns. A pad type "keeps" an attribute bit when its pads implement that bit ([Pad Attributes](hw/top_earlgrey/ip_autogen/pinmux/doc/programmers_guide.md#pad-attributes)), the same on every pad of the type and for good. A one-bit field is kept when its bit is; each bit of `slew_rate` and `drive_strength` is kept or not on its own ([Pad Attributes](hw/top_earlgrey/ip_autogen/pinmux/doc/programmers_guide.md#pad-attributes)).'''
      ]
      requirements: [
        {
          name: REQ_ATTR_01a
          desc: '''The attribute output of MIO pad `p` shall equal, in field `invert`, what `MIO_PAD_ATTR_p` reads back.'''
          source: [
            '''!!MIO_PAD_ATTR.invert'''
            '''[Type RW HWExt](util/reggen/README.md#type-rw-hwext)'''
            '''[Generic Pad Wrapper](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#generic-pad-wrapper)'''
          ]
          kind: "spec"
          testpoint: "pad_attr"
          checks: ["pad gets read-back (assert_PadAttr_PadGetsReadBack)"]
          why: '''In every cycle the check compares field `invert` of the pad's `mio_attr_o` with the read-back of `MIO_PAD_ATTR_p`.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ATTR_01b
          desc: '''The attribute output of MIO pad `p` shall equal, in field `virtual_od_en`, what `MIO_PAD_ATTR_p` reads back.'''
          source: [
            '''!!MIO_PAD_ATTR.virtual_od_en'''
            '''[Type RW HWExt](util/reggen/README.md#type-rw-hwext)'''
            '''[Generic Pad Wrapper](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#generic-pad-wrapper)'''
          ]
          kind: "spec"
          testpoint: "pad_attr"
          checks: ["pad gets read-back (assert_PadAttr_PadGetsReadBack)"]
          why: '''In every cycle the check compares field `virtual_od_en` of the pad's `mio_attr_o` with the read-back of `MIO_PAD_ATTR_p`.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ATTR_01c
          desc: '''The attribute output of MIO pad `p` shall equal, in field `pull_en`, what `MIO_PAD_ATTR_p` reads back.'''
          source: [
            '''!!MIO_PAD_ATTR.pull_en'''
            '''[Type RW HWExt](util/reggen/README.md#type-rw-hwext)'''
            '''[Generic Pad Wrapper](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#generic-pad-wrapper)'''
          ]
          kind: "spec"
          testpoint: "pad_attr"
          checks: ["pad gets read-back (assert_PadAttr_PadGetsReadBack)"]
          why: '''In every cycle the check compares field `pull_en` of the pad's `mio_attr_o` with the read-back of `MIO_PAD_ATTR_p`.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ATTR_01d
          desc: '''The attribute output of MIO pad `p` shall equal, in field `pull_select`, what `MIO_PAD_ATTR_p` reads back.'''
          source: [
            '''!!MIO_PAD_ATTR.pull_select'''
            '''[Type RW HWExt](util/reggen/README.md#type-rw-hwext)'''
            '''[Generic Pad Wrapper](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#generic-pad-wrapper)'''
          ]
          kind: "spec"
          testpoint: "pad_attr"
          checks: ["pad gets read-back (assert_PadAttr_PadGetsReadBack)"]
          why: '''In every cycle the check compares field `pull_select` of the pad's `mio_attr_o` with the same field of the read-back of `MIO_PAD_ATTR_p`.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ATTR_01e
          desc: '''The attribute output of MIO pad `p` shall equal, in field `keeper_en`, what `MIO_PAD_ATTR_p` reads back.'''
          source: [
            '''!!MIO_PAD_ATTR.keeper_en'''
            '''[Type RW HWExt](util/reggen/README.md#type-rw-hwext)'''
            '''[Generic Pad Wrapper](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#generic-pad-wrapper)'''
          ]
          kind: "spec"
          testpoint: "pad_attr"
          checks: ["pad gets read-back (assert_PadAttr_PadGetsReadBack)"]
          why: '''In every cycle the check compares field `keeper_en` of the pad's `mio_attr_o` with the read-back of `MIO_PAD_ATTR_p`.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
