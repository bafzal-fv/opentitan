          kind: "spec"
          testpoint: "usb_conn"
          checks: ["wake request out (assert_UsbConn_WakeRequestOut)"]
          why: '''It compares `usb_wkup_req` with the module's `wake_req_aon_o` port in every cycle, a one-cycle pulse included.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_04a
          desc: '''The module shall run on `clk_aon_i`.'''
          source: [
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[USB Wakeup Detection Module](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#usb-wakeup-detection-module)'''
            '''[AON/Wake Clocking](hw/ip/usbdev/doc/theory_of_operation.md#aonwake-clocking)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "usb_conn"
          checks: ["module on AON clock (assert_UsbConn_ModuleOnAonClock)"]
          why: '''It compares the module's clock with `clk_aon_i` in every cycle; the run clocks `clk_aon_i` slower than `clk_i`, so a module on `clk_i` fails it.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_04b
          desc: '''The module shall be reset by `rst_aon_ni`.'''
          source: [
            '''[pinmux.hjson `clocking`](hw/top_earlgrey/ip_autogen/pinmux/data/pinmux.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
            '''[AON/Wake Clocking](hw/ip/usbdev/doc/theory_of_operation.md#aonwake-clocking)'''
          ]
          kind: "spec"
          testpoint: "usb_conn"
          checks: ["module on AON reset (check_UsbConn_ModuleOnAonReset)"]
          why: '''It fails on any flop of the module whose reset pin `rst_aon_ni` does not drive.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_05a
          desc: '''The module's D+ input shall be usbdev's input as the pinmux delivers it: the DIO pad USB_P.'''
          source: [
            '''[AON/Wake Interface Pins](hw/ip/usbdev/doc/theory_of_operation.md#aonwake-interface-pins)'''
            '''[top_earlgrey.hjson `pinout.pads USB_P`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `pinmux`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `pinmux.signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "usb_conn"
          checks: ["bus inputs (assert_UsbConn_BusInputs)"]
          why: '''It compares the module's D+ input with the DIO pad USB_P in every cycle: an input taken from USB_N or another pad, or through a flop, fails it.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_05b
          desc: '''The module's D- input shall be usbdev's input as the pinmux delivers it: the DIO pad USB_N.'''
          source: [
            '''[AON/Wake Interface Pins](hw/ip/usbdev/doc/theory_of_operation.md#aonwake-interface-pins)'''
            '''[top_earlgrey.hjson `pinout.pads USB_N`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `pinmux`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `pinmux.signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "usb_conn"
          checks: ["bus inputs (assert_UsbConn_BusInputs)"]
          why: '''It compares the module's D- input with the DIO pad USB_N in every cycle: an input taken from USB_P or another pad, or through a flop, fails it.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_05c
          desc: '''The module's VBUS input shall be usbdev's input as the pinmux delivers it: the muxed input `sense` after its input select.'''
          source: [
            '''[AON/Wake Interface Pins](hw/ip/usbdev/doc/theory_of_operation.md#aonwake-interface-pins)'''
            '''[top_earlgrey.hjson `pinmux`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `pinmux.signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "usb_conn"
          checks: ["bus inputs (assert_UsbConn_BusInputs)"]
          why: '''It compares the module's VBUS input with usbdev's sense input after its input select in every cycle.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_06a
          desc: '''While the module is inactive, a suspend request shall make it active within a bounded time.'''
          source: [
            '''[Suspending](hw/ip/usbdev/doc/wake_resume.md#suspending)'''
            '''[usbdev.hjson `wake_control.suspend_req`](hw/ip/usbdev/data/usbdev.hjson)'''
            '''[Inter-Module Signals](hw/ip/usbdev/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "usb_module"
          checks: ["request activates (assert_UsbModule_RequestActivates)"]
          why: '''It wants `usbdev_wake_detect_active` 1 within 2 AON clock cycles of each suspend request while inactive.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_06b
          desc: '''While the module is active, a wake acknowledge shall make it inactive within a bounded time.'''
          source: [
            '''[Resuming](hw/ip/usbdev/doc/wake_resume.md#resuming)'''
            '''[usbdev.hjson `wake_control.wake_ack`](hw/ip/usbdev/data/usbdev.hjson)'''
            '''[Inter-Module Signals](hw/ip/usbdev/doc/interfaces.md#inter-module-signals)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "usb_module"
          checks: ["acknowledge releases (assert_UsbModule_AcknowledgeReleases)"]
          why: '''It wants `usbdev_wake_detect_active` 0 within 2 AON clock cycles of each wake acknowledge while active.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_06c
          desc: '''Apart from a suspend request made while it is inactive and a wake acknowledge made while it is active, nothing shall change whether the module is active.'''
          source: [
            '''[Suspending](hw/ip/usbdev/doc/wake_resume.md#suspending)'''
            '''[Resuming](hw/ip/usbdev/doc/wake_resume.md#resuming)'''
            '''[usbdev.hjson `wake_control.suspend_req`](hw/ip/usbdev/data/usbdev.hjson)'''
            '''[usbdev.hjson `wake_control.wake_ack`](hw/ip/usbdev/data/usbdev.hjson)'''
            '''[Inter-Module Signals](hw/ip/usbdev/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "usb_module"
          checks: ["no other state change (assert_UsbModule_NoOtherStateChange)"]
          why: '''It lets `usbdev_wake_detect_active` rise only after a suspend request and fall only after a wake acknowledge.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_06d
          desc: '''While the module is inactive, each pad pull-up enable (`usb_dppullup_en`, `usb_dnpullup_en`) shall equal usbdev's enable of the same line in the same cycle.'''
          source: [
            '''[AON/Wake Interface Pins](hw/ip/usbdev/doc/theory_of_operation.md#aonwake-interface-pins)'''
            '''[Resuming](hw/ip/usbdev/doc/wake_resume.md#resuming)'''
            '''[usbdev.hjson `wake_control.wake_ack`](hw/ip/usbdev/data/usbdev.hjson)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "usb_module"
          checks: ["inactive passes pull-ups (assert_UsbModule_InactivePassesPullUps)"]
          why: '''It compares each pull-up enable to the pads with usbdev's enable of its line while the module is inactive.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_06e
          desc: '''With the module active and `usbdev_sense_lost` at 0, each pad pull-up enable shall keep usbdev's enable of its line at the activating suspend request.'''
          source: [
            '''[Overview](hw/ip/usbdev/doc/wake_resume.md#overview)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[chip_usbdev_testplan.hjson `chip_sw_usbdev_aon_pullup`](hw/top_earlgrey/data/ip/chip_usbdev_testplan.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "usb_module"
          checks: ["active holds pull-ups (assert_UsbModule_ActiveHoldsPullUps)", "waits: pull-ups after VBUS loss"]
          why: '''It wants each pull-up enable at usbdev's value at the suspend request while `usbdev_sense_lost` is 0.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_06f
          desc: '''While the module is active, each held condition shall set its event within a bounded time: bus not idle, bus reset (D+ and D- low), sense lost (VBUS low).'''
          source: [
            '''[Optional external AON/Wake functionality](hw/ip/usbdev/doc/theory_of_operation.md#optional-external-aonwake-functionality)'''
            '''[AON/Wake Clocking](hw/ip/usbdev/doc/theory_of_operation.md#aonwake-clocking)'''
            '''[usbdev.hjson `wake_events.disconnected`](hw/ip/usbdev/data/usbdev.hjson)'''
            '''[usbdev.hjson `wake_events.bus_reset`](hw/ip/usbdev/data/usbdev.hjson)'''
            '''[usbdev.hjson `wake_events.bus_not_idle`](hw/ip/usbdev/data/usbdev.hjson)'''
            '''[Inter-Module Signals](hw/ip/usbdev/doc/interfaces.md#inter-module-signals)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[usbdev_testplan.hjson `aon_wake_resume`](hw/ip/usbdev/data/usbdev_testplan.hjson)'''
            '''[usbdev_testplan.hjson `aon_wake_reset`](hw/ip/usbdev/data/usbdev_testplan.hjson)'''
            '''[usbdev_testplan.hjson `aon_wake_disconnect`](hw/ip/usbdev/data/usbdev_testplan.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "usb_module"
          checks: ["held condition sets event (assert_UsbModule_HeldConditionSetsEvent)"]
          why: '''It wants each event at 1 once its condition has been on the lines in a cycle and the 8 after it.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_06g
          desc: '''An event shall be set only after its own condition was on the USB lines while the module was active, for at least the shortest time the module must report.'''
          source: [
            '''[usbdev.hjson `wake_events.disconnected`](hw/ip/usbdev/data/usbdev.hjson)'''
            '''[usbdev.hjson `wake_events.bus_reset`](hw/ip/usbdev/data/usbdev.hjson)'''
            '''[usbdev.hjson `wake_events.bus_not_idle`](hw/ip/usbdev/data/usbdev.hjson)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[AON/Wake Clocking](hw/ip/usbdev/doc/theory_of_operation.md#aonwake-clocking)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "usb_module"
          checks: ["event only after its condition (assert_UsbModule_EventOnlyAfterItsCondition)", "waits: short condition sets no event"]
          why: '''It lets an event rise only on its own condition, seen with the module active from then on.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_06h
          desc: '''An event, once set, shall stay set for as long as the module stays active.'''
          source: [
            '''[Resuming](hw/ip/usbdev/doc/wake_resume.md#resuming)'''
            '''[Inter-Module Signals](hw/ip/usbdev/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "usb_module"
          checks: ["event holds while active (assert_UsbModule_EventHoldsWhileActive)"]
          why: '''It wants an event at 1 to stay 1 in the next cycle while the module stays active, whatever the USB lines do.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_06i
          desc: '''A wake acknowledge made while the module is active shall clear each of the three events within a bounded time.'''
          source: [
            '''[Resuming](hw/ip/usbdev/doc/wake_resume.md#resuming)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "usb_module"
          checks: ["acknowledge clears events (assert_UsbModule_AcknowledgeClearsEvents)"]
          why: '''It wants each of the three events at 0 in one of the 4 AON clock cycles after each wake acknowledge while active.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_06j
          desc: '''The module's wake request shall be 1 exactly while at least one of its three events is set.'''
          source: [
            '''[Overview](hw/ip/usbdev/doc/wake_resume.md#overview)'''
            '''[usbdev_testplan.hjson `aon_wake_resume`](hw/ip/usbdev/data/usbdev_testplan.hjson)'''
            '''[usbdev_testplan.hjson `aon_wake_reset`](hw/ip/usbdev/data/usbdev_testplan.hjson)'''
            '''[usbdev_testplan.hjson `aon_wake_disconnect`](hw/ip/usbdev/data/usbdev_testplan.hjson)'''
            '''[Inter-Module Signals](hw/ip/usbdev/doc/interfaces.md#inter-module-signals)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[Wakeup Recording](hw/top_earlgrey/ip_autogen/pwrmgr/doc/theory_of_operation.md#wakeup-recording)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "usb_module"
          checks: ["wake request follows events (assert_UsbModule_WakeRequestFollowsEvents)"]
          why: '''It compares `usb_wkup_req` with the three events in every cycle: 1 when at least one is 1, else 0.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
      ]
    }
    {
      name: '''Strap sampling'''
      conditions: [
        '''the TAP straps are seen through the TAP that connects (TAP selection and the JTAG pads); full reset and NDM reset are defined in the Terms. Life cycle conditions follow the definition table ([Manufacturing States](doc/security/specs/device_life_cycle/README.md#manufacturing-states)), after the input synchronizer delay. The pads named are Earl Grey's.'''
      ]
      requirements: [
        {
          name: REQ_STRAP_01
          desc: '''At each `strap_en_i` pulse while `dft_hold_tap_sel_i` is 0, TAP strap 0 shall take pad IOC8's value (MIO 30), in every life cycle state.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals tap0`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "strap"
          checks: ["pulse samples the straps (assert_Strap_PulseSamplesTheStraps)"]
          why: '''It compares strap 0 after a strap pulse with MIO 30 (IOC8) of the pulse cycle or the next.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_STRAP_02a
          desc: '''At a `strap_en_i` pulse with `dft_hold_tap_sel_i` 0 and `lc_hw_debug_en_i` On, TAP strap 1 shall take pad IOC5's value (MIO 27), unless `REQ_STRAP_03` applies.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals tap1`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
            '''[Manufacturing States](doc/security/specs/device_life_cycle/README.md#manufacturing-states)'''
          ]
          kind: "spec"
          testpoint: "strap"
          checks: ["pulse samples the straps (assert_Strap_PulseSamplesTheStraps)"]
          why: '''With `lc_hw_debug_en_i` steadily On, it compares strap 1 after the pulse with MIO 27 (IOC5) of the pulse cycle or the next.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_STRAP_02b
          desc: '''At each `strap_en_i` pulse with the live `lc_hw_debug_en_i` not On, TAP strap 1 shall keep its value, unless the sampling of `REQ_STRAP_03` applies.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals tap1`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
            '''[Manufacturing States](doc/security/specs/device_life_cycle/README.md#manufacturing-states)'''
          ]
          kind: "spec"
          testpoint: "strap"
          checks: ["pulse samples the straps (assert_Strap_PulseSamplesTheStraps)"]
          why: '''With neither `lc_hw_debug_en_i` nor `lc_dft_en_i` On before the pulse, it asserts strap 1 unchanged after it.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_STRAP_03
          desc: '''While `lc_dft_en_i` is On and `dft_hold_tap_sel_i` is 0, both TAP straps shall take their pads' values of the cycle before.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
            '''[Manufacturing States](doc/security/specs/device_life_cycle/README.md#manufacturing-states)'''
          ]
          kind: "spec"
          testpoint: "strap"
          checks: ["straps follow the pads (assert_Strap_StrapsFollowThePads)"]
          why: '''While `lc_dft_en_i` is steadily On, it compares both straps with MIO 30 and MIO 27 of the cycle before.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_STRAP_04
          desc: '''While `dft_hold_tap_sel_i` is 1, the TAP straps shall keep their values, at a `strap_en_i` pulse too.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "strap"
          checks: ["straps hold (assert_Strap_StrapsHold)"]
          why: '''While `dft_hold_tap_sel_i` is 1, it asserts both straps unchanged in the next cycle, at a strap pulse and with `lc_dft_en_i` On too.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_STRAP_05
          desc: '''Outside a `strap_en_i` pulse and the sampling of `REQ_STRAP_03` (`lc_dft_en_i` On, `dft_hold_tap_sel_i` 0), the TAP straps shall keep their values.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "strap"
          checks: ["straps hold (assert_Strap_StrapsHold)"]
          why: '''With no strap pulse and `lc_dft_en_i` not On in the two cycles before, it asserts both straps unchanged whatever the pads do.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_STRAP_06
          desc: '''A TAP strap never sampled since the last full reset shall read 0.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "RTL"
          testpoint: "strap"
          checks: ["unsampled strap reads 0 (assert_Strap_UnsampledStrapReads0)", "pulse samples the straps (assert_Strap_PulseSamplesTheStraps)", "straps hold (assert_Strap_StrapsHold)"]
          why: '''The first wants both straps 0 from full reset to a sample; the others keep an unsampled strap 1 at 0.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_STRAP_07
          desc: '''An NDM reset shall leave both TAP straps unchanged.'''
          source: [
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[Reset Request Handling](hw/top_earlgrey/ip_autogen/pwrmgr/doc/theory_of_operation.md#reset-request-handling)'''
            '''[System Reset Tree](hw/top_earlgrey/ip_autogen/rstmgr/doc/theory_of_operation.md#system-reset-tree)'''
            '''[Summary](hw/top_earlgrey/ip_autogen/rstmgr/doc/theory_of_operation.md#summary)'''
            '''[top_earlgrey.hjson `resets.nodes lc_io_div4`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `resets.nodes sys_io_div4`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `module.pinmux`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "strap"
          checks: ["straps outside NDM reset (check_Strap_StrapsOutsideNdmReset)"]
          why: '''It fails on `rst_ni` or `rst_aon_ni`, which an NDM reset asserts, at a reset pin or in the input cone of a sampled TAP strap flop.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_STRAP_08
          desc: '''With `SecVolatileRawUnlockEn` 0, the Earl Grey value, `strap_en_override_i` shall not change the straps.'''
          source: [
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[pinmux.hjson `param_list` SecVolatileRawUnlockEn](hw/top_earlgrey/ip_autogen/pinmux/data/pinmux.hjson)'''
            '''[Volatile `RAW` -> `TEST_UNLOCKED0` Transition](hw/ip/lc_ctrl/doc/programmers_guide.md#volatile-raw---test_unlocked0-transition)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "strap"
          checks: ["straps hold (assert_Strap_StrapsHold)"]
          why: '''With `strap_en_override_i` free in every cycle, it asserts the straps unchanged whenever no sample is due.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
      ]
    }
    {
      name: '''Latched debug enable'''
      conditions: [
        '''the latch, On and Off are defined in the Terms.'''
      ]
      requirements: [
        {
          name: REQ_DBG_01a
          desc: '''At each `strap_en_i` pulse, the latch shall take On if `lc_hw_debug_en_i` is On.'''
          source: [
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "latch"
          checks: ["pulse samples debug enable (assert_Latch_PulseSamplesDebugEnable)"]
          why: '''With `lc_hw_debug_en_i` steadily On and the clear inputs at Off, it compares `pinmux_hw_debug_en_o` with On in the next cycle.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_DBG_01b
          desc: '''At each `strap_en_i` pulse, the latch shall take Off if `lc_hw_debug_en_i` is not On.'''
          source: [
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "latch"
          checks: ["pulse samples debug enable (assert_Latch_PulseSamplesDebugEnable)", "On only at a pulse (assert_Latch_OnOnlyAtAPulse)"]
          why: '''The first wants Off after a pulse with the debug enable not On; the second allows a rise to On only at an On pulse.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_DBG_02
          desc: '''With no `strap_en_i` pulse, no clear and no full reset, the latch shall keep its value, through an NDM reset too.'''
          source: [
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[System Reset Tree](hw/top_earlgrey/ip_autogen/rstmgr/doc/theory_of_operation.md#system-reset-tree)'''
            '''[Summary](hw/top_earlgrey/ip_autogen/rstmgr/doc/theory_of_operation.md#summary)'''
            '''[top_earlgrey.hjson `resets.nodes lc_io_div4`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `resets.nodes sys_io_div4`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `module.pinmux`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "latch"
          checks: ["latch holds (assert_Latch_LatchHolds)", "latch outside NDM reset (check_Latch_LatchOutsideNdmReset)"]
          why: '''The first keeps the output; the second fails on `rst_ni` or `rst_aon_ni`, NDM resets, in a latch flop's reset or input cone.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_DBG_03
          desc: '''`lc_hw_debug_clr_i` at any value other than Off shall turn the latch Off.'''
          source: [
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[lc_ctrl.hjson `inter_signal_list` lc_hw_debug_clr](hw/ip/lc_ctrl/data/lc_ctrl.hjson)'''
            '''[HW_DEBUG_CLR](hw/ip/lc_ctrl/doc/theory_of_operation.md#hw_debug_clr)'''
            '''[Control Signal Propagation](hw/ip/lc_ctrl/doc/interfaces.md#control-signal-propagation)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "latch"
          checks: ["clear turns Off (assert_Latch_ClearTurnsOff)"]
          why: '''It wants Off in the cycle after `lc_hw_debug_clr_i` has been at any value other than Off, On included, for two cycles.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_DBG_04
          desc: '''`lc_check_byp_en_i` at any value other than Off shall turn the latch Off.'''
          source: [
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "latch"
          checks: ["clear turns Off (assert_Latch_ClearTurnsOff)"]
          why: '''It wants Off in the cycle after `lc_check_byp_en_i` has been at any value other than Off, On included, for two cycles.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_DBG_05
          desc: '''`lc_escalate_en_i` at any value other than Off shall turn the latch Off.'''
          source: [
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[Control Signal Propagation](hw/ip/lc_ctrl/doc/interfaces.md#control-signal-propagation)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "latch"
          checks: ["clear turns Off (assert_Latch_ClearTurnsOff)"]
          why: '''It wants Off in the cycle after `lc_escalate_en_i` has been at any of its 15 values other than Off for two cycles.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_DBG_06
          desc: '''`lc_hw_debug_clr_i` and `lc_check_byp_en_i` at Off shall not turn the latch Off.'''
          source: [
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "latch"
          checks: ["latch holds (assert_Latch_LatchHolds)", "pulse samples debug enable (assert_Latch_PulseSamplesDebugEnable)"]
          why: '''With debug clear and check bypass Off, the first keeps the output outside a pulse and the second gives On after an On pulse.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_DBG_07a
          desc: '''`pinmux_hw_debug_en_o` shall be On while the latch is On.'''
          source: [
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[pinmux.hjson `countermeasures` PINMUX_HW_DEBUG_EN.INTERSIG.MUBI](hw/top_earlgrey/ip_autogen/pinmux/data/pinmux.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "latch"
          checks: ["output On or Off (assert_Latch_OutputOnOrOff)", "pulse samples debug enable (assert_Latch_PulseSamplesDebugEnable)", "latch holds (assert_Latch_LatchHolds)"]
          why: '''The second and third want On after an On sample and while held; the first rejects other encodings.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_DBG_07b
          desc: '''`pinmux_hw_debug_en_o` shall be Off while the latch is not On.'''
          source: [
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[pinmux.hjson `countermeasures` PINMUX_HW_DEBUG_EN.INTERSIG.MUBI](hw/top_earlgrey/ip_autogen/pinmux/data/pinmux.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "latch"
          checks: ["output On or Off (assert_Latch_OutputOnOrOff)", "On only at a pulse (assert_Latch_OnOnlyAtAPulse)", "clear turns Off (assert_Latch_ClearTurnsOff)"]
          why: '''The first rejects other encodings, the second an On not taken at a pulse, the third all but Off after a clear.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_DBG_08
          desc: '''After a full reset, the latch shall be Off until the next `strap_en_i` pulse.'''
          source: [
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[lc_ctrl.hjson `inter_signal_list` lc_hw_debug_en](hw/ip/lc_ctrl/data/lc_ctrl.hjson)'''
            '''[top_earlgrey.hjson `resets.nodes lc_io_div4`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `resets.nodes sys_io_div4`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `module.pinmux`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "latch"
          checks: ["Off from full reset (assert_Latch_OffFromFullReset)", "On only at a pulse (assert_Latch_OnOnlyAtAPulse)"]
          why: '''The first wants Off in full reset; the second fails any rise to On before a strap pulse with the debug enable On.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_DBG_09
          desc: '''A clear in the cycle of a `strap_en_i` pulse shall leave the latch Off.'''
          source: [
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "latch"
          checks: ["clear turns Off (assert_Latch_ClearTurnsOff)"]
          why: '''With a clear input not Off for the two cycles before a pulse, the check asserts Off in the next cycle even with `lc_hw_debug_en_i` On.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
      ]
    }
    {
      name: '''TAP selection and the JTAG pads'''
      conditions: [
        '''JTAG pads: IOR3 TCK, IOR0 TMS, IOR2 TDI, IOR4 TRST_N, IOR1 TDO (MIO 38, 35, 37, 39, 36; [top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)). Rows hold once straps and life cycle inputs have held for the delay of the input synchronizers, except TRST_N in scan mode.'''
        '''REQ_TAP_08 takes "all-zero" ([Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)); the existing testplan's `MioJtagAttrO_A` keeps the Schmitt trigger on.'''
      ]
      requirements: [
        {
          name: REQ_TAP_01a
          desc: '''With TAP straps 01, `lc_jtag_o` shall carry TCK from its pad, in every life cycle state.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey.hjson `inter_module.connect pinmux.lc_jtag`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag"
          checks: ["connected TAP gets the pads (assert_Jtag_ConnectedTapGetsThePads)"]
          why: '''It compares `tck` of `lc_jtag_o` with MIO 38 (IOR3) in the same cycle, in every life cycle state and in scan mode.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_01b
          desc: '''With TAP straps 01, `lc_jtag_o` shall carry TMS from its pad, in every life cycle state.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey.hjson `inter_module.connect pinmux.lc_jtag`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag"
          checks: ["connected TAP gets the pads (assert_Jtag_ConnectedTapGetsThePads)"]
          why: '''It compares `tms` of `lc_jtag_o` with MIO 35 (IOR0) in the same cycle, in every life cycle state and in scan mode.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_01c
          desc: '''With TAP straps 01, `lc_jtag_o` shall carry TDI from its pad, in every life cycle state.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey.hjson `inter_module.connect pinmux.lc_jtag`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag"
          checks: ["connected TAP gets the pads (assert_Jtag_ConnectedTapGetsThePads)"]
          why: '''It compares `tdi` of `lc_jtag_o` with MIO 37 (IOR2) in the same cycle, in every life cycle state and in scan mode.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_01d
          desc: '''With TAP straps 01, `lc_jtag_o` shall carry TRST_N from its pad, in every life cycle state.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey.hjson `inter_module.connect pinmux.lc_jtag`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag"
          checks: ["connected TAP gets the pads (assert_Jtag_ConnectedTapGetsThePads)"]
          why: '''Outside scan mode it compares `trst_n` with MIO 39 (IOR4) in the same cycle; in scan mode no specification names its reset.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_02a
          desc: '''With TAP straps 10, `rv_jtag_o` shall carry the four input pads while the latch is On.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey.hjson `inter_module.connect pinmux.rv_jtag`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag"
          checks: ["connected TAP gets the pads (assert_Jtag_ConnectedTapGetsThePads)"]
          why: '''It compares `rv_jtag_o` with the JTAG pads in the same cycle, TRST_N outside scan mode only.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_02b
          desc: '''With TAP straps 10, `rv_jtag_o` shall not carry the four input pads while the latch is Off.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey.hjson `inter_module.connect pinmux.rv_jtag`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag"
          checks: ["cut TAP gets zero (assert_Jtag_CutTapGetsZero)"]
          why: '''With TAP straps 10 and `pinmux_hw_debug_en_o` Off, it asserts all four fields of `rv_jtag_o` 0.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_03a
          desc: '''With TAP straps 11, `dft_jtag_o` shall carry the four input pads while `lc_dft_en_i` is On.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[pinmux.hjson `countermeasures` TAP.MUX.LC_GATED](hw/top_earlgrey/ip_autogen/pinmux/data/pinmux.hjson)'''
            '''[top_earlgrey.hjson `inter_module.top`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag"
          checks: ["connected TAP gets the pads (assert_Jtag_ConnectedTapGetsThePads)"]
          why: '''With `lc_dft_en_i` steadily On, it compares `dft_jtag_o` with the JTAG pads in the same cycle, TRST_N outside scan mode only.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_03b
          desc: '''With TAP straps 11, `dft_jtag_o` shall not carry the four input pads while `lc_dft_en_i` is Off.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[pinmux.hjson `countermeasures` TAP.MUX.LC_GATED](hw/top_earlgrey/ip_autogen/pinmux/data/pinmux.hjson)'''
            '''[top_earlgrey.hjson `inter_module.top`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag"
          checks: ["cut TAP gets zero (assert_Jtag_CutTapGetsZero)"]
          why: '''With TAP straps 11 and `lc_dft_en_i` not On in the two cycles before, it asserts `dft_jtag_o` all 0.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_04
          desc: '''Each of the life cycle, RISC-V and DFT TAPs shall receive an all-zero request while it is not connected.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey.hjson `inter_module.connect`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `inter_module.top`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag"
          checks: ["cut TAP gets zero (assert_Jtag_CutTapGetsZero)"]
          why: '''In every cycle and scan mode value, each cut one of the life cycle, RISC-V and DFT TAPs must see all four fields 0.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_05
          desc: '''`lc_dft_en_i` and `lc_hw_debug_en_i` shall count as On only at 4'b0101, in strap sampling, the latch and TAP selection.'''
          source: [
            '''[Control Signal Propagation](hw/ip/lc_ctrl/doc/interfaces.md#control-signal-propagation)'''
            '''[pinmux.hjson `countermeasures` LC_DFT_EN.INTERSIG.MUBI](hw/top_earlgrey/ip_autogen/pinmux/data/pinmux.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag"
          checks: ["only On opens", "cut TAP gets zero (assert_Jtag_CutTapGetsZero)", "pulse samples the straps (assert_Strap_PulseSamplesTheStraps)", "straps hold (assert_Strap_StrapsHold)", "pulse samples debug enable (assert_Latch_PulseSamplesDebugEnable)"]
          why: '''Each counts only 4'b0101 as On.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_06a
          desc: '''While a TAP is connected, pad IOR1 shall drive the TAP's TDO.'''
          source: [
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals tdo`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[JTAG](hw/ip/rv_dm/doc/interfaces.md#jtag)'''
            '''[Security Countermeasures](hw/ip/lc_ctrl/doc/interfaces.md#security-countermeasures)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag_pad"
          checks: ["TDO pad drives the TAP (assert_JtagPad_TdoPadDrivesTheTap)"]
          why: '''It compares `mio_out_o[36]` with the connected TAP's `tdo`, the RRAM TAP's included, in the same cycle while the pad is awake.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_06b
          desc: '''While a TAP is connected, pad IOR1 shall drive the TAP's output enable.'''
          source: [
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals tdo`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[JTAG](hw/ip/rv_dm/doc/interfaces.md#jtag)'''
            '''[Security Countermeasures](hw/ip/lc_ctrl/doc/interfaces.md#security-countermeasures)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag_pad"
          checks: ["TDO pad drives the TAP (assert_JtagPad_TdoPadDrivesTheTap)"]
          why: '''It compares `mio_oe_o[36]` with the connected TAP's `tdo_oe` in the same cycle while the pad is awake.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_07
          desc: '''While a TAP is connected, pads IOR0, IOR2, IOR3 and IOR4 shall have output enable 0.'''
          source: [
            '''The TAPs' standard JTAG port takes TCK, TMS, TRST_N and TDI as pad inputs and drives only TDO and its enable ([JTAG](hw/ip/rv_dm/doc/interfaces.md#jtag); [Security Countermeasures](hw/ip/lc_ctrl/doc/interfaces.md#security-countermeasures)); the RRAM TAP's port has the same JTAG type ([Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)) and takes the JTAG IOs ([Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation))'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag_pad"
          checks: ["input pads not driven (assert_JtagPad_InputPadsNotDriven)"]
          why: '''While a TAP is connected and the pads awake, it asserts `mio_oe_o` 0 on MIO 35, 37, 38 and 39 whatever their output selects hold.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_08
          desc: '''While a TAP is connected, every attribute of the five JTAG pads shall be 0.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag_pad"
          checks: ["JTAG attributes zero (assert_JtagPad_JtagAttributesZero)"]
          why: '''While a TAP is connected and the pads awake, it asserts every field of `mio_attr_o` 0 on MIO 35 to 39, whatever the registers hold.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_09
          desc: '''Connecting a TAP shall not change the JTAG pads' attribute registers.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag_pad"
          checks: ["attribute registers untouched (assert_JtagPad_AttributeRegistersUntouched)"]
          why: '''In every cycle it lets each JTAG pad's attribute read-back change only by a software write.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_12
          desc: '''An NDM reset with no clear shall leave a connected RISC-V TAP connected.'''
          source: [
            '''[Life Cycle Control](hw/ip/rv_dm/doc/interfaces.md#life-cycle-control)'''
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[lc_ctrl.hjson `inter_signal_list` lc_hw_debug_en](hw/ip/lc_ctrl/data/lc_ctrl.hjson)'''
            '''[top_earlgrey.hjson `resets.nodes lc_io_div4`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `resets.nodes sys_io_div4`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `module.pinmux`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `inter_module.connect pinmux.rv_jtag`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
            '''[System Reset Tree](hw/top_earlgrey/ip_autogen/rstmgr/doc/theory_of_operation.md#system-reset-tree)'''
            '''[Summary](hw/top_earlgrey/ip_autogen/rstmgr/doc/theory_of_operation.md#summary)'''
          ]
          kind: "spec"
          testpoint: "jtag"
          checks: ["TAP selection outside NDM reset (check_Jtag_TapSelectionOutsideNdmReset)", "connected TAP gets the pads (assert_Jtag_ConnectedTapGetsThePads)", "cut TAP gets zero (assert_Jtag_CutTapGetsZero)"]
          why: '''An NDM reset reaches no TAP selection flop, and that state alone picks the TAP.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
      ]
    }
    {
      name: '''RRAM TAP'''
      conditions: [
        '''a top with the RRAM TAP ([top_earlgrey_pinmux.ipconfig.hjson](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson) `enable_rram_tap`) has these rows. On another top, TAP straps 00 select no TAP ([Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)). The JTAG pad rows of TAP selection and the JTAG pads hold for it too, as a connected TAP, and its TRST_N in scan mode has no row. The rows hold once the straps and `lc_nvm_debug_en_i` have held for the delay of the input synchronizers. The TCK and TRST_N of `REQ_RRAM_01` follow their pads from a connection's second `clk_i` cycle.'''
      ]
      requirements: [
        {
          name: REQ_RRAM_01
          desc: '''With TAP straps 00, `rram_jtag_o` shall carry the four input pads while `RRAM_JTAG_SEL` is `kMultiBitBool4True` and `lc_nvm_debug_en_i` is On.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[pinmux.hjson `countermeasures` TAP.MUX.LC_GATED](hw/top_earlgrey/ip_autogen/pinmux/data/pinmux.hjson)'''
            '''!!RRAM_JTAG_SEL'''
            '''[top_earlgrey.hjson `inter_module.connect pinmux.rram_jtag`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_rram_tap`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "rram_tap"
          checks: ["connected RRAM TAP gets the pads (assert_RramTap_ConnectedRramTapGetsThePads)"]
          why: '''While connected, it compares `rram_jtag_o` with MIO 38, 35, 37 and 39 in the same cycle, `tck` and `trst_n` from its second cycle.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_RRAM_02
          desc: '''While the RRAM TAP is not connected, `rram_jtag_o` shall carry TMS 0 and TDI 0.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''!!RRAM_JTAG_SEL'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_rram_tap`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "rram_tap"
          checks: ["cut RRAM TAP gets TMS and TDI 0 (assert_RramTap_CutRramTapGetsTmsAndTdi0)"]
          why: '''In every cut cycle from the release of `rst_ni` on, it asserts `tms` and `tdi` 0 whatever the pads carry.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_RRAM_03
          desc: '''The TCK and TRST_N of `rram_jtag_o` shall be 0 in reset and in the `clk_i` cycle after reset or after any cycle with the RRAM TAP not connected.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[pinmux.hjson `clocking`](hw/top_earlgrey/ip_autogen/pinmux/data/pinmux.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_rram_tap`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "RTL"
          testpoint: "rram_tap"
          checks: ["TCK and TRST low after a cut (assert_RramTap_TckAndTrstLowAfterACut)"]
          why: '''It asserts `tck` and `trst_n` of `rram_jtag_o` 0 in reset, in the first cycle after it and in every cycle after a cut one.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_RRAM_09
          desc: '''Outside reset, in the first `clk_i` cycle with the RRAM TAP no longer connected, the TCK and TRST_N of `rram_jtag_o` shall still carry their pads' values.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[pinmux.hjson `clocking`](hw/top_earlgrey/ip_autogen/pinmux/data/pinmux.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_rram_tap`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "rram_tap"
          checks: ["TCK and TRST run one cycle more (assert_RramTap_TckAndTrstRunOneCycleMore)"]
          why: '''In the first cut cycle after a connected one, outside reset, it compares `tck` and `trst_n` with MIO 38 and 39.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_RRAM_04
          desc: '''`lc_nvm_debug_en_i` shall count as On only at 4'b0101 in the RRAM TAP's selection.'''
          source: [
            '''[Control Signal Propagation](hw/ip/lc_ctrl/doc/interfaces.md#control-signal-propagation)'''
            '''[pinmux.hjson `countermeasures` LC_NVM_DEBUG_EN.INTERSIG.MUBI](hw/top_earlgrey/ip_autogen/pinmux/data/pinmux.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_rram_tap`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "rram_tap"
          checks: ["only True and On open", "cut RRAM TAP gets TMS and TDI 0 (assert_RramTap_CutRramTapGetsTmsAndTdi0)"]
          why: '''With `lc_nvm_debug_en_i` free, any held value but 4'b0101 cuts the TAP and the second wants TMS and TDI 0.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_RRAM_05
          desc: '''After a reset, the RRAM TAP shall not be connected until software writes `kMultiBitBool4True` to `RRAM_JTAG_SEL`.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''!!RRAM_JTAG_SEL'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_rram_tap`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "rram_tap"
          checks: ["cut until the register is written (assert_RramTap_CutUntilTheRegisterIsWritten)"]
          why: '''Until the first accepted write to `RRAM_JTAG_SEL`, it asserts `tms` and `tdi` 0 whatever the straps and `lc_nvm_debug_en_i`.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_RRAM_06
          desc: '''`RRAM_JTAG_SEL` and `lc_nvm_debug_en_i` shall not change which of the life cycle, RISC-V and DFT TAPs is connected, nor what it receives.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''!!RRAM_JTAG_SEL'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_rram_tap`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "rram_tap"
          checks: ["connected TAP gets the pads (assert_Jtag_ConnectedTapGetsThePads)", "cut TAP gets zero (assert_Jtag_CutTapGetsZero)"]
          why: '''Both decide the life cycle, RISC-V and DFT TAPs with `RRAM_JTAG_SEL` and `lc_nvm_debug_en_i` free.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_RRAM_07
          desc: '''`lc_check_byp_en_i` and the latch shall not change whether the RRAM TAP is connected.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_rram_tap`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "rram_tap"
          checks: ["RRAM TAP kept through a transition (assert_RramTap_RramTapKeptThroughATransition)", "cut RRAM TAP gets TMS and TDI 0 (assert_RramTap_CutRramTapGetsTmsAndTdi0)"]
          why: '''The first keeps a connected TAP connected in a transition or with the latch Off.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
      ]
    }
    {
      name: '''DFT straps'''
      conditions: [
        '''`dft_strap_test_o` holds a valid bit and the straps. The straps take bit 0 from IOR5 (MIO 40) and bit 1 from IOR7 (MIO 42) ([existing pinmux FPV testplan: DftStrapTestO_A](hw/top_earlgrey/ip_autogen/pinmux/data/pinmux_fpv_testplan.hjson)).'''
        '''The top description gives two DFT strap pads, the theory of operation three ([Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)); the rows follow the top.'''
      ]
      requirements: [
        {
          name: REQ_DFT_01a
          desc: '''At a `strap_en_i` pulse with `lc_dft_en_i` On, `dft_strap_test_o` shall take valid 1.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
            '''[Manufacturing States](doc/security/specs/device_life_cycle/README.md#manufacturing-states)'''
          ]
          kind: "spec"
          testpoint: "dft_strap"
          checks: ["pulse samples DFT straps (assert_DftStrap_PulseSamplesDftStraps)"]
          why: '''At a strap pulse with `lc_dft_en_i` On for the two cycles before, it asserts the valid bit 1 from the next cycle.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_DFT_01b
          desc: '''At a `strap_en_i` pulse with `lc_dft_en_i` On, the straps of `dft_strap_test_o` shall take the DFT strap pads' values.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
            '''[Manufacturing States](doc/security/specs/device_life_cycle/README.md#manufacturing-states)'''
          ]
          kind: "spec"
          testpoint: "dft_strap"
          checks: ["pulse samples DFT straps (assert_DftStrap_PulseSamplesDftStraps)"]
          why: '''With `lc_dft_en_i` steadily On, it compares the straps after the pulse with MIO 40 and MIO 42 of the pulse cycle or the next.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_DFT_02a
          desc: '''Once valid, `dft_strap_test_o` shall keep valid 1 until a full reset.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[top_earlgrey.hjson `resets.nodes lc_io_div4`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `resets.nodes sys_io_div4`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `module.pinmux`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "dft_strap"
          checks: ["DFT straps held (assert_DftStrap_DftStrapsHeld)"]
          why: '''Once the valid bit is 1, it asserts the output unchanged into every next cycle not in full reset, whatever `lc_dft_en_i` and the pads do.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_DFT_02b
          desc: '''Once valid, `dft_strap_test_o` shall keep its straps until a full reset.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[top_earlgrey.hjson `resets.nodes lc_io_div4`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `resets.nodes sys_io_div4`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `module.pinmux`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "dft_strap"
          checks: ["DFT straps held (assert_DftStrap_DftStrapsHeld)"]
          why: '''Once the valid bit is 1, it asserts the two straps unchanged into every next cycle that is not in full reset.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_DFT_03
          desc: '''Before a sample at a `strap_en_i` pulse with `lc_dft_en_i` On, `dft_strap_test_o` shall be all 0, whatever the DFT strap pads carry.'''
          source: [
            '''[chip_testplan.hjson `chip_sw_tap_strap_sampling`](hw/top_earlgrey/data/chip_testplan.hjson)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "dft_strap"
          checks: ["zero until sampled (assert_DftStrap_ZeroUntilSampled)"]
          why: '''Until a strap pulse with `lc_dft_en_i` On in either of the two cycles before, it asserts every bit of `dft_strap_test_o` 0.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
      ]
    }
    {
      name: '''Earl Grey 2'''
      conditions: [
        '''Every Earl Grey row holds on Earl Grey 2 over the Earl Grey 2 values and pads below, unless a row here replaces or extends it.'''
        '''Allowed pad, Main pad and Main off: Terms.'''
        '''Pads: TAP straps 0, 1 on IOC8, IOC5; DFT straps 0, 1 on SPI_HOST_D2, SPI_HOST_D3; TCK IOA5, TMS IOA0, TDI IOA4, TRST_N IOA6, TDO IOA1.'''
      ]
      requirements: [
        {
          name: REQ_EG2_01
          desc: '''MIO peripheral input `n` shall read 0 while `MIO_PERIPH_INSEL_n` is 2 + `p` and pad `p` is not allowed for `n`.'''
          source: [
            '''[Muxing Matrix](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#muxing-matrix)'''
            '''[Pinmux Configuration](hw/top_earlgrey/ip_autogen/pinmux/doc/programmers_guide.md#pinmux-configuration)'''
            '''!!MIO_PERIPH_INSEL.IN'''
          ]
          kind: "spec"
          testpoint: "sparse_insel"
          checks: ["unlisted pad reads zero (assert_SparseInsel_UnlistedPadReadsZero)"]
          why: '''The check compares the input with 0 while its input select is unlisted.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_EG2_02
          desc: '''MIO pad `p` shall be high-Z (output enable 0, output 0) while `MIO_OUTSEL_p` is 3 + `k` and output `k` is not allowed for `p`.'''
          source: [
            '''[Muxing Matrix](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#muxing-matrix)'''
            '''[Pinmux Configuration](hw/top_earlgrey/ip_autogen/pinmux/doc/programmers_guide.md#pinmux-configuration)'''
            '''!!MIO_OUTSEL.OUT'''
          ]
          kind: "spec"
          testpoint: "sparse_outsel"
          checks: ["unlisted output disables pad (assert_SparseOutsel_UnlistedOutputDisablesPad)", "disabled pad drives zero (assert_SparseOutsel_DisabledPadDrivesZero)"]
          why: '''The checks compare `oe` and `out` with 0 while the pad's output select is unlisted.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_EG2_04
          desc: '''A signal whose `pads` list is empty shall be allowed every pad.'''
          source: [
            '''[top_earlgrey.hjson `pinmux`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
          ]
          kind: "spec"
          testpoint: "eg2_matrix"
          checks: ["drives selected output (assert_PadOutput_DrivesSelectedOutput)"]
          why: '''Run over the allowed pairs, the check pairs output 110, whose list is empty, with every MIO pad.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_EG2_10
          desc: '''Each input of `gpio0` and `gpio1` shall read what its input select names, and each pad whose output select names one of their outputs shall carry it.'''
          source: [
            '''[top_earlgrey.hjson `pinmux.signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
          ]
          kind: "spec"
          testpoint: "eg2_matrix"
          checks: ["reads tie 0 (assert_PadListen_ReadsTie0)", "reads tie 1 (assert_PadListen_ReadsTie1)", "reads selected pad (assert_PadListen_ReadsSelectedPad)", "drives selected output (assert_PadOutput_DrivesSelectedOutput)"]
          why: '''Run over every input and output of both modules.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_EG2_11a
          desc: '''For a pad allowed for the signal, input select 2 + `p` shall read pad `p`, as on Earl Grey (`REQ_IN_03`).'''
          source: [
            '''[Muxing Matrix](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#muxing-matrix)'''
            '''!!MIO_PERIPH_INSEL.IN'''
          ]
          kind: "spec"
          testpoint: "eg2_matrix"
          checks: ["reads selected pad (assert_PadListen_ReadsSelectedPad)"]
          why: '''Run over the allowed pairs, the check compares the input with pad `p` while its input select is 2 + `p`.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_EG2_11b
          desc: '''For a pad allowed for the signal, output select 3 + `k` shall carry output `k`, as on Earl Grey (`REQ_OUT_04a`).'''
          source: [
            '''[Muxing Matrix](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#muxing-matrix)'''
            '''!!MIO_OUTSEL.OUT'''
          ]
          kind: "spec"
          testpoint: "eg2_matrix"
          checks: ["drives selected output (assert_PadOutput_DrivesSelectedOutput)"]
          why: '''Run over the allowed pairs, the check compares the pad's `out` with output `k` while its output select is 3 + `k`.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_EG2_11c
          desc: '''For a pad allowed for the signal, output select 3 + `k` shall carry output enable `k`, as on Earl Grey (`REQ_OUT_04b`).'''
          source: [
            '''[Muxing Matrix](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#muxing-matrix)'''
            '''!!MIO_OUTSEL.OUT'''
          ]
          kind: "spec"
          testpoint: "eg2_matrix"
          checks: ["drives selected output (assert_PadOutput_DrivesSelectedOutput)"]
          why: '''The same check compares the pad's `oe` with `periph_to_mio_oe_i[k]`.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_EG2_12a
          desc: '''For every input, whatever its list, input select 0 shall make the input read 0, as on Earl Grey (`REQ_IN_01`).'''
          source: [
          ]
          kind: "spec"
          testpoint: "eg2_matrix"
          checks: ["reads tie 0 (assert_PadListen_ReadsTie0)"]
          why: '''Run on every input, whatever its list, the check compares the input with 0 while its input select is 0.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_EG2_12b
          desc: '''For every input, whatever its list, input select 1 shall make the input read 1, as on Earl Grey (`REQ_IN_02`).'''
          source: [
          ]
          kind: "spec"
          testpoint: "eg2_matrix"
          checks: ["reads tie 1 (assert_PadListen_ReadsTie1)"]
          why: '''The same with 1 for input select 1, the one-pad signals included.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_EG2_12c
          desc: '''For every pad, whatever its list, output select 0 shall drive the pad 0, as on Earl Grey (`REQ_OUT_01a`, `REQ_OUT_01b`).'''
          source: [
          ]
          kind: "spec"
          testpoint: "eg2_matrix"
          checks: ["tie 0 drives 0 (assert_PadOutput_Tie0Drives0)"]
          why: '''Run on every MIO pad, whatever its list, the check compares (`out`, `oe`) with (0, 1) while the output select is 0.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_EG2_12d
          desc: '''For every pad, whatever its list, output select 1 shall drive the pad 1, as on Earl Grey (`REQ_OUT_02a`, `REQ_OUT_02b`).'''
          source: [
          ]
          kind: "spec"
          testpoint: "eg2_matrix"
          checks: ["tie 1 drives 1 (assert_PadOutput_Tie1Drives1)"]
          why: '''The same with (1, 1) for output select 1. A design that applies the pad list to the constants leaves the pad high-Z and fails it.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_EG2_12e
          desc: '''For every pad, whatever its list, output select 2 shall make the pad high-Z, output 0, as on Earl Grey (`REQ_OUT_03a`, `REQ_OUT_03b`).'''
          source: [
          ]
          kind: "spec"
          testpoint: "eg2_matrix"
          checks: ["select 2 is high-Z (assert_PadOutput_Select2IsHighZ)"]
          why: '''The same with (0, 0) for output select 2. A design that decodes 2 as an output or a constant enables the pad and fails it.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_EG2_03a
          desc: '''From reset until software writes it, each input select shall act at its signal's `default`: the input reads its default pad, 0 or 1, else 0. Replaces REQ_IN_06.'''
          source: [
            '''[top_earlgrey.hjson `pinmux`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
          ]
          kind: "spec"
          testpoint: "eg2_default"
          checks: ["input starts at default (assert_Eg2Default_InputStartsAtDefault)"]
          why: '''From reset until its select is written, the check compares the input with the input's default value.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_EG2_03b
          desc: '''Until software writes it after reset, each MIO output select shall give its pad the output whose `default` names that pad, else high-Z. Replaces REQ_OUT_07.'''
          source: [
            '''[top_earlgrey.hjson `pinmux`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
          ]
          kind: "spec"
          testpoint: "eg2_default"
          checks: ["pad starts at default (assert_Eg2Default_PadStartsAtDefault)"]
          why: '''From reset until its select is written, the check compares the pad with the pad's default drive.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_EG2_15
          desc: '''After reset, each pad's attribute output shall be its top entry's reset value (all 0 if no `attrs`), 0 in fields its type does not keep. Replaces REQ_ATTR_10.'''
          source: [
            '''[top_earlgrey.hjson `pinout`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
          ]
          kind: "spec"
          testpoint: "eg2_attr_reset"
          checks: ["reset attributes (assert_PadAttr_ResetAttributes)"]
          why: '''Until the pad's first attribute write, the check compares its attribute output with its top attribute reset value.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_EG2_05
          desc: '''A detector whose `PADSEL` names a pad that is not wakeup capable shall watch 0.'''
          source: [
          ]
          kind: "spec"
          testpoint: "wkup_capable"
          checks: ["watched value off the list (assert_WkupCapable_WatchedValueOffTheList)"]
          why: '''The check applies the rule of `wakeup` with 0 watched, so a rise on the pad sets no cause.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_EG2_13
          desc: '''A detector shall watch the wakeup-capable pad it selects, encoded as on Earl Grey (`REQ_WKUP_01`, `REQ_WKUP_02`). With no pad marked, every pad is capable.'''
          source: [
          ]
          kind: "spec"
          testpoint: "wkup_capable"
          checks: ["wakeup rule on capable pads"]
          why: '''The checks of `wakeup` run on each wakeup-capable pad, every pad on a top that marks none.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_EG2_06a
          desc: '''After Main is off, every Main-section select shall act at its reset value until software writes it.'''
          source: [
          ]
          kind: "spec"
          testpoint: "split_reset"
          checks: ["Main selects on Main reset (check_SplitReset_MainSelectsOnMainReset)", "input starts at default (assert_Eg2Default_InputStartsAtDefault)", "pad starts at default (assert_Eg2Default_PadStartsAtDefault)"]
          why: '''Main off resets each Main select; eg2_default decides its value.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_EG2_06b
          desc: '''After Main is off, the lock of every Main-section select shall read 1 until software writes it.'''
          source: [
          ]
          kind: "spec"
          testpoint: "split_reset"
          checks: ["Main selects on Main reset (check_SplitReset_MainSelectsOnMainReset)", "the CSR checker"]
          why: '''Each Main lock takes the Main reset, and the CSR checker expects 1 after reset.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_EG2_07a
          desc: '''Main off shall change no AON-section select.'''
          source: [
          ]
          kind: "spec"
          testpoint: "split_reset"
          checks: ["AON state off Main reset (check_SplitReset_AonStateOffMainReset)", "the CSR checker"]
          why: '''The Main reset reaches no AON select's reset pin; the CSR checker allows a change only on an accepted write.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_EG2_07b
          desc: '''Main off shall change no AON-section lock.'''
          source: [
          ]
          kind: "spec"
          testpoint: "split_reset"
          checks: ["AON state off Main reset (check_SplitReset_AonStateOffMainReset)", "the CSR checker"]
          why: '''The Main reset reaches no AON lock's reset pin; the CSR checker allows a change only on an accepted write of 0.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_EG2_07c
          desc: '''Main off shall change no sleep status bit.'''
          source: [
          ]
          kind: "spec"
          testpoint: "split_reset"
          checks: ["AON state off Main reset (check_SplitReset_AonStateOffMainReset)", "bit set only at entry (assert_PadSleep_BitSetOnlyAtEntry)", "bit holds until cleared (assert_PadSleep_BitHoldsUntilCleared)"]
          why: '''No status bit takes the Main reset; the bit checks forbid other changes.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
