          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ATTR_09f
          desc: '''The field `schmitt_en` shall read back 0 where the pad's type does not keep the field.'''
          source: [
            '''[Pad Attributes](hw/top_earlgrey/ip_autogen/pinmux/doc/programmers_guide.md#pad-attributes)'''
            '''[top_earlgrey.hjson `pinout.pads`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
          ]
          kind: "spec"
          testpoint: "pad_attr"
          checks: ["unsupported bits read 0 (assert_PadAttr_UnsupportedBitsRead0)"]
          why: '''The check requires `schmitt_en` to read back a written 0, and 0 on every pad of its type once one read a written 1 as 0.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ATTR_09g
          desc: '''The field `input_disable` shall read back 0 where the pad's type does not keep the field.'''
          source: [
            '''[Pad Attributes](hw/top_earlgrey/ip_autogen/pinmux/doc/programmers_guide.md#pad-attributes)'''
            '''[top_earlgrey.hjson `pinout.pads`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
          ]
          kind: "spec"
          testpoint: "pad_attr"
          checks: ["unsupported bits read 0 (assert_PadAttr_UnsupportedBitsRead0)"]
          why: '''The check requires `input_disable` to read back a written 0, and 0 on every pad of its type once one read a written 1 as 0.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ATTR_09h
          desc: '''Each bit of the field `slew_rate` shall read back 0 where the pad's type does not keep that bit.'''
          source: [
            '''[Pad Attributes](hw/top_earlgrey/ip_autogen/pinmux/doc/programmers_guide.md#pad-attributes)'''
            '''[top_earlgrey.hjson `pinout.pads`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
          ]
          kind: "spec"
          testpoint: "pad_attr"
          checks: ["unsupported bits read 0 (assert_PadAttr_UnsupportedBitsRead0)"]
          why: '''The check requires each bit of `slew_rate` to read back a written 0, and 0 on every pad of its type once one read a written 1 as 0.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ATTR_09i
          desc: '''Each bit of the field `drive_strength` shall read back 0 where the pad's type does not keep that bit.'''
          source: [
            '''[Pad Attributes](hw/top_earlgrey/ip_autogen/pinmux/doc/programmers_guide.md#pad-attributes)'''
            '''[top_earlgrey.hjson `pinout.pads`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
          ]
          kind: "spec"
          testpoint: "pad_attr"
          checks: ["unsupported bits read 0 (assert_PadAttr_UnsupportedBitsRead0)"]
          why: '''The check requires each bit of `drive_strength` to read back a written 0, and 0 on every pad of its type once one read a written 1 as 0.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ATTR_10
          desc: '''After reset, each pad's attribute output shall be its reset value, 0 in fields its type does not keep. All are 0 but `pull_en` of MIO pad 30 (IOC8), which is 1.'''
          source: [
            '''!!MIO_PAD_ATTR'''
            '''!!DIO_PAD_ATTR'''
            '''[top_earlgrey.hjson `pinout`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `pinout.pads IOC8`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals tap0`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
          ]
          kind: "spec"
          testpoint: "pad_attr"
          checks: ["reset attributes (assert_PadAttr_ResetAttributes)"]
          why: '''Until the pad's first attribute write after reset, the check compares the pad's attribute output with the reset attributes.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
