{
  name: "cheriot_mem_sys_fpv"
  // The requirements of the CHERIoT memory subsystem FPV testplan (doc/fpv/README.md),
  // one entry each:
  //   name, desc   the requirement ID and its statement
  //   source      where the rule comes from: !!REGISTER names a register (reggen's
  //               form), a Markdown link names a document section or a key
  //   kind        "spec": a specification states the rule; "RTL": none does, and the
  //               rule follows the design's present behaviour or leaves the outcome
  //               to a specification question
  //   testpoint   its testpoint in cheriot_mem_sys_fpv_testplan.hjson
  //   checks      what decides it: "<check name> (<planned assertion>)"
  //   why         why those checks prove it
  //   milestone   the verification stage of its testpoint: V1, V2 or V2S
  //   priority    the order of work within a stage: "1" before "2"
  //   security    true when a security property depends on it
  //   state       "open" until its checks are proven; with a reason where its checks
  //               decide it only in part
  // The file holds, besides the entries:
  //   written_for   the instance the plan was written for and read against: the
  //                 parameters of Earl Grey (interfaces.md, Parameters)
  //   terms         the words the requirements use, each with its meaning
  //   parameters    the values the instance sets, with the value on Earl Grey
  //   groups        the requirements by feature; a group's conditions say when
  //                 its requirements hold and define its own words
  written_for: "earlgrey"
  terms: [
    {
      name: '''CHERIoT mode'''
      desc: '''The mode enable `cheriot_ena_i` is exactly `MuBi4True`. Any other value, an invalid encoding included, is ePMP mode ([Block Diagram](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#block-diagram), [Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine); [cheriot_mem_sys.hjson `INTERSIG.MUBI`](hw/ip/cheriot_mem_sys/data/cheriot_mem_sys.hjson)).'''
    }
    {
      name: '''Tag path'''
      desc: '''The path that stores and returns the tags: the core's tag filter, the WTRC, the 2:1 tag arbiter and the RMW filter, up to the meta SRAM.'''
    }
    {
      name: '''Tag sideband'''
      desc: '''The capability tag carried next to `cored_tl_d`: `cored_tag_h2d` with a request and `cored_tag_d2h` with a response, each a `mubi4_t` ([Block Diagram](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#block-diagram)). A request's tag sideband is set when it is exactly `MuBi4True`. Any other value, `MuBi4False` or an invalid encoding (neither `MuBi4True` nor `MuBi4False`), is clear ([Block Diagram](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#block-diagram)).'''
    }
    {
      name: '''Hinted capability load'''
      desc: '''A read of both words of a capability with the tag sideband set, which asks for the tag ([load_store_unit.rst, Data-Side Memory Interface](hw/vendor/lowrisc_ibex/doc/03_reference/load_store_unit.rst)).'''
    }
    {
      name: '''W0, W1'''
      desc: '''The lower and the upper 32-bit word of a capability. The core sends W0 first ([Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)).'''
    }
    {
      name: '''Capability store to the NVM'''
      desc: '''A write in CHERIoT mode to the NVM with the tag sideband set ([Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)). The WTRC handles it.'''
    }
    {
      name: '''Sweep'''
      desc: '''One run of the revocation engine over `TBRE_NUM_CAPS` capabilities from `TBRE_BASE_ADDR` ([Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)).'''
    }
    {
      name: '''Watch window'''
      desc: '''For one capability of a sweep: from the engine presenting the read of its lower word until its clear is presented. A core write in it keeps its tag ([Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)).'''
    }
    {
      name: '''TRVK filter'''
      desc: '''The load barrier on the engine's reads: it revokes a tagged, non-sealing capability whose base has its revocation bit set, or whose bitmap lookup fails ([Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)).'''
    }
    {
      name: '''`fatal_fault`'''
      desc: '''The subsystem's one fatal alert ([Security Alerts](hw/ip/cheriot_mem_sys/doc/interfaces.md#security-alerts)).'''
    }
    {
      name: '''Tagged region'''
      desc: '''The main SRAM, from `MainSramBaseAddr` up to `MainSramTopAddr`, or the NVM, from `NvmBaseAddr` up to `NvmTopAddr`: the memory that can hold capabilities ([Meta SRAM Address Map](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#meta-sram-address-map)).'''
    }
    {
      name: '''Meta request'''
      desc: '''A request the tag filter sends on its meta port, to read or to write one tag.'''
    }
    {
      name: '''Captured tag'''
      desc: '''The tag a W0 load returns, held by the tag filter for the W1 load that follows ([Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)).'''
    }
    {
      name: '''Requester ports'''
      desc: '''The four ports that reach the meta SRAM: the tag port (from the RMW filter), `corerevbm_tl` (bitmap reads from the core's TRVK filter), `revbm_tl_d` (software, through `xbar_main`) and the revocation engine's TRVK port ([Block Diagram](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#block-diagram), [Meta SRAM Address Map](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#meta-sram-address-map), [Access Checkers](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#access-checkers), [Timing](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#timing)).'''
    }
    {
      name: '''Tag path access'''
      desc: '''A request on the tag port.'''
    }
    {
      name: '''Region of a port'''
      desc: '''The tag port owns both capability tag regions, the NVM capability tags and the main SRAM capability tags, `0x1100_0C00`-`0x1100_97FF`. The other three requester ports own the revocation bitmap, `0x1100_0000`-`0x1100_0BFF` ([Meta SRAM Address Map](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#meta-sram-address-map), column "Reachable from").'''
    }
    {
      name: '''Legal request'''
      desc: '''All four conditions of [Access Checkers](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#access-checkers) hold: CHERIoT mode; the address inside the port's region; a full 32-bit word at a word-aligned address (`a_size` = 2, so TL-UL sets all four `a_mask` bits: [Request Channel (Channel A)](hw/ip/tlul/doc/TlulProtocolChecker.md#request-channel-channel-a), `sizeMatchesMask`); the opcode `Get` or `PutFullData`.'''
    }
    {
      name: '''Error answer'''
      desc: '''The answer an access checker gives a request that is not legal, from its own error responder ([Access Checkers](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#access-checkers)).'''
    }
    {
      name: '''Base'''
      desc: '''The lowest address a capability covers, decoded from its address and its bounds fields (CHERIoT architecture specification v1.0, section 7.13.3 (PDF pages 69-70)).'''
    }
    {
      name: '''Sealing capability'''
      desc: '''A capability whose permissions are in the sealing format and grant SE, US or U0, the capabilities that the instruction CLC exempts (the CHERIoT architecture specification v1.0, CLC, PDF page 114). The base of a sealing capability is in a namespace of its own, so such a capability is never revoked (CHERIoT architecture specification v1.0, section 7.8 (PDF page 58)).'''
    }
    {
      name: '''Revocation bit of a base'''
      desc: '''Bit `b` of bitmap word `w`, with `w * 32 + b` = (base - `MainSramBaseAddr`) / 8 ([Meta SRAM Address Map](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#meta-sram-address-map)). The engine uses the bit of the capability's base, not of its address ([Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine); CHERIoT architecture specification v1.0, section 7.8 (PDF page 58)). For example, base `0x1000_4000` is word 64, bit 0.'''
    }
    {
      name: '''Taken start'''
      desc: '''A write of 1 to `TBRE_START` while `TBRE_REGWEN` is 1, in CHERIoT mode, with `TBRE_NUM_CAPS` not zero and `TBRE_BASE_ADDR` in a tagged region ([Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)).'''
    }
    {
      name: '''Ignored start'''
      desc: '''Any other write of 1 to `TBRE_START` while `TBRE_REGWEN` is 1 ([Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)).'''
    }
    {
      name: '''BASE, NUM'''
      desc: '''The values of `TBRE_BASE_ADDR` and `TBRE_NUM_CAPS` at the start.'''
    }
    {
      name: '''Swept capabilities'''
      desc: '''The N capabilities at BASE, BASE + 8,..., with N = min(NUM, (top - BASE) / 8) and top the `MainSramTopAddr` or `NvmTopAddr` of BASE's region ([Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)).'''
    }
    {
      name: '''Active'''
      desc: '''`TBRE_REGWEN` is 0 ([Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)).'''
    }
    {
      name: '''Revoked'''
      desc: '''A swept capability whose tag is set, which is not a sealing capability, whose base lies in the main SRAM region, and whose base's revocation bit is set or whose bitmap lookup failed ([Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine); [Revoking Capabilities](hw/ip/cheriot_mem_sys/doc/programmers_guide.md#revoking-capabilities)).'''
    }
    {
      name: '''Touches'''
      desc: '''A core write touches a capability when it is presented on `cored_tl_d`, or accepted there and not yet answered, with its address in the capability's 8 bytes ([Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)).'''
    }
  ]
  parameters: [
    {
      name: "MainSramBaseAddr"
      desc: '''Base address of the main SRAM region, inclusive.'''
      value: "0x1000_0000"
    }
    {
      name: "MainSramTopAddr"
      desc: '''Top address of the main SRAM region, exclusive.'''
      value: "0x1003_0000"
    }
    {
      name: "NvmBaseAddr"
      desc: '''Base address of the NVM region, inclusive.'''
      value: "0x3000_0000"
    }
    {
      name: "NvmTopAddr"
      desc: '''Top address of the NVM region, exclusive.'''
      value: "0x3020_0000"
    }
    {
      name: "MetaSramBaseAddr"
      desc: '''Base address of the unified meta SRAM.'''
      value: "0x1100_0000"
    }
    {
      name: "MemSizeRevbm"
      desc: '''Size of the `revbm` window in bytes, set by topgen. Must equal the size of the main SRAM revocation bitmap, which an assertion in the RTL checks.'''
      value: "3072"
    }
    {
      name: "AlertAsyncOn"
      desc: '''Adds synchronizers to the alert sender for an alert handler on another clock, set by topgen.'''
      value: "1'b1"
    }
    {
      name: "AlertSkewCycles"
      desc: '''Cycles of skew tolerated on the differential alert signals, set by topgen.'''
      value: "1"
    }
  ]
  groups: [
    {
      name: '''Tag filter'''
      conditions: [
        '''Every row holds for each access that the core presents, except a capability store to the NVM.'''
        '''The WTRC group covers a capability store to the NVM.'''
        '''The proofs present no invalid tag sideband on the upper word of a capability, so no check decides the rows for that word. The plan page lists the case under Out of scope.'''
      ]
      requirements: [
        {
          name: REQ_TF_01a
          desc: '''Every core access shall be forwarded to the host port.'''
          source: [
            '''[Block Diagram](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#block-diagram)'''
          ]
          kind: "spec"
          testpoint: "tf_forward"
          checks: ["accepted after forwarded (assert_TfForward_AcceptedAfterForwarded)"]
          why: '''The core only lets go of a request once it is accepted, and acceptance needs the host request to have been taken first. So no accepted request can skip the host port.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_01d
          desc: '''No core access shall be forwarded to the host port twice.'''
          source: [
            '''[Block Diagram](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#block-diagram)'''
          ]
          kind: "spec"
          testpoint: "tf_forward"
          checks: ["no extra host request (assert_TfForward_NoExtraHostRequest)"]
          why: '''Each core request gives one credit, and its first host request uses it up. A second host request for the same core request finds no credit and fails the check.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_01c
          desc: '''The host port shall carry no request that the core did not present.'''
          source: [
            '''[Block Diagram](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#block-diagram)'''
          ]
          kind: "spec"
          testpoint: "tf_forward"
          checks: ["no extra host request (assert_TfForward_NoExtraHostRequest)"]
          why: '''A host request with no core request behind it finds no credit and fails the check. It is checked when presented, not only when accepted, which also catches a request the host port never takes.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_01b
          desc: '''A forwarded request shall carry the core access's address unchanged.'''
          source: [
            '''[Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)'''
          ]
          kind: "spec"
          testpoint: "tf_forward"
          checks: ["forwarded unchanged (assert_TfForward_ForwardedUnchanged)"]
          why: '''The check compares the host request's address with the core request's in the cycle it is forwarded. Any changed bit fails it.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_01e
          desc: '''A forwarded request shall carry the core access's opcode unchanged.'''
          source: [
            '''[Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)'''
          ]
          kind: "spec"
          testpoint: "tf_forward"
          checks: ["forwarded unchanged (assert_TfForward_ForwardedUnchanged)"]
          why: '''The check compares the host request's opcode with the core request's in the cycle it is forwarded. A read turned into a write, or the reverse, fails it.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_01f
          desc: '''A forwarded request shall carry the core access's size unchanged.'''
          source: [
            '''[Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)'''
          ]
          kind: "spec"
          testpoint: "tf_forward"
          checks: ["forwarded unchanged (assert_TfForward_ForwardedUnchanged)"]
          why: '''The check compares the host request's size with the core request's. A changed size fails it.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_01g
          desc: '''A forwarded request shall carry the core access's byte mask unchanged.'''
          source: [
            '''[Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)'''
          ]
          kind: "spec"
          testpoint: "tf_forward"
          checks: ["forwarded unchanged (assert_TfForward_ForwardedUnchanged)"]
          why: '''The check compares the host request's mask with the core request's. A byte added to or dropped from a store fails it.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_01h
          desc: '''A forwarded request shall carry the core access's data unchanged.'''
          source: [
            '''[Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)'''
          ]
          kind: "spec"
          testpoint: "tf_forward"
          checks: ["forwarded unchanged (assert_TfForward_ForwardedUnchanged)"]
          why: '''The check compares the host request's data with the core request's. Any changed data bit fails it.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_01i
          desc: '''A forwarded request shall carry the core access's source ID (`a_source`) unchanged.'''
          source: [
            '''[Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)'''
          ]
          kind: "spec"
          testpoint: "tf_forward"
          checks: ["forwarded unchanged (assert_TfForward_ForwardedUnchanged)"]
          why: '''The check compares the host request's `a_source` with the core request's. A changed ID fails it.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_01j
          desc: '''A forwarded request shall carry the core access's user bits (`a_user`, with its integrity) unchanged.'''
          source: [
            '''[Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)'''
          ]
          kind: "spec"
          testpoint: "tf_forward"
          checks: ["forwarded unchanged (assert_TfForward_ForwardedUnchanged)"]
          why: '''The check compares the host request's `a_user`, its integrity included, with the core request's. Any changed bit fails it.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_02a
          desc: '''In CHERIoT mode, a 64-bit-aligned read to a tagged region that the core hints as a capability load shall issue a meta request.'''
          source: [
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
            '''[cheriot.rst, Data Memory Tag Interface](hw/vendor/lowrisc_ibex/doc/03_reference/cheriot.rst)'''
          ]
          kind: "spec"
          testpoint: "tf_lookup"
          checks: ["lookup in same cycle (assert_TfLookup_LookupInSameCycle)"]
          why: '''For every request that needs a lookup, the check requires its meta request. A hinted aligned read to a tagged region in CHERIoT mode is one, so a missing lookup fails it.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_02b
          desc: '''In CHERIoT mode, a 64-bit-aligned hinted read to a tagged region shall issue at most one meta request.'''
          source: [
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
          ]
          kind: "spec"
          testpoint: "tf_lookup"
          checks: ["no unneeded lookup (assert_TfLookup_NoUnneededLookup)"]
          why: '''The request's credit is used up by its first meta request, so a second one fails the check.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_03a
          desc: '''In CHERIoT mode, a write to a tagged region shall issue a meta request.'''
          source: [
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
            '''[Datapath](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#datapath)'''
          ]
          kind: "spec"
          testpoint: "tf_lookup"
          checks: ["lookup in same cycle (assert_TfLookup_LookupInSameCycle)"]
          why: '''A write to a tagged region in CHERIoT mode needs a lookup, so the check requires its meta request.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_03b
          desc: '''In CHERIoT mode, a write to a tagged region shall issue at most one meta request.'''
          source: [
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
          ]
          kind: "spec"
          testpoint: "tf_lookup"
          checks: ["no unneeded lookup (assert_TfLookup_NoUnneededLookup)"]
          why: '''The same credit as for the read catches a second meta request.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_04a
          desc: '''In ePMP mode, no access shall issue a meta request.'''
          source: [
            '''[cheriot_mem_sys.hjson `MODE_GATING`](hw/ip/cheriot_mem_sys/data/cheriot_mem_sys.hjson)'''
            '''[cheriot_mem_sys.hjson `INTERSIG.MUBI`](hw/ip/cheriot_mem_sys/data/cheriot_mem_sys.hjson)'''
          ]
          kind: "spec"
          testpoint: "tf_lookup"
          checks: ["no unneeded lookup (assert_TfLookup_NoUnneededLookup)"]
          why: '''In ePMP mode no request needs a lookup, so any meta request finds no credit and fails the check. The check runs with all 15 ePMP values of the mode enable.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_04b
          desc: '''In CHERIoT mode, an access that is neither an aligned hinted read nor a write to a tagged region shall issue no meta request.'''
          source: [
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
          ]
          kind: "spec"
          testpoint: "tf_lookup"
          checks: ["no unneeded lookup (assert_TfLookup_NoUnneededLookup)"]
          why: '''A plain read, a W1 read or an access outside the tagged regions gives no credit, so its meta request fails the check.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_05a
          desc: '''A meta request shall address the meta word that holds the tag of the 8-byte location containing the access address.'''
          source: [
            '''[Metadata Encoding](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#metadata-encoding)'''
            '''[Meta SRAM Address Map](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#meta-sram-address-map)'''
            '''No specification states the bit order of the tags within a meta word.'''
          ]
          kind: "spec"
          testpoint: "tf_meta_request"
          checks: ["tag word and bit (assert_TfMetaRequest_TagWordAndBit)"]
          why: '''The check computes the tag word from the request's address and compares it with the meta request's address. Another word fails it.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_05b
          desc: '''A meta request's bit select shall name the bit, within the meta word, of the 8-byte location containing the access address.'''
          source: [
            '''[Metadata Encoding](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#metadata-encoding)'''
            '''No specification states the bit order of the tags within a meta word.'''
          ]
          kind: "spec"
          testpoint: "tf_meta_request"
          checks: ["tag word and bit (assert_TfMetaRequest_TagWordAndBit)"]
          why: '''The check computes the tag bit from the address and compares it with the bit select. A neighbour's bit fails it.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_06a
          desc: '''A write with the tag sideband clear shall ask for tag 0.'''
          source: [
            '''[cheriot_mem_sys.hjson `TAG_CLEAR_ON_DATA_WRITE`](hw/ip/cheriot_mem_sys/data/cheriot_mem_sys.hjson)'''
            '''CHERIoT architecture specification v1.0, section 7.7'''
          ]
          kind: "spec"
          testpoint: "tf_meta_request"
          checks: ["write carries its tag (assert_TfMetaRequest_WriteCarriesItsTag)", "Get only for a read (assert_TfMetaRequest_GetOnlyForARead)"]
          why: '''The first check compares the tag to write with the sideband, 0 for a plain store. The second makes sure the meta request is a write at all, so the RMW filter really writes the 0.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_06b
          desc: '''A write with the tag sideband set shall ask for tag 1.'''
          source: [
            '''[Inter-Module Signals](hw/ip/cheriot_mem_sys/doc/interfaces.md#inter-module-signals)'''
            '''[cheriot.rst, Data Memory Tag Interface](hw/vendor/lowrisc_ibex/doc/03_reference/cheriot.rst)'''
          ]
          kind: "spec"
          testpoint: "tf_meta_request"
          checks: ["write carries its tag (assert_TfMetaRequest_WriteCarriesItsTag)", "Get only for a read (assert_TfMetaRequest_GetOnlyForARead)"]
          why: '''The same two checks, with the sideband 1 of a capability store.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_06c
          desc: '''A write whose tag sideband holds an invalid encoding shall ask for tag 0.'''
          source: [
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
          ]
          kind: "spec"
          testpoint: "tf_meta_request"
          checks: ["write carries its tag (assert_TfMetaRequest_WriteCarriesItsTag)", "Get only for a read (assert_TfMetaRequest_GetOnlyForARead)"]
          why: '''The first check reads the sideband at `cored_tag_h2d` and expects tag 0 for every value but `MuBi4True`. A design that reads an invalid encoding as set, for example by testing one bit, writes tag 1 and fails it.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_07a
          desc: '''A response to the core shall carry its host response's opcode.'''
          source: [
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
          ]
          kind: "spec"
          testpoint: "tf_forward"
          checks: ["answer has host fields (assert_TfForward_AnswerHasHostFields)"]
          why: '''The check compares the answer's `d_opcode` with that of the host answer it joins. A changed opcode fails it.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_07b
          desc: '''A response to the core shall carry its host response's size.'''
          source: [
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
          ]
          kind: "spec"
          testpoint: "tf_forward"
          checks: ["answer has host fields (assert_TfForward_AnswerHasHostFields)"]
          why: '''The check compares the answer's `d_size` with the host answer's. A changed size fails it.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_07c
          desc: '''A response to the core shall carry its host response's source ID (`d_source`).'''
          source: [
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
          ]
          kind: "spec"
          testpoint: "tf_forward"
          checks: ["answer has host fields (assert_TfForward_AnswerHasHostFields)"]
          why: '''The check compares the answer's `d_source` with the host answer's. An answer joined to the wrong host answer, or with a changed ID, fails it.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_07d
          desc: '''A response to the core shall carry its host response's data.'''
          source: [
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
          ]
          kind: "spec"
          testpoint: "tf_forward"
          checks: ["answer has host fields (assert_TfForward_AnswerHasHostFields)"]
          why: '''The check compares the answer's `d_data` with the host answer's. Another request's data fails it.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_07e
          desc: '''A response to the core shall carry its host response's data integrity.'''
          source: [
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
          ]
          kind: "spec"
          testpoint: "tf_forward"
          checks: ["answer has host fields (assert_TfForward_AnswerHasHostFields)"]
          why: '''The check compares the answer's data integrity with the host answer's. Any change fails it.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_07f
          desc: '''A response to the core shall carry its host response's response integrity, when no meta error is merged in.'''
          source: [
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
          ]
          kind: "spec"
          testpoint: "tf_forward"
          checks: ["answer has host fields (assert_TfForward_AnswerHasHostFields)"]
          why: '''With no meta error merged in, the check compares the answer's response integrity with the host answer's. With a meta error, `tf_errors` checks it.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_08
          desc: '''A read response without an error, to a request that made a meta request, shall carry the tag of its meta response. The tag of an error response is not checked.'''
          source: [
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
            '''[load_store_unit.rst, Protocol](hw/vendor/lowrisc_ibex/doc/03_reference/load_store_unit.rst)'''
          ]
          kind: "spec"
          testpoint: "tf_sticky_tag"
          checks: ["answer tag follows rule (assert_TfStickyTag_AnswerTagFollowsRule)"]
          why: '''For W0 of a capability load without `d_error`, the rule's value is the meta answer's tag. Any other tag fails the check.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_09
          desc: '''The next unaligned read response after an aligned one shall carry the captured tag.'''
          source: [
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
            '''[cheriot.rst, Data Memory Tag Interface](hw/vendor/lowrisc_ibex/doc/03_reference/cheriot.rst)'''
          ]
          kind: "spec"
          testpoint: "tf_sticky_tag"
          checks: ["answer tag follows rule (assert_TfStickyTag_AnswerTagFollowsRule)"]
          why: '''For the W1 after a W0, the rule's value is the captured tag. A W1 that loses or changes it fails.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_10
          desc: '''The captured tag shall be cleared after the unaligned read response that carries it.'''
          source: [
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
          ]
          kind: "spec"
          testpoint: "tf_sticky_tag"
          checks: ["answer tag follows rule (assert_TfStickyTag_AnswerTagFollowsRule)"]
          why: '''A plain load of the upper word right after the capability load reads it again. The rule expects 0; a capture not cleared would return 1 and fail.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_11a
          desc: '''A write response shall be untagged.'''
          source: [
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
          ]
          kind: "spec"
          testpoint: "tf_sticky_tag"
          checks: ["answer tag follows rule (assert_TfStickyTag_AnswerTagFollowsRule)"]
          why: '''For a write, the rule's value is 0. A tagged write answer fails the check.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_11b
          desc: '''A write response shall leave the captured tag unchanged.'''
          source: [
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
          ]
          kind: "spec"
          testpoint: "tf_sticky_tag"
          checks: ["answer tag follows rule (assert_TfStickyTag_AnswerTagFollowsRule)"]
          why: '''A write answered between W0 and W1 must not change the tag W1 receives. On the core's tag filter the case cannot happen: the core sends W1 right after W0. On the engine's tag filter it can, when the engine clears a tag, and the same check decides it there (the revocation engine checker).'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_11c
          desc: '''A read response shall be untagged unless its request was a hinted capability load to a tagged region in CHERIoT mode.'''
          source: [
            '''[cheriot.rst, Data Memory Tag Interface](hw/vendor/lowrisc_ibex/doc/03_reference/cheriot.rst)'''
            '''CHERIoT architecture specification v1.0, section 7.7'''
          ]
          kind: "spec"
          testpoint: "tf_sticky_tag"
          checks: ["answer tag follows rule (assert_TfStickyTag_AnswerTagFollowsRule)"]
          why: '''For a plain load, a load outside the tagged regions or a load in ePMP mode, the rule's value is 0. A tag of 1 fails the check.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_11d
          desc: '''A read response to a request whose tag sideband holds an invalid encoding shall be untagged.'''
          source: [
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
          ]
          kind: "spec"
          testpoint: "tf_sticky_tag"
          checks: ["answer tag follows rule (assert_TfStickyTag_AnswerTagFollowsRule)"]
          why: '''Such a read is not hinted, so the rule's value is 0. A design that takes an invalid encoding as the hint returns the stored tag 1 and fails the check.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_12a
          desc: '''`d_error` towards the core shall be set when the host response has an error.'''
          source: [
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
          ]
          kind: "spec"
          testpoint: "tf_errors"
          checks: ["error when a part has one (assert_TfErrors_ErrorWhenAPartHasOne)"]
          why: '''Whenever the host answer has `d_error`, the check requires it on the answer. A lost error fails.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_12c
          desc: '''`d_error` towards the core shall be set when the meta response has an error.'''
          source: [
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
          ]
          kind: "spec"
          testpoint: "tf_errors"
          checks: ["error when a part has one (assert_TfErrors_ErrorWhenAPartHasOne)"]
          why: '''Whenever the joined meta answer has an error, the check requires `d_error`. A lost tag error fails.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_12b
          desc: '''`d_error` towards the core shall be clear when neither the host nor the meta response has an error.'''
          source: [
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
          ]
          kind: "spec"
          testpoint: "tf_errors"
          checks: ["no error without a cause (assert_TfErrors_NoErrorWithoutACause)"]
          why: '''An answer with `d_error` and no error in either part fails the check.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_13a
          desc: '''When a meta error sets `d_error` on an error-free host response, a valid response integrity shall stay valid.'''
          source: [
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
          ]
          kind: "spec"
          testpoint: "tf_errors"
          checks: ["merged error keeps integrity (assert_TfErrors_MergedErrorKeepsIntegrity)"]
          why: '''With the host integrity valid and only a meta error, the check requires a valid response integrity. A valid answer made to look corrupt fails.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_13b
          desc: '''When a meta error sets `d_error` on an error-free host response, an invalid response integrity shall stay invalid.'''
          source: [
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
          ]
          kind: "spec"
          testpoint: "tf_errors"
          checks: ["merged error keeps integrity (assert_TfErrors_MergedErrorKeepsIntegrity)"]
          why: '''With the host integrity broken, the check requires it still broken. A corrupt answer made to look valid fails.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_14
          desc: '''The meta port shall always accept a meta response.'''
          source: [
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
          ]
          kind: "spec"
          testpoint: "tf_flow"
          checks: ["meta answer taken (assert_TfFlow_MetaAnswerTaken)"]
          why: '''The check looks at every cycle with a meta answer offered. One cycle with `d_ready` at 0 fails it.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_15a
          desc: '''With at most two requests outstanding, the tag filter shall in the end accept every request, given the host and meta ports accept.'''
          source: [
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
          ]
          kind: "spec"
          testpoint: "tf_flow"
          checks: ["request eventually accepted (assert_TfFlow_RequestEventuallyAccepted)"]
          why: '''The formal tool looks for a run where a request waits for ever while the ports keep accepting. Such a run fails the check.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_15b
          desc: '''The tag filter shall in the end answer every accepted request, given the host and meta ports answer.'''
          source: [
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
          ]
          kind: "spec"
          testpoint: "tf_flow"
          checks: ["request eventually answered (assert_TfFlow_RequestEventuallyAnswered)"]
          why: '''The formal tool looks for a run where an accepted request is never answered while the ports keep answering. Such a run fails the check.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_15c
          desc: '''The tag filter shall answer no request twice.'''
          source: [
            '''[Source ID requirements for device elements](hw/ip/tlul/README.md#source-id-requirements-for-device-elements)'''
          ]
          kind: "spec"
          testpoint: "tf_flow"
          checks: ["no extra answer (assert_TfFlow_NoExtraAnswer)"]
          why: '''The first answer uses up the request's credit, so a second answer fails the check.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_16a
          desc: '''A request shall reach the host port in the cycle the core presents it.'''
          source: [
            '''[Timing](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#timing)'''
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
          ]
          kind: "spec"
          testpoint: "tf_forward"
          checks: ["forwarded unchanged (assert_TfForward_ForwardedUnchanged)"]
          why: '''The check requires the host request in the very cycle the core presents it. One cycle late fails it.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_16c
          desc: '''A request that needs a lookup shall reach the meta port in the cycle the core presents it.'''
          source: [
            '''[Timing](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#timing)'''
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
          ]
          kind: "spec"
          testpoint: "tf_lookup"
          checks: ["lookup in same cycle (assert_TfLookup_LookupInSameCycle)"]
          why: '''The check requires the meta request in the very cycle the core presents the request.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_16b
          desc: '''A response shall reach the core in the cycle its last part arrives.'''
          source: [
            '''[Timing](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#timing)'''
          ]
          kind: "spec"
          testpoint: "tf_forward"
          checks: ["answer on last part (assert_TfForward_AnswerOnLastPart)"]
          why: '''The check requires the answer in the cycle the last part arrives, and no earlier. Early or one cycle late fails it.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_17
          desc: '''Every meta request the tag filter generates shall carry a valid command integrity.'''
          source: [
            '''[Description](hw/ip/cheriot_mem_sys/README.md#description)'''
            '''[cheriot_mem_sys.hjson `BUS.INTEGRITY`](hw/ip/cheriot_mem_sys/data/cheriot_mem_sys.hjson)'''
          ]
          kind: "spec"
          testpoint: "tf_lookup"
          checks: ["lookup carries valid integrity (assert_TfLookup_LookupCarriesValidIntegrity)"]
          why: '''The check recomputes the command integrity of every meta request. Nothing else checks it: the TL-UL bus checker leaves every integrity field free.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_18a
          desc: '''A tagged response to the core shall carry `MuBi4True` on `cored_tag_d2h`.'''
          source: [
            '''[Block Diagram](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#block-diagram)'''
            '''[Capability Tag Sideband](hw/top_earlgrey/ip_autogen/rv_core_ibex/doc/theory_of_operation.md#capability-tag-sideband)'''
          ]
          kind: "spec"
          testpoint: "tf_sticky_tag"
          checks: ["answer tag follows rule (assert_TfStickyTag_AnswerTagFollowsRule)"]
          why: '''The check reads tag 1 only from `MuBi4True` (the answer tag of the Terms). A tagged answer sent as `MuBi4False` or as an invalid encoding reads as 0 and fails it.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TF_18b
          desc: '''An untagged response to the core without `d_error` shall carry `MuBi4False` on `cored_tag_d2h`.'''
          source: [
            '''[Block Diagram](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#block-diagram)'''
            '''[Capability Tag Sideband](hw/top_earlgrey/ip_autogen/rv_core_ibex/doc/theory_of_operation.md#capability-tag-sideband)'''
          ]
          kind: "spec"
          testpoint: "tf_sticky_tag"
          checks: ["untagged answer carries MuBi4False (assert_TfStickyTag_UntaggedAnswerCarriesMuBi4False)"]
          why: '''The check compares the answer tag of every untagged answer without `d_error` with `MuBi4False`. An invalid encoding, which the core also reads as 0, fails it. The requirement and the check both leave out an answer with `d_error`.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
      ]
    }
    {
      name: '''WTRC'''
      conditions: [
        '''The rows apply to a capability store to the NVM and to the requests around it.'''
        '''Every other access passes the WTRC unchanged, and the Tag filter rows cover it with the WTRC in place.'''
        '''The WTRC tracks the capability being stored, and it treats a word as out of sequence in four cases ([Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)).'''
        '''With no capability open, a W1 is out of sequence.'''
        '''After a W0, anything except the W1 of the same capability is out of sequence.'''
        '''After a W1 that is neither answered nor turned into a tag write, a W1 and any other request are out of sequence.'''
        '''After the tag write of a W1 is issued, a W1 is out of sequence, and so is a W0 before the W1 is answered.'''
        '''A word is matched when its NVM read succeeded, it is a full-word `PutFullData` in sequence, and its data and data integrity equal the NVM's ([Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)).'''
        '''The proofs present no word that is out of sequence or partial, so the checks decide the rows on a faulty word for its integrity causes only.'''
      ]
      requirements: [
        {
          name: REQ_WTRC_01
          desc: '''A capability store to the NVM shall reach the host port only as a `Get` of the word it targets, never as a write.'''
          source: [
            '''[Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)'''
          ]
          kind: "spec"
          testpoint: "wtrc_store"
          checks: ["sent as a full-word Get (assert_WtrcStore_SentAsAFullWordGet)"]
          why: '''The check requires a `Get` on the host port for every word. A write reaching the NVM fails it.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_WTRC_02
          desc: '''The `Get` that a capability store to the NVM becomes shall carry a valid command integrity.'''
          source: [
            '''[Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)'''
          ]
          kind: "spec"
          testpoint: "wtrc_store"
          checks: ["Get has valid command integrity (assert_WtrcStore_GetHasValidCommandIntegrity)"]
          why: '''The check recomputes the `Get`'s command integrity. The store's own integrity, left on the `Get`, fails it.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_WTRC_03a
          desc: '''W0 of a capability store to the NVM shall issue no meta request.'''
          source: [
            '''[Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)'''
          ]
          kind: "spec"
          testpoint: "wtrc_store"
          checks: ["no lookup for a capability store (assert_WtrcStore_NoLookupForACapabilityStore)"]
          why: '''Any meta request presented for W0 fails the check.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_WTRC_03b
          desc: '''W1 of a capability store to the NVM shall issue no meta request other than its tag write.'''
          source: [
            '''[Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)'''
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
          ]
          kind: "spec"
          testpoint: "wtrc_store"
          checks: ["no lookup for a capability store (assert_WtrcStore_NoLookupForACapabilityStore)"]
          why: '''For W1 only the tag write is allowed; any other meta request fails the check.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_WTRC_04a
          desc: '''W0 shall be answered with `d_error` if its NVM read failed, it is not a full-word `PutFullData`, it is out of sequence, or its data or data integrity differ from the NVM's.'''
          source: [
            '''[Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)'''
          ]
          kind: "spec"
          testpoint: "wtrc_compare"
          checks: ["W0 error on mismatch (assert_WtrcCompare_W0ErrorOnMismatch)", "answer after NVM answer (assert_WtrcCompare_AnswerAfterNvmAnswer)"]
          why: '''The first check requires `d_error` on every W0 that did not match. The second makes sure W0 waits for the NVM answer that decides whether it matched.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_WTRC_04b
          desc: '''W0 shall be answered without `d_error` when it matched.'''
          source: [
            '''[Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)'''
          ]
          kind: "spec"
          testpoint: "wtrc_compare"
          checks: ["W0 error on mismatch (assert_WtrcCompare_W0ErrorOnMismatch)"]
          why: '''The check runs in both directions: a matched W0 answered with `d_error` fails it.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_WTRC_05a
          desc: '''Each word of a capability store to the NVM shall be answered once.'''
          source: [
            '''[Source ID requirements for device elements](hw/ip/tlul/README.md#source-id-requirements-for-device-elements)'''
          ]
          kind: "spec"
          testpoint: "wtrc_store"
          checks: ["no extra answer (assert_TfFlow_NoExtraAnswer)", "request eventually answered (assert_TfFlow_RequestEventuallyAnswered)"]
          why: '''The tag filter's own checks count the answers of every request, capability stores included: at most one, and one in the end.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_WTRC_05b
          desc: '''Each word of a capability store to the NVM shall be answered with an `AccessAck`.'''
          source: [
            '''[Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)'''
          ]
          kind: "spec"
          testpoint: "wtrc_store"
          checks: ["untagged AccessAck answer (assert_WtrcStore_UntaggedAccessAckAnswer)"]
          why: '''The check compares the answer's opcode with `AccessAck`. Any other opcode fails it.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_WTRC_05c
          desc: '''Each word of a capability store to the NVM shall be answered untagged.'''
          source: [
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
          ]
          kind: "spec"
          testpoint: "wtrc_store"
          checks: ["untagged AccessAck answer (assert_WtrcStore_UntaggedAccessAckAnswer)"]
          why: '''The check requires tag 0 on the answer. A tagged answer fails it.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_WTRC_05d
          desc: '''Each word of a capability store to the NVM shall be answered with its request's `a_source` as `d_source`.'''
          source: [
            '''[Source ID requirements for device elements](hw/ip/tlul/README.md#source-id-requirements-for-device-elements)'''
          ]
          kind: "spec"
          testpoint: "wtrc_store"
          checks: ["untagged AccessAck answer (assert_WtrcStore_UntaggedAccessAckAnswer)"]
          why: '''The check compares `d_source` with the word's `a_source`. Another ID fails it.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_WTRC_05e
          desc: '''Each word of a capability store to the NVM shall be answered with a valid response integrity.'''
          source: [
            '''[Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)'''
          ]
          kind: "spec"
          testpoint: "wtrc_store"
          checks: ["untagged AccessAck answer (assert_WtrcStore_UntaggedAccessAckAnswer)"]
          why: '''The check recomputes the answer's response integrity. A broken one fails it.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_WTRC_06a
          desc: '''When W0 and W1 both matched, W1's NVM answer shall be turned into one tag write of tag 1 to the capability's tag bit.'''
          source: [
            '''[Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)'''
            '''No specification states the bit order of the tags within a meta word.'''
          ]
          kind: "spec"
          testpoint: "wtrc_compare"
          checks: ["only the owed tag write (assert_WtrcCompare_OnlyTheOwedTagWrite)", "W1 answered after tag write (assert_WtrcCompare_W1AnsweredAfterTagWrite)"]
          why: '''The first check fixes what the tag write carries: tag 1, the right word and bit. The second makes it happen: W1 cannot be answered until the tag write is answered.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_WTRC_06b
          desc: '''W1's tag write shall be issued only after W1's NVM read has returned.'''
          source: [
            '''[Timing](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#timing)'''
          ]
          kind: "spec"
          testpoint: "wtrc_compare"
          checks: ["only the owed tag write (assert_WtrcCompare_OnlyTheOwedTagWrite)", "no unneeded lookup (assert_TfLookup_NoUnneededLookup)"]
          why: '''A tag write is owed only from W1's NVM answer on. One issued earlier is not owed, so it is a meta request with no credit, and the lookup check fails.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_WTRC_06c
          desc: '''W1's tag write shall reach the meta port before any later lookup.'''
          source: [
            '''[Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)'''
          ]
          kind: "spec"
          testpoint: "wtrc_compare"
          checks: ["only the owed tag write (assert_WtrcCompare_OnlyTheOwedTagWrite)"]
          why: '''While the tag write is owed, the only meta request allowed is the tag write. A lookup presented first fails the check.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_WTRC_07a
          desc: '''W1 shall be answered with `d_error` when the tag write's answer has `d_error`.'''
          source: [
            '''[Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)'''
          ]
          kind: "spec"
          testpoint: "wtrc_compare"
          checks: ["W1 answered after tag write (assert_WtrcCompare_W1AnsweredAfterTagWrite)"]
          why: '''The check requires W1's `d_error` to equal the tag write's. A lost error fails it.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_WTRC_07b
          desc: '''W1 shall be answered without `d_error` when the tag write's answer has none.'''
          source: [
            '''[Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)'''
          ]
          kind: "spec"
          testpoint: "wtrc_compare"
          checks: ["W1 answered after tag write (assert_WtrcCompare_W1AnsweredAfterTagWrite)"]
          why: '''The same equality: an error invented on W1 fails it.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_WTRC_08a
          desc: '''When W0 or W1 did not match, W1 shall be answered with `d_error`.'''
          source: [
            '''[Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)'''
          ]
          kind: "spec"
          testpoint: "wtrc_compare"
          checks: ["W1 error on mismatch (assert_WtrcCompare_W1ErrorOnMismatch)"]
          why: '''When W0 or W1 did not match, the check requires `d_error` on W1.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_WTRC_08b
          desc: '''When W0 or W1 did not match, no tag write shall be issued.'''
          source: [
            '''[Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)'''
          ]
          kind: "spec"
          testpoint: "wtrc_compare"
          checks: ["W1 error on mismatch (assert_WtrcCompare_W1ErrorOnMismatch)", "no unneeded lookup (assert_TfLookup_NoUnneededLookup)"]
          why: '''After a mismatch no tag write is owed, so a tag write is a meta request with no credit, and the lookup check fails.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_WTRC_09
          desc: '''A capability store to the NVM that fails only because its NVM read failed or its data or data integrity differ from the NVM's shall raise no alert.'''
          source: [
            '''[Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)'''
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
          ]
          kind: "spec"
          testpoint: "wtrc_compare"
          checks: ["no alert without a cause (assert_WtrcCompare_NoAlertWithoutACause)"]
          why: '''The fault input may rise only after a faulty word. A mismatch or a failed NVM read is not one, so an alert for it fails the check.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_WTRC_10a
          desc: '''A word of a capability store to the NVM that is out of sequence, partial, carries a bad command or data integrity, or receives an NVM answer with a bad response integrity shall be answered with `d_error`.'''
          source: [
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
          ]
          kind: "spec"
          testpoint: "wtrc_faults"
          checks: ["faulty word answered with error (assert_WtrcFaults_FaultyWordAnsweredWithError)"]
          why: '''The check requires `d_error` on every faulty word. A faulty word answered cleanly fails it.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_WTRC_10b
          desc: '''A word of a capability store to the NVM that is out of sequence, partial, carries a bad command or data integrity, or receives an NVM answer with a bad response integrity shall write no tag.'''
          source: [
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
          ]
          kind: "spec"
          testpoint: "wtrc_faults"
          checks: ["faulty word answered with error (assert_WtrcFaults_FaultyWordAnsweredWithError)", "no unneeded lookup (assert_TfLookup_NoUnneededLookup)"]
          why: '''No tag write is owed after a faulty word, so a tag write is a meta request with no credit, and the lookup check fails.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_WTRC_11
          desc: '''A word of a capability store to the NVM that is out of sequence, partial, carries a bad command or data integrity, or receives an NVM answer with a bad response integrity shall raise `fatal_fault`.'''
          source: [
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
            '''[Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)'''
          ]
          kind: "spec"
          testpoint: "wtrc_faults"
          checks: ["faulty word raises alert (assert_WtrcFaults_FaultyWordRaisesAlert)"]
          why: '''The spec gives no time from the fault to the alert, so the check has no bound. It needs no fairness: nothing outside the design holds the alert back.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_WTRC_13a
          desc: '''Every access that is not a capability store to the NVM shall pass the WTRC unchanged.'''
          source: [
            '''[Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)'''
          ]
          kind: "spec"
          testpoint: "wtrc_store"
          checks: ["forwarded unchanged (assert_TfForward_ForwardedUnchanged)"]
          why: '''The tag filter checks run with the WTRC in place, so a field the WTRC changed on any other access fails them.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_WTRC_13b
          desc: '''Every access that is not a capability store to the NVM shall pass the WTRC with unchanged timing.'''
          source: [
            '''[Write-to-Read-and-Compare Filter (WTRC)](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#write-to-read-and-compare-filter-wtrc)'''
          ]
          kind: "spec"
          testpoint: "wtrc_store"
          checks: ["forwarded unchanged (assert_TfForward_ForwardedUnchanged)", "answer on last part (assert_TfForward_AnswerOnLastPart)"]
          why: '''The same checks require the host request and the answer in the same cycle, with the WTRC in place. A cycle added by the WTRC fails them.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
      ]
    }
    {
      name: '''2:1 tag arbiter'''
      conditions: [
        '''The rows apply to both inputs of the arbiter: the core's tag filter and the engine's tag filter.'''
        '''The Sweep and Decision and clears groups cover what the engine asks for.'''
      ]
      requirements: [
        {
          name: REQ_ARB_01a
          desc: '''Every request accepted on either input shall be forwarded to the RMW filter.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
          ]
          kind: "spec"
          testpoint: "arb_forward"
          checks: ["keeps its own sideband (assert_ArbForward_KeepsItsOwnSideband)"]
          why: '''The check requires the forwarded request in the cycle the input request is accepted. A dropped request fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ARB_01b
          desc: '''No accepted request shall be forwarded to the RMW filter twice.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
          ]
          kind: "spec"
          testpoint: "arb_forward"
          checks: ["from the named input (assert_ArbForward_FromTheNamedInput)"]
          why: '''A forwarded request must match an input request accepted in that cycle. A second copy in a later cycle has none and fails.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ARB_02
          desc: '''No request shall be forwarded that neither input presented.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
          ]
          kind: "spec"
          testpoint: "arb_forward"
          checks: ["from the named input (assert_ArbForward_FromTheNamedInput)"]
          why: '''A forwarded request with no input request behind it fails the check.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ARB_03a
          desc: '''A forwarded request shall carry its input's address unchanged.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
            '''[Source ID requirements for bus primitives](hw/ip/tlul/README.md#source-id-requirements-for-bus-primitives)'''
          ]
          kind: "spec"
          testpoint: "arb_forward"
          checks: ["keeps its own sideband (assert_ArbForward_KeepsItsOwnSideband)"]
          why: '''The check compares the forwarded address with the input request's. Any change fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ARB_03b
          desc: '''A forwarded request shall carry its input's opcode unchanged.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
            '''[Source ID requirements for bus primitives](hw/ip/tlul/README.md#source-id-requirements-for-bus-primitives)'''
          ]
          kind: "spec"
          testpoint: "arb_forward"
          checks: ["keeps its own sideband (assert_ArbForward_KeepsItsOwnSideband)"]
          why: '''The check compares the forwarded opcode with the input request's. A changed opcode fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ARB_03c
          desc: '''A forwarded request shall carry its input's size unchanged.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
            '''[Source ID requirements for bus primitives](hw/ip/tlul/README.md#source-id-requirements-for-bus-primitives)'''
          ]
          kind: "spec"
          testpoint: "arb_forward"
          checks: ["keeps its own sideband (assert_ArbForward_KeepsItsOwnSideband)"]
          why: '''The check compares the forwarded size with the input request's. A changed size fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ARB_03d
          desc: '''A forwarded request shall carry its input's byte mask unchanged.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
            '''[Source ID requirements for bus primitives](hw/ip/tlul/README.md#source-id-requirements-for-bus-primitives)'''
          ]
          kind: "spec"
          testpoint: "arb_forward"
          checks: ["keeps its own sideband (assert_ArbForward_KeepsItsOwnSideband)"]
          why: '''The check compares the forwarded mask with the input request's. A changed mask fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ARB_03e
          desc: '''A forwarded request shall carry its input's data unchanged.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
            '''[Source ID requirements for bus primitives](hw/ip/tlul/README.md#source-id-requirements-for-bus-primitives)'''
          ]
          kind: "spec"
          testpoint: "arb_forward"
          checks: ["keeps its own sideband (assert_ArbForward_KeepsItsOwnSideband)"]
          why: '''The check compares the forwarded data with the input request's. A changed bit fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ARB_03f
          desc: '''A forwarded request shall carry its input's user bits (`a_user`, with its integrity) unchanged.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
            '''[Source ID requirements for bus primitives](hw/ip/tlul/README.md#source-id-requirements-for-bus-primitives)'''
          ]
          kind: "spec"
          testpoint: "arb_forward"
          checks: ["keeps its own sideband (assert_ArbForward_KeepsItsOwnSideband)"]
          why: '''The check compares the forwarded `a_user` with the input request's. A changed bit fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ARB_04a
          desc: '''A forwarded request shall carry its input's tag.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
          ]
          kind: "spec"
          testpoint: "arb_forward"
          checks: ["keeps its own sideband (assert_ArbForward_KeepsItsOwnSideband)"]
          why: '''The check compares the forwarded tag with that of the input it came from. The other input's tag fails it; the check runs with different tags on both inputs at once.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ARB_04b
          desc: '''A forwarded request shall carry its input's bit select.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
          ]
          kind: "spec"
          testpoint: "arb_forward"
          checks: ["keeps its own sideband (assert_ArbForward_KeepsItsOwnSideband)"]
          why: '''The check compares the forwarded bit select with that of its input. The other input's bit select fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ARB_05a
          desc: '''Every answer shall go to the input whose request it answers.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
          ]
          kind: "spec"
          testpoint: "arb_return"
          checks: ["taken with its input (assert_ArbReturn_TakenWithItsInput)"]
          why: '''The RMW filter's answer may be taken only when its own input takes it. An answer lost on the way is taken by no input and fails the check.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ARB_05b
          desc: '''No answer shall go to the input whose request it does not answer.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
          ]
          kind: "spec"
          testpoint: "arb_return"
          checks: ["answer to its input (assert_ArbReturn_AnswerToItsInput)"]
          why: '''An answer at an input whose number is not bit 0 of `d_source` fails the check, and so does an answer at both inputs.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ARB_06
          desc: '''An answer shall carry, as `d_source`, the `a_source` its input sent.'''
          source: [
            '''[Source ID growth](hw/ip/tlul/README.md#source-id-growth)'''
          ]
          kind: "spec"
          testpoint: "arb_return"
          checks: ["source shifted back (assert_ArbReturn_SourceShiftedBack)", "keeps its own sideband (assert_ArbForward_KeepsItsOwnSideband)"]
          why: '''The way out adds the input bit, the RMW filter returns the ID unchanged, and this check removes the bit. Together the requester receives the `a_source` it sent, while its top bit is 0.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ARB_07a
          desc: '''An answer shall reach its input with its opcode unchanged.'''
          source: [
            '''[Timing](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#timing)'''
          ]
          kind: "spec"
          testpoint: "arb_return"
          checks: ["fields unchanged (assert_ArbReturn_FieldsUnchanged)"]
          why: '''The check compares the answer's opcode at the input with the RMW filter's. Any change fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ARB_07b
          desc: '''An answer shall reach its input with its size unchanged.'''
          source: [
            '''[Timing](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#timing)'''
          ]
          kind: "spec"
          testpoint: "arb_return"
          checks: ["fields unchanged (assert_ArbReturn_FieldsUnchanged)"]
          why: '''The check compares the answer's size at the input with the RMW filter's. Any change fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ARB_07c
          desc: '''An answer shall reach its input with its data unchanged.'''
          source: [
            '''[Timing](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#timing)'''
          ]
          kind: "spec"
          testpoint: "arb_return"
          checks: ["fields unchanged (assert_ArbReturn_FieldsUnchanged)"]
          why: '''The check compares the answer's data at the input with the RMW filter's. Any change fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ARB_07d
          desc: '''An answer shall reach its input with its error bit (`d_error`) unchanged.'''
          source: [
            '''[Timing](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#timing)'''
          ]
          kind: "spec"
          testpoint: "arb_return"
          checks: ["fields unchanged (assert_ArbReturn_FieldsUnchanged)"]
          why: '''The check compares `d_error` at the input with the RMW filter's. A hidden or invented error fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ARB_07e
          desc: '''An answer shall reach its input with its user bits (`d_user`, with its integrity) unchanged.'''
          source: [
            '''[Timing](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#timing)'''
          ]
          kind: "spec"
          testpoint: "arb_return"
          checks: ["fields unchanged (assert_ArbReturn_FieldsUnchanged)"]
          why: '''The check compares `d_user` at the input with the RMW filter's. Any change fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ARB_07f
          desc: '''An answer shall reach its input with its tag unchanged.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
          ]
          kind: "spec"
          testpoint: "arb_return"
          checks: ["fields unchanged (assert_ArbReturn_FieldsUnchanged)"]
          why: '''The check compares the tag at the input with the RMW filter's. A changed tag fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ARB_08
          desc: '''A request held on either input shall in the end be accepted, given the RMW filter keeps accepting requests.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
            '''[`tlul_socket_m1`](hw/ip/tlul/README.md#tlul_socket_m1)'''
          ]
          kind: "RTL"
          testpoint: "arb_flow"
          checks: ["no starvation (assert_ArbFlow_NoStarvation)"]
          why: '''The formal tool looks for a run where one input waits for ever while the other keeps winning. A run with input 1 busy in every cycle is one such run, and it fails the check.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open: the arbitration policy is not stated by a specification"
        }
        {
          name: REQ_ARB_09
          desc: '''A request presented while the other input presents none shall reach the RMW filter in the same cycle.'''
          source: [
            '''[Timing](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#timing)'''
          ]
          kind: "spec"
          testpoint: "arb_flow"
          checks: ["alone in same cycle (assert_ArbFlow_AloneInSameCycle)"]
          why: '''The check requires the request at the RMW filter in the very cycle it is presented. A cycle added fails it.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ARB_10
          desc: '''An answer shall reach its input in the cycle the RMW filter gives it.'''
          source: [
            '''[Timing](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#timing)'''
          ]
          kind: "spec"
          testpoint: "arb_flow"
          checks: ["answer at once (assert_ArbFlow_AnswerAtOnce)"]
          why: '''The check requires the answer at its input in the cycle the RMW filter gives it. A cycle added fails it.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ARB_11
          desc: '''A request from the core's tag filter shall reach the RMW filter exactly as the arbiter forwards it.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
            '''[Timing](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#timing)'''
          ]
          kind: "spec"
          testpoint: "arb_forward"
          checks: ["core request unchanged (assert_ArbForward_CoreRequestUnchanged)"]
          why: '''The check compares the request at the RMW filter with the arbiter's output. Any change by the stage in between fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
      ]
    }
    {
      name: '''RMW filter'''
      conditions: [
        '''The rows apply to every request that the 2:1 tag arbiter forwards, whether it is a read or a write.'''
      ]
      requirements: [
        {
          name: REQ_RMW_01
          desc: '''A read shall be forwarded to the meta SRAM at its meta word address.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
          ]
          kind: "spec"
          testpoint: "rmw_read"
          checks: ["Get of its meta word (assert_RmwRead_GetOfItsMetaWord)"]
          why: '''The check compares the `Get`'s address with the read's meta word. Another word fails it.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_RMW_02
          desc: '''A read's response without `d_error` shall return, as the tag, the bit of the response word that its bit select names. The tag of an error response is not checked.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
            '''[load_store_unit.rst, Protocol](hw/vendor/lowrisc_ibex/doc/03_reference/load_store_unit.rst)'''
          ]
          kind: "spec"
          testpoint: "rmw_read"
          checks: ["returns its tag bit (assert_RmwRead_ReturnsItsTagBit)"]
          why: '''The check picks the bit out of the word read and compares it with the answer's tag. Another bit fails it, because the check runs with every neighbouring bit different from its word.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_RMW_03
          desc: '''A write shall first issue a full-word `Get` of its meta word.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
          ]
          kind: "spec"
          testpoint: "rmw_write_skip"
          checks: ["full-word Get first (assert_RmwWriteSkip_FullWordGetFirst)", "answer after Get answer (assert_RmwWriteSkip_AnswerAfterGetAnswer)"]
          why: '''The first check requires a full-word `Get` as the write's first request. The second makes sure the write is not answered before that `Get` comes back.'''
          milestone: "V1"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_RMW_04
          desc: '''A write whose tag equals the stored bit shall issue no write-back.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
          ]
          kind: "spec"
          testpoint: "rmw_write_skip"
          checks: ["no write-back (assert_RmwWriteSkip_NoWriteBack)"]
          why: '''A write-back presented when the bit already equals the tag fails the check.'''
          milestone: "V1"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_RMW_05
          desc: '''A write with no write-back shall be answered with an `AccessAck`.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
          ]
          kind: "spec"
          testpoint: "rmw_write_skip"
          checks: ["answered with AccessAck (assert_RmwWriteSkip_AnsweredWithAccessAck)", "answer after Get answer (assert_RmwWriteSkip_AnswerAfterGetAnswer)"]
          why: '''The first check compares the answer's opcode with `AccessAck`. The second makes sure it comes only once the `Get` answer has arrived.'''
          milestone: "V1"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_RMW_06a
          desc: '''A write whose tag differs from the stored bit shall write back the read word with that bit set to the tag.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
          ]
          kind: "spec"
          testpoint: "rmw_write_back"
          checks: ["carries the updated word (assert_RmwWriteBack_CarriesTheUpdatedWord)"]
          why: '''The check computes the updated word from the word read and compares it with the write-back. A bit not set to the tag fails it.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_RMW_06b
          desc: '''A write-back shall leave every other bit of the read word unchanged.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
          ]
          kind: "spec"
          testpoint: "rmw_write_back"
          checks: ["carries the updated word (assert_RmwWriteBack_CarriesTheUpdatedWord)"]
          why: '''The same comparison covers all 32 bits, so any other bit changed fails it. The check runs with every other bit of the word at 0 and at 1.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_RMW_07a
          desc: '''The write-back shall be a full-word `PutFullData` to the same meta word.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
          ]
          kind: "spec"
          testpoint: "rmw_write_back"
          checks: ["full-word Put to same word (assert_RmwWriteBack_FullWordPutToSameWord)"]
          why: '''The check compares the opcode, the size, the mask and the address with a full-word write to the word read. Any difference fails it.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_RMW_07b
          desc: '''The write-back shall carry a freshly computed command integrity.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
          ]
          kind: "spec"
          testpoint: "rmw_write_back"
          checks: ["full-word Put to same word (assert_RmwWriteBack_FullWordPutToSameWord)"]
          why: '''The check recomputes the write-back's command integrity. The `Get`'s integrity left in place fails it.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_RMW_07c
          desc: '''The write-back shall carry a freshly computed data integrity.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
          ]
          kind: "spec"
          testpoint: "rmw_write_back"
          checks: ["full-word Put to same word (assert_RmwWriteBack_FullWordPutToSameWord)"]
          why: '''The check recomputes the data integrity over the updated word. The integrity of the word read fails it, because one bit changed.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_RMW_08
          desc: '''The write-back's response shall be forwarded as the write's response.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
          ]
          kind: "spec"
          testpoint: "rmw_write_back"
          checks: ["write-back answer passed up (assert_RmwWriteBack_WriteBackAnswerPassedUp)"]
          why: '''The check requires the write's answer in the cycle of the write-back's answer, with its opcode and error. An answer taken from the `Get` fails it.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_RMW_09
          desc: '''Every request issued for a write shall carry the write's `a_source`.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
          ]
          kind: "spec"
          testpoint: "rmw_write_back"
          checks: ["keeps the write's source (assert_RmwWriteBack_KeepsTheWritesSource)"]
          why: '''The check compares the `a_source` of the `Get` and of the write-back with the write's. Another ID fails it.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_RMW_10
          desc: '''A new request shall be accepted only in a cycle with no unanswered operation, or in which the only unanswered operation is a read answered in that cycle.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
          ]
          kind: "spec"
          testpoint: "rmw_single_op"
          checks: ["one operation at a time (assert_RmwSingleOp_OneOperationAtATime)"]
          why: '''A request accepted while an earlier operation is still unanswered, other than a read answered in that cycle, fails the check.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_RMW_11
          desc: '''A read presented in the cycle the previous read is answered shall be accepted in that cycle, if the meta SRAM side is ready.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
          ]
          kind: "spec"
          testpoint: "rmw_read"
          checks: ["back-to-back read accepted (assert_RmwRead_BackToBackReadAccepted)"]
          why: '''The check requires the next read to be accepted in the cycle the previous one is answered. A cycle lost fails it.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_RMW_13
          desc: '''A device error on the `Get` of a write shall abort the write: no write-back.'''
          source: [
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
          ]
          kind: "spec"
          testpoint: "rmw_errors"
          checks: ["Get error stops the write (assert_RmwErrors_GetErrorStopsTheWrite)"]
          why: '''A write-back presented after a `Get` answer with `d_error` fails the check, whether or not the bit differs.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_RMW_14
          desc: '''A device error on a meta SRAM response shall be answered upstream with `d_error`.'''
          source: [
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
          ]
          kind: "spec"
          testpoint: "rmw_errors"
          checks: ["error passed up (assert_RmwErrors_ErrorPassedUp)"]
          why: '''The check requires `d_error` upstream for every operation with an error from the meta SRAM. A lost error fails it.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_RMW_15a
          desc: '''Every accepted request shall in the end be answered, given the meta SRAM answers.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
          ]
          kind: "spec"
          testpoint: "rmw_single_op"
          checks: ["every operation answered (assert_RmwSingleOp_EveryOperationAnswered)"]
          why: '''The formal tool looks for a run where an operation is never answered while the meta SRAM answers. Such a run fails the check.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_RMW_15b
          desc: '''No accepted request shall be answered twice.'''
          source: [
            '''[Source ID requirements for device elements](hw/ip/tlul/README.md#source-id-requirements-for-device-elements)'''
          ]
          kind: "spec"
          testpoint: "rmw_single_op"
          checks: ["one answer per operation (assert_RmwSingleOp_OneAnswerPerOperation)"]
          why: '''After its answer an operation is closed, so a second answer finds no open operation and fails.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_RMW_16a
          desc: '''The RMW filter shall send the meta SRAM at most one `Get` of the meta word per accepted request.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
          ]
          kind: "spec"
          testpoint: "rmw_single_op"
          checks: ["nothing else downstream (assert_RmwSingleOp_NothingElseDownstream)"]
          why: '''Each request allows its `Get` once. A second `Get`, or one with no request, fails the check.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_RMW_16b
          desc: '''The RMW filter shall send the meta SRAM a `PutFullData` write-back only for a write whose tag differs from the stored bit, and at most one per write.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
          ]
          kind: "spec"
          testpoint: "rmw_single_op"
          checks: ["nothing else downstream (assert_RmwSingleOp_NothingElseDownstream)"]
          why: '''A write-back is allowed once, and only for the current write whose bit differs. A write-back for a read, for an equal bit, or a second one fails the check.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_RMW_17
          desc: '''`d_error` upstream shall be clear when neither the `Get` answer nor the write-back answer of the operation has a device error.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
          ]
          kind: "spec"
          testpoint: "rmw_errors"
          checks: ["no error without a cause (assert_RmwErrors_NoErrorWithoutACause)"]
          why: '''An answer with `d_error` whose `Get` and write-back answers had none fails the check.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_RMW_18
          desc: '''Every `Get` the RMW filter generates shall carry a valid command integrity.'''
          source: [
            '''[Description](hw/ip/cheriot_mem_sys/README.md#description)'''
            '''[cheriot_mem_sys.hjson `BUS.INTEGRITY`](hw/ip/cheriot_mem_sys/data/cheriot_mem_sys.hjson)'''
          ]
          kind: "spec"
          testpoint: "rmw_read"
          checks: ["Get carries valid integrity (assert_RmwRead_GetCarriesValidIntegrity)"]
          why: '''The check recomputes the command integrity of every `Get`, for reads and writes. Nothing else checks it: the TL-UL bus checker leaves integrity free.'''
          milestone: "V1"
          priority: "1"
          security: true
          state: "open"
        }
      ]
    }
    {
      name: '''Tag path alerts'''
      conditions: [
        '''The rows state when the tag path raises the fatal alert `fatal_fault`.'''
        '''The proofs present no invalid tag sideband on the upper word of a capability, so no check decides the alert for that word. The plan page lists the case under Out of scope.'''
      ]
      requirements: [
        {
          name: REQ_TAG_07
          desc: '''A device error on the tag path shall raise `fatal_fault`.'''
          source: [
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
          ]
          kind: "spec"
          testpoint: "tag_alerts"
          checks: ["device error raises alert (assert_TagAlerts_DeviceErrorRaisesAlert)"]
          why: '''The formal tool looks for a run where such an answer never raises the alert request. The spec gives no time, so the check has no bound; nothing outside the design holds it back.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TAG_08
          desc: '''An integrity fault on a meta SRAM response to the tag path shall raise `fatal_fault`.'''
          source: [
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
          ]
          kind: "spec"
          testpoint: "tag_alerts"
          checks: ["integrity fault raises alert (assert_TagAlerts_IntegrityFaultRaisesAlert)"]
          why: '''The same, for an answer with a broken integrity, with or without `d_error`.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TAG_12
          desc: '''A core request whose tag sideband holds an invalid encoding shall raise `fatal_fault`.'''
          source: [
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
            '''[cheriot_mem_sys.hjson `CORED_TAG.INTERSIG.MUBI`](hw/ip/cheriot_mem_sys/data/cheriot_mem_sys.hjson)'''
          ]
          kind: "spec"
          testpoint: "tag_alerts"
          checks: ["invalid request tag raises alert (assert_TagAlerts_InvalidRequestTagRaisesAlert)"]
          why: '''The formal tool looks for a run where such a request, a read or a write in either mode, never raises the alert request; the spec gives no time. A design that decodes the sideband without checking its encoding never raises it and fails the check.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
      ]
    }
    {
      name: '''Access checkers'''
      conditions: [
        '''The rows state which requests from the four requester ports reach `meta_sram_tl`, and how the subsystem answers a request that is not legal.'''
        '''Each row is checked at those ports and at `meta_sram_tl`, with the 4:1 arbiter in place.'''
      ]
      requirements: [
        {
          name: REQ_META_01a
          desc: '''A legal request on a requester port shall be forwarded to `meta_sram_tl`.'''
          source: [
            '''[Access Checkers](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#access-checkers)'''
            '''[Arbitration](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#arbitration)'''
          ]
          kind: "spec"
          testpoint: "meta_forward"
          checks: ["legal request forwarded (assert_MetaForward_LegalRequestForwarded)"]
          why: '''The check requires every legal request presented to appear on `meta_sram_tl`. A legal request dropped, or refused with an error answer, never appears and fails it.'''
          milestone: "V1"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_META_01b
          desc: '''A legal request on a requester port shall be forwarded to `meta_sram_tl` at most once.'''
          source: [
            '''[Access Checkers](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#access-checkers)'''
            '''[Arbitration](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#arbitration)'''
          ]
          kind: "spec"
          testpoint: "meta_forward"
          checks: ["no extra meta SRAM request (assert_MetaForward_NoExtraMetaSramRequest)"]
          why: '''A request on `meta_sram_tl` must match a legal request not yet forwarded. A second copy finds its request already forwarded and fails the check.'''
          milestone: "V1"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_META_03
          desc: '''No request outside its port's region shall reach `meta_sram_tl`.'''
          source: [
            '''[Access Checkers](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#access-checkers)'''
            '''[cheriot_mem_sys.hjson `ACCESS_CHECK`](hw/ip/cheriot_mem_sys/data/cheriot_mem_sys.hjson)'''
            '''[cheriot_mem_sys.hjson `MEM.SW_NOACCESS`](hw/ip/cheriot_mem_sys/data/cheriot_mem_sys.hjson)'''
          ]
          kind: "spec"
          testpoint: "meta_refuse"
          checks: ["in own region (assert_MetaRefuse_InOwnRegion)"]
          why: '''The check reads the port from the forwarded source ID and compares the address with that port's region. A bitmap port reaching a tag word, or the tag port reaching the bitmap, fails it.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_META_04
          desc: '''Outside CHERIoT mode, with `cheriot_ena_i` at any value other than `MuBi4True`, no request from any requester port shall reach `meta_sram_tl`.'''
          source: [
            '''[Access Checkers](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#access-checkers)'''
            '''[cheriot_mem_sys.hjson `MODE_GATING`](hw/ip/cheriot_mem_sys/data/cheriot_mem_sys.hjson)'''
            '''[cheriot_mem_sys.hjson `INTERSIG.MUBI`](hw/ip/cheriot_mem_sys/data/cheriot_mem_sys.hjson)'''
          ]
          kind: "spec"
          testpoint: "meta_refuse"
          checks: ["only in CHERIoT mode (assert_MetaRefuse_OnlyInCHERIoTMode)"]
          why: '''The check fails on any request on `meta_sram_tl` while the mode enable is not `MuBi4True`. The check runs with a strict `MuBi4False` and with an invalid encoding.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_META_05
          desc: '''No request that is not a full 32-bit word at a word-aligned address shall reach `meta_sram_tl`.'''
          source: [
            '''[Access Checkers](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#access-checkers)'''
          ]
          kind: "spec"
          testpoint: "meta_refuse"
          checks: ["only full words (assert_MetaRefuse_OnlyFullWords)"]
          why: '''The check fails on any request on `meta_sram_tl` that is not a full word at a word-aligned address. A forwarded one- or two-byte `Get` fails it.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_META_06
          desc: '''No request whose opcode is not `Get` or `PutFullData` shall reach `meta_sram_tl`.'''
          source: [
            '''[Access Checkers](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#access-checkers)'''
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
          ]
          kind: "spec"
          testpoint: "meta_refuse"
          checks: ["only Get or PutFullData (assert_MetaRefuse_OnlyGetOrPutFullData)"]
          why: '''The check fails on any other opcode on `meta_sram_tl`. A forwarded `PutPartialData` fails it.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_META_07a
          desc: '''A request that is not legal shall be answered.'''
          source: [
            '''[Access Checkers](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#access-checkers)'''
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
          ]
          kind: "spec"
          testpoint: "meta_refuse"
          checks: ["request eventually answered (assert_MetaFlow_RequestEventuallyAnswered)"]
          why: '''That check covers every accepted request, refused ones included. The formal tool looks for a run where a refused request is never answered; such a run fails it.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_META_07b
          desc: '''A request that is not legal shall be answered at most once.'''
          source: [
            '''[Access Checkers](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#access-checkers)'''
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
          ]
          kind: "spec"
          testpoint: "meta_refuse"
          checks: ["no extra answer (assert_MetaFlow_NoExtraAnswer)"]
          why: '''An answer must name a request outstanding on its port (the TL-UL rules on each requester port). A second error answer to one request names none and fails the check.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_META_07c
          desc: '''The answer to a request that is not legal shall have `d_error` set.'''
          source: [
            '''[Access Checkers](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#access-checkers)'''
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
          ]
          kind: "spec"
          testpoint: "meta_refuse"
          checks: ["illegal request gets error (assert_MetaRefuse_IllegalRequestGetsError)"]
          why: '''The check looks at the answer to every refused request. An answer with `d_error` at 0 fails it.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_META_16a
          desc: '''An access checker's error answer shall carry a valid response integrity.'''
          source: [
            '''[Usage of User Bits](hw/ip/tlul/README.md#usage-of-user-bits)'''
            '''[Description](hw/ip/cheriot_mem_sys/README.md#description)'''
          ]
          kind: "spec"
          testpoint: "meta_refuse"
          checks: ["error answer carries valid integrity (assert_MetaRefuse_ErrorAnswerCarriesValidIntegrity)"]
          why: '''The check recomputes the response integrity of every error answer. A broken one fails it: a denial software can cause must not become an integrity fault at the requester.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_META_16b
          desc: '''An access checker's error answer to a `Get` shall carry a valid data integrity.'''
          source: [
            '''[Usage of User Bits](hw/ip/tlul/README.md#usage-of-user-bits)'''
            '''[Description](hw/ip/cheriot_mem_sys/README.md#description)'''
          ]
          kind: "spec"
          testpoint: "meta_refuse"
          checks: ["error answer carries valid integrity (assert_MetaRefuse_ErrorAnswerCarriesValidIntegrity)"]
          why: '''The check recomputes the data integrity of the error answer to every refused `Get`. A broken one fails it.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
      ]
    }
    {
      name: '''4:1 arbiter'''
      conditions: [
        '''The rows state how the 4:1 arbiter (`tlul_socket_m1`) carries requests to `meta_sram_tl` and answers back to the four requester ports.'''
        '''Each row is checked at those ports, with the access checkers in place.'''
      ]
      requirements: [
        {
          name: REQ_META_02a
          desc: '''A forwarded request shall carry the opcode (`a_opcode`) of the request it forwards unchanged.'''
          source: [
            '''[Arbitration](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#arbitration)'''
          ]
          kind: "spec"
          testpoint: "meta_forward"
          checks: ["legal request forwarded (assert_MetaForward_LegalRequestForwarded)"]
          why: '''The check compares the forwarded `a_opcode` with the requester's. A `Get` turned into a `PutFullData`, or the reverse, fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_META_02b
          desc: '''A forwarded request shall carry the param (`a_param`) of the request it forwards unchanged.'''
          source: [
            '''[Arbitration](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#arbitration)'''
          ]
          kind: "spec"
          testpoint: "meta_forward"
          checks: ["legal request forwarded (assert_MetaForward_LegalRequestForwarded)"]
          why: '''The check compares the forwarded `a_param` with the requester's. Any changed bit fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_META_02c
          desc: '''A forwarded request shall carry the address (`a_address`) of the request it forwards unchanged.'''
          source: [
            '''[Arbitration](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#arbitration)'''
          ]
          kind: "spec"
          testpoint: "meta_forward"
          checks: ["legal request forwarded (assert_MetaForward_LegalRequestForwarded)"]
          why: '''The check compares the forwarded `a_address` with the requester's. Any changed bit fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_META_02d
          desc: '''A forwarded request shall carry the data (`a_data`) of the request it forwards unchanged.'''
          source: [
            '''[Arbitration](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#arbitration)'''
          ]
          kind: "spec"
          testpoint: "meta_forward"
          checks: ["legal request forwarded (assert_MetaForward_LegalRequestForwarded)"]
          why: '''The check compares the forwarded `a_data` with the requester's. Any changed bit of a write fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_META_02e
          desc: '''A forwarded request shall carry the size (`a_size`) of the request it forwards unchanged.'''
          source: [
            '''[Arbitration](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#arbitration)'''
          ]
          kind: "spec"
          testpoint: "meta_forward"
          checks: ["legal request forwarded (assert_MetaForward_LegalRequestForwarded)"]
          why: '''The check compares the forwarded `a_size` with the requester's. A changed size fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_META_02f
          desc: '''A forwarded request shall carry the byte mask (`a_mask`) of the request it forwards unchanged.'''
          source: [
            '''[Arbitration](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#arbitration)'''
          ]
          kind: "spec"
          testpoint: "meta_forward"
          checks: ["legal request forwarded (assert_MetaForward_LegalRequestForwarded)"]
          why: '''The check compares the forwarded `a_mask` with the requester's. A byte added or dropped fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_META_02g
          desc: '''A forwarded request shall carry the user bits (`a_user`, with its command and data integrity) of the request it forwards unchanged.'''
          source: [
            '''[Arbitration](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#arbitration)'''
          ]
          kind: "spec"
          testpoint: "meta_forward"
          checks: ["legal request forwarded (assert_MetaForward_LegalRequestForwarded)"]
          why: '''The check compares the forwarded `a_user`, its command and data integrity included, with the requester's. Any changed bit fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_META_08
          desc: '''No request shall reach `meta_sram_tl` that no requester port presented.'''
          source: [
            '''[Arbitration](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#arbitration)'''
          ]
          kind: "spec"
          testpoint: "meta_forward"
          checks: ["no extra meta SRAM request (assert_MetaForward_NoExtraMetaSramRequest)"]
          why: '''A request on `meta_sram_tl` with no legal request presented behind it matches nothing and fails the check.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_META_09a
          desc: '''Every answer from `meta_sram_tl` shall reach the requester port whose request it answers.'''
          source: [
            '''[Source ID growth](hw/ip/tlul/README.md#source-id-growth)'''
          ]
          kind: "spec"
          testpoint: "meta_return"
          checks: ["answer to its port (assert_MetaReturn_AnswerToItsPort)", "taken with its port (assert_MetaReturn_TakenWithItsPort)"]
          why: '''The first check requires the answer at the input its source ID names, the second that the meta SRAM's answer is taken only when that port takes it. A dropped answer, or one taken before its port takes it, fails one of them.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_META_09b
          desc: '''No answer from `meta_sram_tl` shall reach a requester port other than the one whose request it answers.'''
          source: [
            '''[Source ID growth](hw/ip/tlul/README.md#source-id-growth)'''
          ]
          kind: "spec"
          testpoint: "meta_return"
          checks: ["only the meta SRAM's answer (assert_MetaReturn_OnlyTheMetaSRAMsAnswer)"]
          why: '''A port that receives an answer must find the meta SRAM sending one to it in that cycle. An answer copied to a second port, or sent to the wrong one, finds none there and fails the check.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_META_10
          desc: '''An answer shall carry, as `d_source`, the `a_source` its requester sent.'''
          source: [
            '''[Source ID requirements for device elements](hw/ip/tlul/README.md#source-id-requirements-for-device-elements)'''
          ]
          kind: "spec"
          testpoint: "meta_return"
          checks: ["source shifted back (assert_MetaReturn_SourceShiftedBack)"]
          why: '''The check compares the answer's `d_source` with the meta SRAM's shifted right by two. With the meta SRAM returning the forwarded source ID, that is the requester's own `a_source`; a wrong shift fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_META_11a
          desc: '''An answer shall reach its requester with its opcode (`d_opcode`) unchanged.'''
          source: [
            '''[Timing](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#timing)'''
            '''[Arbitration](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#arbitration)'''
          ]
          kind: "spec"
          testpoint: "meta_return"
          checks: ["fields unchanged (assert_MetaReturn_FieldsUnchanged)"]
          why: '''The check compares the answer's `d_opcode` with the meta SRAM's. A changed opcode fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_META_11b
          desc: '''An answer shall reach its requester with its error (`d_error`) unchanged.'''
          source: [
            '''[Timing](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#timing)'''
            '''[Arbitration](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#arbitration)'''
          ]
          kind: "spec"
          testpoint: "meta_return"
          checks: ["fields unchanged (assert_MetaReturn_FieldsUnchanged)"]
          why: '''The check compares the answer's `d_error` with the meta SRAM's. An error dropped or added fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_META_11c
          desc: '''An answer shall reach its requester with its param (`d_param`) unchanged.'''
          source: [
            '''[Timing](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#timing)'''
            '''[Arbitration](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#arbitration)'''
          ]
          kind: "spec"
          testpoint: "meta_return"
          checks: ["fields unchanged (assert_MetaReturn_FieldsUnchanged)"]
          why: '''The check compares the answer's `d_param` with the meta SRAM's. Any changed bit fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_META_11d
          desc: '''An answer shall reach its requester with its size (`d_size`) unchanged.'''
          source: [
            '''[Timing](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#timing)'''
            '''[Arbitration](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#arbitration)'''
          ]
          kind: "spec"
          testpoint: "meta_return"
          checks: ["fields unchanged (assert_MetaReturn_FieldsUnchanged)"]
          why: '''The check compares the answer's `d_size` with the meta SRAM's. A changed size fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_META_11e
          desc: '''An answer shall reach its requester with its data (`d_data`) unchanged.'''
          source: [
            '''[Timing](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#timing)'''
            '''[Arbitration](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#arbitration)'''
          ]
          kind: "spec"
          testpoint: "meta_return"
          checks: ["fields unchanged (assert_MetaReturn_FieldsUnchanged)"]
          why: '''The check compares `d_data` in every `AccessAckData` with the meta SRAM's. Any changed data bit fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_META_11f
          desc: '''An answer shall reach its requester with its sink ID (`d_sink`) unchanged.'''
          source: [
            '''[Timing](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#timing)'''
            '''[Arbitration](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#arbitration)'''
          ]
          kind: "spec"
          testpoint: "meta_return"
          checks: ["fields unchanged (assert_MetaReturn_FieldsUnchanged)"]
          why: '''The check compares the answer's `d_sink` with the meta SRAM's. A changed ID fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_META_11g
          desc: '''An answer shall reach its requester with its user bits (`d_user`, with its response and data integrity) unchanged.'''
          source: [
            '''[Timing](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#timing)'''
            '''[Arbitration](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#arbitration)'''
          ]
          kind: "spec"
          testpoint: "meta_return"
          checks: ["fields unchanged (assert_MetaReturn_FieldsUnchanged)"]
          why: '''The check compares the answer's `d_user`, its response and data integrity included, with the meta SRAM's. Any changed bit fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_META_12
          desc: '''A request held on a requester port shall eventually be accepted, given the meta SRAM keeps accepting requests.'''
          source: [
            '''[`tlul_socket_m1`](hw/ip/tlul/README.md#tlul_socket_m1)'''
          ]
          kind: "spec"
          testpoint: "meta_flow"
          checks: ["round robin bound (assert_MetaFlow_RoundRobinBound)", "request eventually accepted (assert_MetaFlow_RequestEventuallyAccepted)"]
          why: '''At the arbiter, a request waits through at most three other grants, so it is granted while the meta SRAM keeps accepting. At the port, the tool looks for a run where a held request waits for ever while the meta SRAM keeps accepting; such a run fails _request eventually accepted_.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_META_13a
          desc: '''Every accepted request shall be answered, given the meta SRAM answers and every requester takes its answers.'''
          source: [
            '''[Source ID requirements for device elements](hw/ip/tlul/README.md#source-id-requirements-for-device-elements)'''
          ]
          kind: "spec"
          testpoint: "meta_flow"
          checks: ["request eventually answered (assert_MetaFlow_RequestEventuallyAnswered)"]
          why: '''The formal tool looks for a run where an accepted request is never answered while the meta SRAM answers and the requesters take their answers. Such a run fails the check.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_META_13b
          desc: '''Every accepted request shall be answered at most once.'''
          source: [
            '''[Source ID requirements for device elements](hw/ip/tlul/README.md#source-id-requirements-for-device-elements)'''
          ]
          kind: "spec"
          testpoint: "meta_flow"
          checks: ["no extra answer (assert_MetaFlow_NoExtraAnswer)"]
          why: '''An answer must name a request outstanding on its port. A second answer to one request names none and fails the check.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_META_14
          desc: '''A legal request presented while no other requester port presents one shall reach `meta_sram_tl` in the same cycle.'''
          source: [
            '''[Timing](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#timing)'''
          ]
          kind: "spec"
          testpoint: "meta_forward"
          checks: ["legal request forwarded (assert_MetaForward_LegalRequestForwarded)"]
          why: '''While no other port presents a request, the check requires the request on `meta_sram_tl` in the very cycle it is presented. One cycle late fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_META_15
          desc: '''An answer from `meta_sram_tl` shall reach its requester in the cycle it arrives.'''
          source: [
            '''[Timing](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#timing)'''
          ]
          kind: "spec"
          testpoint: "meta_return"
          checks: ["answer to its port (assert_MetaReturn_AnswerToItsPort)"]
          why: '''The check requires the answer at its port in the very cycle it arrives on `meta_sram_tl`. One cycle late fails it.'''
          milestone: "V1"
          priority: "2"
          security: false
          state: "open"
        }
      ]
    }
    {
      name: '''Tag store isolation'''
      conditions: [
        '''The rows state which part of the meta SRAM each requester port reaches: the tag port reaches only the capability tag regions, and no other port reaches them.'''
        '''The rows apply the access rules to the tag port.'''
      ]
      requirements: [
        {
          name: REQ_TAG_05
          desc: '''Tag path accesses shall reach only the capability tag regions of the meta SRAM.'''
          source: [
            '''[Access Checkers](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#access-checkers)'''
            '''[Meta SRAM Address Map](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#meta-sram-address-map)'''
          ]
          kind: "spec"
          testpoint: "tag_isolation"
          checks: ["tag port in tag regions (assert_TagIsolation_TagPortInTagRegions)"]
          why: '''The check reads the port from the forwarded source ID and fails on a tag port request outside `0x1100_0C00`-`0x1100_97FF`. A tag port request reaching the bitmap fails it.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TAG_06
          desc: '''Outside CHERIoT mode, no tag path access shall reach the meta SRAM.'''
          source: [
            '''[Access Checkers](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#access-checkers)'''
            '''[cheriot_mem_sys.hjson `INTERSIG.MUBI`](hw/ip/cheriot_mem_sys/data/cheriot_mem_sys.hjson)'''
          ]
          kind: "spec"
          testpoint: "tag_isolation"
          checks: ["tag port only in CHERIoT mode (assert_TagIsolation_TagPortOnlyInCHERIoTMode)"]
          why: '''The check fails on any tag port request on `meta_sram_tl` while the mode enable is not `MuBi4True`. The check runs with all 16 values of the mode enable.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TAG_11
          desc: '''No meta SRAM request from a requester port other than the tag port shall reach a capability tag region.'''
          source: [
            '''[Meta SRAM Address Map](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#meta-sram-address-map)'''
          ]
          kind: "spec"
          testpoint: "tag_isolation"
          checks: ["other ports never reach tags (assert_TagIsolation_OtherPortsNeverReachTags)"]
          why: '''The check fails on any request from ports 0, 2 or 3 inside `0x1100_0C00`-`0x1100_97FF`. Software reading a tag word through `revbm_tl_d` fails it.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
      ]
    }
    {
      name: '''Start, status and interrupt'''
      conditions: [
        '''The rows state which starts the engine takes, the status of a sweep in `TBRE_REGWEN`, `TBRE_STATUS` and `TBRE_EPOCH`, and the `tbre_done` interrupt.'''
      ]
      requirements: [
        {
          name: REQ_TBRE_01
          desc: '''A taken start shall start a sweep over the swept capabilities.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
            '''[cheriot_mem_sys.hjson `TBRE_SWEEP`](hw/ip/cheriot_mem_sys/data/cheriot_mem_sys.hjson)'''
          ]
          kind: "spec"
          testpoint: "tbre_start"
          checks: ["taken start activates (assert_TbreStart_TakenStartActivates)", "REGWEN falls only on start (assert_TbreStart_RegwenFallsOnlyOnStart)"]
          why: '''The first check requires the engine active in the cycle after every taken start, the second lets it become active only then. A design that drops a taken start keeps `TBRE_REGWEN` at 1 and fails the first. Which words the sweep reads is `tbre_sweep`'s.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_02a
          desc: '''An ignored start shall start no sweep.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
          ]
          kind: "spec"
          testpoint: "tbre_start"
          checks: ["REGWEN falls only on start (assert_TbreStart_RegwenFallsOnlyOnStart)"]
          why: '''`TBRE_REGWEN` may fall only in the cycle after a taken start. A sweep started by an ignored start drops it with no taken start before and fails the check.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_02b
          desc: '''An ignored start shall leave `TBRE_STATUS.busy` unchanged.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
          ]
          kind: "spec"
          testpoint: "tbre_start"
          checks: ["ignored start changes nothing (assert_TbreStart_IgnoredStartChangesNothing)"]
          why: '''The check requires the busy field 0 in the cycle after an ignored start, which only comes while the engine is idle. A busy field raised by the start fails it.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_02c
          desc: '''An ignored start shall leave `TBRE_REGWEN` unchanged.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
          ]
          kind: "spec"
          testpoint: "tbre_start"
          checks: ["ignored start changes nothing (assert_TbreStart_IgnoredStartChangesNothing)"]
          why: '''The check requires `TBRE_REGWEN` still 1 in the cycle after an ignored start. A fall fails it.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_02d
          desc: '''An ignored start shall leave `TBRE_EPOCH` unchanged.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
          ]
          kind: "spec"
          testpoint: "tbre_start"
          checks: ["ignored start changes nothing (assert_TbreStart_IgnoredStartChangesNothing)"]
          why: '''The check compares `TBRE_EPOCH` after an ignored start with its value before. Any change fails it.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_03
          desc: '''An ignored start shall set `TBRE_STATUS.start_err`.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
            '''[Revoking Capabilities](hw/ip/cheriot_mem_sys/doc/programmers_guide.md#revoking-capabilities)'''
            '''No specification states how soon the error is set.'''
          ]
          kind: "spec"
          testpoint: "tbre_start"
          checks: ["ignored start sets error (assert_TbreStart_IgnoredStartSetsError)", "error set next cycle (assert_TbreStart_ErrorSetNextCycle)"]
          why: '''The first check looks for a run where an ignored start never receives its set request; the second requires it by the next cycle, so the first read after the start sees it. No document states how soon the error is set, so the check takes the next cycle. A design that skips or delays the set fails one of them.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_04a
          desc: '''`TBRE_STATUS.start_err` shall be set by nothing but an ignored start.'''
          source: [
            '''[Errors](hw/ip/cheriot_mem_sys/doc/programmers_guide.md#errors)'''
          ]
          kind: "spec"
          testpoint: "tbre_start"
          checks: ["error only after ignored start (assert_TbreStart_ErrorOnlyAfterIgnoredStart)"]
          why: '''Each ignored start gives one credit, and its set request uses it up. A set request after a taken start, or a second one for one ignored start, finds no credit and fails the check.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_05a
          desc: '''While `TBRE_REGWEN` is 0, a write to `TBRE_BASE_ADDR` shall have no effect.'''
          source: [
            '''!!TBRE_REGWEN.en'''
            '''[Revoking Capabilities](hw/ip/cheriot_mem_sys/doc/programmers_guide.md#revoking-capabilities)'''
          ]
          kind: "spec"
          testpoint: "csr"
          checks: ["locked base stable (assert_Csr_LockedBaseStable)"]
          why: '''Any change of `TBRE_BASE_ADDR` after a locked cycle fails the check, whatever wrote it.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_05b
          desc: '''While `TBRE_REGWEN` is 0, a write to `TBRE_NUM_CAPS` shall have no effect.'''
          source: [
            '''!!TBRE_REGWEN.en'''
            '''[Revoking Capabilities](hw/ip/cheriot_mem_sys/doc/programmers_guide.md#revoking-capabilities)'''
          ]
          kind: "spec"
          testpoint: "csr"
          checks: ["locked num stable (assert_Csr_LockedNumStable)"]
          why: '''The same, for `TBRE_NUM_CAPS`.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_05c
          desc: '''While `TBRE_REGWEN` is 0, a write to `TBRE_START` shall have no effect.'''
          source: [
            '''!!TBRE_REGWEN.en'''
            '''[Revoking Capabilities](hw/ip/cheriot_mem_sys/doc/programmers_guide.md#revoking-capabilities)'''
          ]
          kind: "spec"
          testpoint: "csr"
          checks: ["locked start no strobe (assert_Csr_LockedStartNoStrobe)"]
          why: '''A locked write to `TBRE_START` that strobes, in its cycle or the next, fails the check.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_06a
          desc: '''`TBRE_BASE_ADDR` shall keep, in its bits 31:3, the value software wrote.'''
          source: [
            '''!!TBRE_BASE_ADDR'''
            '''!!TBRE_REGWEN.en'''
          ]
          kind: "spec"
          testpoint: "csr"
          checks: ["base written (assert_Csr_BaseWritten)", "base changes only by write (assert_Csr_BaseChangesOnlyByWrite)", "read returns register (assert_Csr_ReadReturnsRegister)"]
          why: '''A write lands, nothing else changes the register, and a read returns it: a lost, changed or misread value fails one of them.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_06b
          desc: '''`TBRE_NUM_CAPS` shall keep the value software wrote.'''
          source: [
            '''!!TBRE_NUM_CAPS.num'''
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
          ]
          kind: "spec"
          testpoint: "csr"
          checks: ["num written (assert_Csr_NumWritten)", "num changes only by write (assert_Csr_NumChangesOnlyByWrite)", "read returns register (assert_Csr_ReadReturnsRegister)"]
          why: '''The same, for `TBRE_NUM_CAPS`.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_06c
          desc: '''Bits 2:0 of `TBRE_BASE_ADDR` shall read as zero.'''
          source: [
            '''!!TBRE_BASE_ADDR.addr'''
          ]
          kind: "spec"
          testpoint: "csr"
          checks: ["read returns register (assert_Csr_ReadReturnsRegister)"]
          why: '''A good read with any of bits 2:0 set fails the check.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_07a
          desc: '''`TBRE_REGWEN` shall be 0 from the cycle after a taken start until every swept capability of that sweep is resolved.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
            '''No specification states when a capability counts as resolved.'''
          ]
          kind: "spec"
          testpoint: "tbre_status"
          checks: ["REGWEN low after start (assert_TbreStatus_RegwenLowAfterStart)", "REGWEN rises only when resolved (assert_TbreStatus_RegwenRisesOnlyWhenResolved)"]
          why: '''The first check requires the fall in the cycle after the start; the second fails a rise while any swept capability, the tracked one being any of them, is not yet resolved or anything of the engine is outstanding. No document states when a capability counts as resolved.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_07b
          desc: '''`TBRE_REGWEN` shall be 1 in every cycle outside the span from the cycle after a taken start until every swept capability of that sweep is resolved.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
          ]
          kind: "spec"
          testpoint: "tbre_status"
          checks: ["REGWEN falls only on start (assert_TbreStart_RegwenFallsOnlyOnStart)"]
          why: '''Outside a sweep, `TBRE_REGWEN` may fall only in the cycle after a taken start, so it stays 1 before a sweep. No check requires the rise at the moment every swept capability is resolved, because no document states when a capability counts as resolved; `tbre_done` _sweep ends_ only requires it at some point.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_08
          desc: '''`TBRE_STATUS.busy` shall equal the inverse of `TBRE_REGWEN` one cycle earlier.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
            '''!!TBRE_REGWEN.en'''
          ]
          kind: "spec"
          testpoint: "tbre_status"
          checks: ["busy follows REGWEN (assert_TbreStatus_BusyFollowsRegwen)"]
          why: '''The check compares the busy field with `TBRE_REGWEN` of the cycle before, in every cycle. A busy early, late or stuck fails it.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_09
          desc: '''`TBRE_EPOCH.active` shall equal the inverse of `TBRE_REGWEN` in every cycle.'''
          source: [
            '''!!TBRE_EPOCH.active'''
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
          ]
          kind: "spec"
          testpoint: "tbre_status"
          checks: ["active follows REGWEN (assert_TbreStatus_ActiveFollowsRegwen)"]
          why: '''The check compares the two in every cycle. An active bit one cycle off fails it.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_10
          desc: '''`TBRE_EPOCH.count` shall increase by one, modulo 2^31, in the cycle `TBRE_EPOCH.active` clears, if no error set `TBRE_STATUS.sweep_err` during that sweep.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
            '''!!TBRE_EPOCH.count'''
          ]
          kind: "spec"
          testpoint: "tbre_epoch"
          checks: ["steps unless error (assert_TbreEpoch_StepsUnlessError)"]
          why: '''The check computes the expected count from the old one and the causes seen in the sweep. A missed step, a step of 2 or a wrong wrap fails it.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_11
          desc: '''`TBRE_EPOCH.count` shall not change in any cycle other than one in which `TBRE_EPOCH.active` clears at the end of a sweep during which no error set `TBRE_STATUS.sweep_err`.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
          ]
          kind: "spec"
          testpoint: "tbre_epoch"
          checks: ["steps unless error (assert_TbreEpoch_StepsUnlessError)", "count stable otherwise (assert_TbreEpoch_CountStableOtherwise)"]
          why: '''The first check fails a step at the end of a sweep with an error, the second any change in any other cycle.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_12a
          desc: '''The first register read the register interface accepts after the write of a taken start shall see `TBRE_REGWEN` = 0.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
            '''[Tracking Completed Sweeps](hw/ip/cheriot_mem_sys/doc/programmers_guide.md#tracking-completed-sweeps)'''
          ]
          kind: "spec"
          testpoint: "tbre_status"
          checks: ["REGWEN low after start (assert_TbreStatus_RegwenLowAfterStart)"]
          why: '''The check makes `TBRE_REGWEN` 0 from the cycle after the start. The register interface takes a request at most every other cycle, so the first read it accepts after the start comes no earlier.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_12b
          desc: '''The first register read the register interface accepts after the write of a taken start shall see `TBRE_EPOCH.active` = 1.'''
          source: [
            '''[Tracking Completed Sweeps](hw/ip/cheriot_mem_sys/doc/programmers_guide.md#tracking-completed-sweeps)'''
          ]
          kind: "spec"
          testpoint: "tbre_status"
          checks: ["REGWEN low after start (assert_TbreStatus_RegwenLowAfterStart)", "active follows REGWEN (assert_TbreStatus_ActiveFollowsRegwen)"]
          why: '''The two checks make the epoch odd from the cycle after the start; the request rate keeps the first read from coming earlier.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_12c
          desc: '''The first register read the register interface accepts after the write of a taken start shall see `TBRE_STATUS.busy` = 1.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
            '''[Tracking Completed Sweeps](hw/ip/cheriot_mem_sys/doc/programmers_guide.md#tracking-completed-sweeps)'''
          ]
          kind: "spec"
          testpoint: "tbre_status"
          checks: ["REGWEN low after start (assert_TbreStatus_RegwenLowAfterStart)", "busy follows REGWEN (assert_TbreStatus_BusyFollowsRegwen)"]
          why: '''The two checks make busy 1 two cycles after the start write; taking a request at most every other cycle, the register interface accepts no read before then.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_28
          desc: '''`INTR_STATE.tbre_done` shall be set when the engine stops being active, and when software writes 1 to `INTR_TEST.tbre_done`.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
            '''[Interrupts](hw/ip/cheriot_mem_sys/doc/interfaces.md#interrupts)'''
            '''!!INTR_TEST'''
          ]
          kind: "spec"
          testpoint: "tbre_intr"
          checks: ["sweep end or test sets (assert_TbreIntr_SweepEndOrTestSets)"]
          why: '''The check requires a set request in the cycle `TBRE_REGWEN` rises and in the cycle of a test write. A sweep end or a test write with no set request fails it.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_29a
          desc: '''`INTR_STATE.tbre_done` shall stay set until software writes 1 to it.'''
          source: [
            '''[Tracking Completed Sweeps](hw/ip/cheriot_mem_sys/doc/programmers_guide.md#tracking-completed-sweeps)'''
          ]
          kind: "spec"
          testpoint: "csr"
          checks: ["intr stays set (assert_Csr_IntrStaysSet)"]
          why: '''A clear of `INTR_STATE.tbre_done` without a software write of 1 fails the check.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_29b
          desc: '''A software write of 1 to `INTR_STATE.tbre_done` in the cycle a sweep ends shall leave `INTR_STATE.tbre_done` clear.'''
          source: [
            '''[Tracking Completed Sweeps](hw/ip/cheriot_mem_sys/doc/programmers_guide.md#tracking-completed-sweeps)'''
          ]
          kind: "spec"
          testpoint: "csr"
          checks: ["intr clear wins (assert_Csr_IntrClearWins)"]
          why: '''A write of 1 in the cycle of a set request that leaves the bit set fails the check.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_30
          desc: '''`INTR_STATE.tbre_done` shall be set by nothing but the engine stopping being active and a software write of 1 to `INTR_TEST.tbre_done`.'''
          source: [
            '''[Interrupts](hw/ip/cheriot_mem_sys/doc/interfaces.md#interrupts)'''
          ]
          kind: "spec"
          testpoint: "tbre_intr"
          checks: ["set only on end or test (assert_TbreIntr_SetOnlyOnEndOrTest)"]
          why: '''A set request in any other cycle fails the check.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_31
          desc: '''`intr_tbre_done_o` shall be high exactly when `INTR_STATE.tbre_done` and `INTR_ENABLE.tbre_done` are both set, after one fixed latency of at most one cycle, so that no one-cycle pulse is lost.'''
          source: [
            '''[Register Creation](doc/contributing/hw/comportability/README.md#register-creation)'''
            '''[Event Type Interrupt](doc/contributing/hw/comportability/README.md#event-type-interrupt)'''
          ]
          kind: "spec"
          testpoint: "tbre_intr"
          checks: ["line follows state (assert_TbreIntr_LineFollowsState)"]
          why: '''The check compares the line in every cycle with the enabled state the latency before. A line that misses a one-cycle pulse, or stays high after the state fell, fails it.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
      ]
    }
    {
      name: '''Sweep'''
      conditions: [
        '''The rows state which reads the engine makes on `tbre_tl_h`, and how every sweep ends.'''
      ]
      requirements: [
        {
          name: REQ_TBRE_13
          desc: '''A sweep shall read both words of every swept capability on `tbre_tl_h`, each with a full-word `Get`.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
            '''[cheriot_mem_sys.hjson `TBRE_SWEEP`](hw/ip/cheriot_mem_sys/data/cheriot_mem_sys.hjson)'''
          ]
          kind: "spec"
          testpoint: "tbre_sweep"
          checks: ["both words read (assert_TbreSweep_BothWordsRead)"]
          why: '''The formal tool may choose any swept capability as the tracked one, and the check requires a taken full-word `Get` of each of its words before the sweep ends. A skipped word fails it.'''
          milestone: "V2"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_14
          desc: '''`tbre_tl_h` shall carry no request other than a full-word `Get` of a word of a swept capability of the sweep in progress.'''
          source: [
            '''[Block Diagram](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#block-diagram)'''
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
          ]
          kind: "spec"
          testpoint: "tbre_sweep"
          checks: ["Gets inside sweep (assert_TbreSweep_GetsInsideSweep)"]
          why: '''Every request on the port is compared with the sweep's range, kind and size. A write, a sub-word read, a read outside the range or one while idle fails it.'''
          milestone: "V2"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_15a
          desc: '''At most two reads shall be outstanding on `tbre_tl_h`.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
          ]
          kind: "spec"
          testpoint: "tbre_sweep"
          checks: ["at most two outstanding (assert_TbreSweep_AtMostTwoOutstanding)"]
          why: '''The check counts the reads taken and not yet answered. A third one fails it.'''
          milestone: "V2"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_15b
          desc: '''Each outstanding read on `tbre_tl_h` shall carry an `a_source` that no other outstanding read uses.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
          ]
          kind: "spec"
          testpoint: "tbre_sweep"
          checks: ["at most two outstanding (assert_TbreSweep_AtMostTwoOutstanding)"]
          why: '''The TL-UL ABVIP fails a read whose `a_source` an outstanding read already uses.'''
          milestone: "V2"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_16
          desc: '''The engine shall read every word with the capability-load hint.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
          ]
          kind: "spec"
          testpoint: "tbre_sweep"
          checks: ["Gets carry hint (assert_TbreSweep_GetsCarryHint)"]
          why: '''The check looks at every `Get` at the engine's tag filter. One without the hint fails it.'''
          milestone: "V2"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_37
          desc: '''Every sweep shall end, given `xbar_main`, the bitmap port and the RMW filter answer.'''
          source: [
            '''[Interrupts](hw/ip/cheriot_mem_sys/doc/interfaces.md#interrupts)'''
          ]
          kind: "spec"
          testpoint: "tbre_done"
          checks: ["sweep ends (assert_TbreDone_SweepEnds)"]
          why: '''The formal tool looks for a run, with its neighbours answering, where `TBRE_REGWEN` stays 0 for ever. A sweep that hangs gives one.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_40
          desc: '''Every read the engine generates on `tbre_tl_h` shall carry a valid command integrity.'''
          source: [
            '''[Description](hw/ip/cheriot_mem_sys/README.md#description)'''
            '''[cheriot_mem_sys.hjson `BUS.INTEGRITY`](hw/ip/cheriot_mem_sys/data/cheriot_mem_sys.hjson)'''
          ]
          kind: "spec"
          testpoint: "tbre_sweep"
          checks: ["sweep read carries valid integrity (assert_TbreSweep_SweepReadCarriesValidIntegrity)"]
          why: '''The check recomputes the command integrity of every read presented. Nothing else checks it: the TL-UL ABVIP leaves every integrity field free.'''
          milestone: "V2"
          priority: "1"
          security: true
          state: "open"
        }
      ]
    }
    {
      name: '''Decision and clears'''
      conditions: [
        '''The rows state the bitmap lookup, which swept capabilities are revoked, and the clear through the engine's tag filter.'''
        '''The End-to-end requirements group holds the result of a whole sweep: a revoked capability reads back untagged, and a capability that the core wrote keeps its tag.'''
      ]
      requirements: [
        {
          name: REQ_TBRE_17
          desc: '''For every swept capability that is tagged, not a sealing capability and has its base in the main SRAM region, the engine shall look up the bitmap word that holds its base's revocation bit, with a full-word `Get` on its bitmap port.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
            '''[Meta SRAM Address Map](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#meta-sram-address-map)'''
            '''No specification states when the lookup happens.'''
          ]
          kind: "spec"
          testpoint: "tbre_decision"
          checks: ["lookup when needed (assert_TbreDecision_LookupWhenNeeded)", "lookup is bitmap Get (assert_TbreDecision_LookupIsBitmapGet)"]
          why: '''The first check requires, for any tracked capability that needs one, a full-word `Get` of its base's revocation word in its lookup window (no document states when the lookup happens, so the check takes the time in which the filter holds the capability's W1 answer); the second fails a lookup outside the bitmap or a second one for one W1 answer.'''
          milestone: "V2"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_18
          desc: '''The engine shall make no bitmap lookup for a capability whose base lies outside the main SRAM region.'''
          source: [
            '''[Revoking Capabilities](hw/ip/cheriot_mem_sys/doc/programmers_guide.md#revoking-capabilities)'''
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
          ]
          kind: "spec"
          testpoint: "tbre_decision"
          checks: ["no lookup outside main SRAM (assert_TbreDecision_NoLookupOutsideMainSram)", "lookup is bitmap Get (assert_TbreDecision_LookupIsBitmapGet)"]
          why: '''The first check fails any lookup in the window of a capability whose base is not revocable; the second ties every lookup to a W1 answer, so none escapes the window.'''
          milestone: "V2"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_19
          desc: '''The engine shall present a clear for every revoked swept capability whose reads were answered without error and that no core write touched in its watch window.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
            '''[cheriot_mem_sys.hjson `TBRE_SWEEP`](hw/ip/cheriot_mem_sys/data/cheriot_mem_sys.hjson)'''
          ]
          kind: "spec"
          testpoint: "tbre_decision"
          checks: ["revoked gets cleared (assert_TbreDecision_RevokedGetsCleared)"]
          why: '''The check computes revoked from the decoded base, the permissions and the bitmap word, and requires the clear before the sweep ends. A revoked capability left tagged fails it.'''
          milestone: "V2"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_20
          desc: '''The engine shall present no clear for a tagged swept capability that is not revoked.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
            '''[Revoking Capabilities](hw/ip/cheriot_mem_sys/doc/programmers_guide.md#revoking-capabilities)'''
          ]
          kind: "spec"
          testpoint: "tbre_decision"
          checks: ["clear only if revoked (assert_TbreDecision_ClearOnlyIfRevoked)"]
          why: '''Every clear must belong to a swept capability whose decision is revoked. A clear for a sealing capability, a base outside the main SRAM or a clear bit fails it.'''
          milestone: "V2"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_21a
          desc: '''A clear shall be one tag write, of tag 0.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
          ]
          kind: "spec"
          testpoint: "tbre_clear"
          checks: ["clears tracked bit once (assert_TbreClear_ClearsTrackedBitOnce)", "writes tag 0 (assert_TbreClear_WritesTag0)"]
          why: '''The first check requires the tracked capability's clear as one write of tag 0; the second fails any write from the engine's tag filter that carries tag 1.'''
          milestone: "V2"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_21b
          desc: '''A clear shall address the meta word that holds the capability's tag bit.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
            '''No specification states the bit order of the tags within a meta word.'''
          ]
          kind: "spec"
          testpoint: "tbre_clear"
          checks: ["clears tracked bit once (assert_TbreClear_ClearsTrackedBitOnce)"]
          why: '''The check compares the clear's address with the tag word of the tracked capability. Another word fails it.'''
          milestone: "V2"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_21c
          desc: '''A clear's bit select shall name the capability's tag bit within the meta word.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
            '''No specification states the bit order of the tags within a meta word.'''
          ]
          kind: "spec"
          testpoint: "tbre_clear"
          checks: ["clears tracked bit once (assert_TbreClear_ClearsTrackedBitOnce)"]
          why: '''The check compares the clear's bit select with the tag bit. Another bit fails it.'''
          milestone: "V2"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_21d
          desc: '''A clear shall be presented on the 2:1 tag arbiter's input from the engine's tag filter.'''
          source: [
            '''[RMW Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#rmw-filter)'''
          ]
          kind: "spec"
          testpoint: "tbre_clear"
          checks: ["clears tracked bit once (assert_TbreClear_ClearsTrackedBitOnce)"]
          why: '''The check looks for the clear on arbiter input 1 only. A clear on any other port fails it.'''
          milestone: "V2"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_21e
          desc: '''The engine shall present at most one clear per capability per sweep.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
          ]
          kind: "spec"
          testpoint: "tbre_clear"
          checks: ["clears tracked bit once (assert_TbreClear_ClearsTrackedBitOnce)"]
          why: '''After the tracked capability's clear, a second clear of it in the same sweep fails the check.'''
          milestone: "V2"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_22
          desc: '''The engine's tag filter shall meet the tag filter requirements (`REQ_TF_*`) for reads on its own device, host and meta ports.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
          ]
          kind: "spec"
          testpoint: "tbre_clear"
          checks: ["tag filter checks hold (assert_TbreClear_TagFilterChecksHold)"]
          why: '''The checks of the tag filter testpoints run on this instance's ports. A read that breaks a tag filter rule fails the same check it would on the core's tag filter.'''
          milestone: "V2"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_23a
          desc: '''A write to the engine's tag filter shall issue one meta request, the tag write.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
          ]
          kind: "RTL"
          testpoint: "tbre_clear"
          checks: ["write answered once (assert_TbreClear_WriteAnsweredOnce)"]
          why: '''The check counts the meta requests of each write. None, or two, fails it.'''
          milestone: "V2"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_23b
          desc: '''A write to the engine's tag filter shall issue no host request.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
          ]
          kind: "spec"
          testpoint: "tbre_clear"
          checks: ["write answered once (assert_TbreClear_WriteAnsweredOnce)"]
          why: '''Any request on `tbre_tl_h` for a write fails the check.'''
          milestone: "V2"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_23c
          desc: '''A write to the engine's tag filter shall be answered once.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
          ]
          kind: "RTL"
          testpoint: "tbre_clear"
          checks: ["write answered once (assert_TbreClear_WriteAnsweredOnce)"]
          why: '''The check counts the answers to each write. A lost or a second answer fails it.'''
          milestone: "V2"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_23d
          desc: '''The answer to a write to the engine's tag filter shall carry the error of its tag write.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
          ]
          kind: "RTL"
          testpoint: "tbre_clear"
          checks: ["write answered once (assert_TbreClear_WriteAnsweredOnce)"]
          why: '''The check compares the answer's `d_error` with the meta answer's. A dropped or invented error fails it.'''
          milestone: "V2"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_41
          desc: '''Every bitmap lookup the engine generates shall carry a valid command integrity.'''
          source: [
            '''[Description](hw/ip/cheriot_mem_sys/README.md#description)'''
            '''[cheriot_mem_sys.hjson `BUS.INTEGRITY`](hw/ip/cheriot_mem_sys/data/cheriot_mem_sys.hjson)'''
          ]
          kind: "spec"
          testpoint: "tbre_decision"
          checks: ["lookup carries valid integrity (assert_TbreDecision_LookupCarriesValidIntegrity)"]
          why: '''The check recomputes the command integrity of every lookup presented. Nothing else checks it: the TL-UL ABVIP leaves every integrity field free.'''
          milestone: "V2"
          priority: "1"
          security: true
          state: "open"
        }
      ]
    }
    {
      name: '''Core write watch'''
      conditions: [
        '''The rows state which core writes the subsystem watches during a sweep.'''
        '''They also state how the tag clear squash works: a clear for a capability that the core wrote is never presented, or it reaches the RMW filter as a read.'''
      ]
      requirements: [
        {
          name: REQ_TBRE_24
          desc: '''The engine shall present no clear for a capability that a core write touched in its watch window.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
            '''[cheriot_mem_sys.hjson `TBRE_CORE_WRITE_SNOOP`](hw/ip/cheriot_mem_sys/data/cheriot_mem_sys.hjson)'''
          ]
          kind: "spec"
          testpoint: "tbre_watch"
          checks: ["clear only if untouched (assert_TbreWatch_ClearOnlyIfUntouched)"]
          why: '''The check records every touch of the tracked capability from its W0 read on, and fails a clear presented after one. The window starts and ends at the engine's own read and clear ports.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_25
          desc: '''A clear for a capability that a core write touches between the presentation of the clear and its arrival at the RMW filter shall reach the RMW filter as a read of the tag word, not as a write.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
          ]
          kind: "spec"
          testpoint: "tbre_watch"
          checks: ["stale clear becomes read (assert_TbreWatch_StaleClearBecomesRead)"]
          why: '''The check requires a `Get` of the same word and bit at the RMW filter for a clear touched in its stale window. A clear that still arrives as a write fails it.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_26
          desc: '''A clear that no core write touches between the presentation of the clear and its arrival at the RMW filter shall reach the RMW filter as a write of tag 0.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
          ]
          kind: "spec"
          testpoint: "tbre_watch"
          checks: ["fresh clear stays write (assert_TbreWatch_FreshClearStaysWrite)"]
          why: '''The check compares the request at the RMW filter with what the arbiter forwards. A clear turned into a read with no touch fails it.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_27a
          desc: '''Once a clear is presented at the RMW filter, it shall stay presented until the RMW filter accepts it.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
          ]
          kind: "spec"
          testpoint: "tbre_watch"
          checks: ["clear held unchanged (assert_TbreWatch_ClearHeldUnchanged)"]
          why: '''A clear withdrawn before it is accepted, or displaced by a core write, fails the check in the next cycle.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_TBRE_27b
          desc: '''Once a clear is presented at the RMW filter, it shall stay unchanged until the RMW filter accepts it.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
          ]
          kind: "spec"
          testpoint: "tbre_watch"
          checks: ["clear held unchanged (assert_TbreWatch_ClearHeldUnchanged)"]
          why: '''The check compares every field of the held clear with the cycle before. A changed field, or a squash applied after arrival, fails it.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
      ]
    }
    {
      name: '''Sweep errors'''
      conditions: [
        '''The rows state which errors fail a sweep, by setting `TBRE_STATUS.sweep_err`, and which of them raise `fatal_fault`.'''
      ]
      requirements: [
        {
          name: REQ_TBRE_32a
          desc: '''A sweep read answered with `d_error` shall receive no clear for its capability.'''
          source: [
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
          ]
          kind: "spec"
          testpoint: "tbre_errors"
          checks: ["read error, no clear (assert_TbreErrors_ReadErrorNoClear)"]
          why: '''The formal tool may make any capability the tracked one; a clear for it after a `d_error` on one of its reads fails the check.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_32b
          desc: '''A sweep read answered with `d_error` shall set `TBRE_STATUS.sweep_err`.'''
          source: [
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
            '''No specification states how soon the error is set.'''
          ]
          kind: "spec"
          testpoint: "tbre_errors"
          checks: ["cause sets sweep error (assert_TbreErrors_CauseSetsSweepError)", "error set next cycle (assert_TbreErrors_ErrorSetNextCycle)"]
          why: '''The first check looks for a run where the read error never receives its set request; the second requires it by the next cycle, as no document states how soon the error is set.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_32c
          desc: '''A sweep read answered with `d_error` shall raise no alert.'''
          source: [
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
          ]
          kind: "spec"
          testpoint: "tbre_errors"
          checks: ["engine faults have causes (assert_Contracts_EngineFaultsHaveCauses)"]
          why: '''The contract lets the engine's fault inputs rise only for their listed causes, and a sweep read's `d_error` is not one. A design that raised the alert for it breaks the contract.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_33a
          desc: '''Any error other than a `d_error` answer to a sweep read, any integrity fault and any malformed answer on a response to the engine shall set `TBRE_STATUS.sweep_err`.'''
          source: [
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
            '''!!TBRE_STATUS.sweep_err'''
          ]
          kind: "spec"
          testpoint: "tbre_errors"
          checks: ["cause sets sweep error (assert_TbreErrors_CauseSetsSweepError)", "error set next cycle (assert_TbreErrors_ErrorSetNextCycle)"]
          why: '''Each row of the table is a cause of the first check, so a cause with no set request fails it; the second bounds it to the next cycle. A separate proof reaches malformed answers: it leaves out the TL-UL rules on the opcode and the size of an answer on these ports.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_33b
          desc: '''Any error other than a `d_error` answer to a sweep read, any integrity fault and any malformed answer on a response to the engine shall raise `fatal_fault`.'''
          source: [
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
            '''!!TBRE_STATUS.sweep_err'''
          ]
          kind: "spec"
          testpoint: "tbre_errors"
          checks: ["bad answer raises fault (assert_TbreErrors_BadAnswerRaisesFault)", "device error raises alert (assert_TagAlerts_DeviceErrorRaisesAlert)"]
          why: '''The check requires an engine fault input after a bad answer on `tbre_tl_h`; an answer that raises none fails it. The `d_error` on a tag read or a clear raises the alert in the RMW filter, which a check of the tag path decides.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_34a
          desc: '''An error, integrity fault or malformed answer on a bitmap lookup shall count the capability as revoked.'''
          source: [
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
          ]
          kind: "spec"
          testpoint: "tbre_errors"
          checks: ["revoked gets cleared (assert_TbreDecision_RevokedGetsCleared)"]
          why: '''Revoked includes a failed lookup, so the check requires a clear for a tagged, not sealing capability with a revocable base whose lookup failed. A design that keeps it fails the check.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_34b
          desc: '''An error, integrity fault or malformed answer on a bitmap lookup shall set `TBRE_STATUS.sweep_err`.'''
          source: [
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
          ]
          kind: "spec"
          testpoint: "tbre_errors"
          checks: ["cause sets sweep error (assert_TbreErrors_CauseSetsSweepError)", "error set next cycle (assert_TbreErrors_ErrorSetNextCycle)"]
          why: '''A failed lookup is a cause of the table: no set request, or a late one, fails a check.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_34c
          desc: '''An error, integrity fault or malformed answer on a bitmap lookup shall raise `fatal_fault`.'''
          source: [
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
          ]
          kind: "spec"
          testpoint: "tbre_errors"
          checks: ["bad answer raises fault (assert_TbreErrors_BadAnswerRaisesFault)"]
          why: '''The check requires an engine fault input after any failed lookup. None fails it.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_35a
          desc: '''An RMW filter fault while the engine is active shall set `TBRE_STATUS.sweep_err`.'''
          source: [
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
            '''No specification states which faults of the RMW filter count.'''
          ]
          kind: "spec"
          testpoint: "tbre_errors"
          checks: ["cause sets sweep error (assert_TbreErrors_CauseSetsSweepError)", "error set next cycle (assert_TbreErrors_ErrorSetNextCycle)"]
          why: '''An RMW filter fault while the engine is active is a cause that the Error Handling table of the theory of operation lists. No document states which faults of the RMW filter count, so the check takes every fault that the filter reports.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_35b
          desc: '''An RMW filter fault while the engine is active shall raise `fatal_fault`.'''
          source: [
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
          ]
          kind: "spec"
          testpoint: "tbre_errors"
          checks: ["RMW fault raises alert (assert_TbreErrors_RmwFaultRaisesAlert)"]
          why: '''The check requires the alert request in the cycle the fault input rises while the engine is active. A missed alert fails it.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_36a
          desc: '''`TBRE_STATUS.sweep_err` shall be set by nothing but an error, an integrity fault or a malformed answer on a response to the engine, or an RMW filter fault, during a sweep.'''
          source: [
            '''!!TBRE_STATUS.sweep_err'''
          ]
          kind: "spec"
          testpoint: "tbre_errors"
          checks: ["error only for a cause (assert_TbreErrors_ErrorOnlyForACause)"]
          why: '''Each cause gives one credit and its set request uses it up. A set request with no cause, an RMW fault while idle included, fails the check.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
      ]
    }
    {
      name: '''Register interface'''
      conditions: [
        '''The row states how often the register interface takes a request.'''
        '''The Start, status and interrupt group holds the rows of the sweep registers and of the interrupt state.'''
      ]
      requirements: [
        {
          name: REQ_REG_02
          desc: '''The register interface shall take a request at most every other cycle.'''
          source: [
            '''[Revocation Engine](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#revocation-engine)'''
          ]
          kind: "spec"
          testpoint: "csr"
          checks: ["request every other cycle (assert_Csr_RequestEveryOtherCycle)"]
          why: '''The check looks for two requests taken in consecutive cycles.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
      ]
    }
    {
      name: '''End-to-end requirements'''
      conditions: [
        '''The rows state end-to-end behaviour that no single checker decides.'''
        '''Each row follows from the checks of several checkers, and from the assumption that the meta SRAM returns, for a read, the word last written to that address.'''
        '''The tag rows `REQ_TAG_01` to `REQ_TAG_04` and the sweep row `REQ_TBRE_38` hold from reset until the `Get` of a tag write is answered with no `d_error` and a broken integrity code.'''
        '''From that answer on, the plan claims nothing about the tags.'''
      ]
      requirements: [
        {
          name: REQ_TAG_01
          desc: '''A hinted capability load in CHERIoT mode shall return the tag most recently written to that capability through the tag path: in the order tag writes reach the meta SRAM, a write aborted by an error writing nothing, and a capability never written returning the meta SRAM's starting content.'''
          source: [
            '''[cheriot_mem_sys.hjson `TAG_READ`](hw/ip/cheriot_mem_sys/data/cheriot_mem_sys.hjson)'''
            '''[cheriot_mem_sys.hjson `TAG_SPLIT`](hw/ip/cheriot_mem_sys/data/cheriot_mem_sys.hjson)'''
          ]
          kind: "spec"
          testpoint: "tag_read_after_write"
          checks: ["tag word and bit (assert_TfMetaRequest_TagWordAndBit)", "answer tag follows rule (assert_TfStickyTag_AnswerTagFollowsRule)", "keeps its own sideband (assert_ArbForward_KeepsItsOwnSideband)", "from the named input (assert_ArbForward_FromTheNamedInput)", "core request unchanged (assert_ArbForward_CoreRequestUnchanged)", "answer to its input (assert_ArbReturn_AnswerToItsInput)", "taken with its input (assert_ArbReturn_TakenWithItsInput)", "fields unchanged (assert_ArbReturn_FieldsUnchanged)", "Get of its meta word (assert_RmwRead_GetOfItsMetaWord)", "returns its tag bit (assert_RmwRead_ReturnsItsTagBit)", "carries the updated word (assert_RmwWriteBack_CarriesTheUpdatedWord)", "one operation at a time (assert_RmwSingleOp_OneOperationAtATime)", "nothing else downstream (assert_RmwSingleOp_NothingElseDownstream)", "legal request forwarded (assert_MetaForward_LegalRequestForwarded)", "no extra meta SRAM request (assert_MetaForward_NoExtraMetaSramRequest)", "answer to its port (assert_MetaReturn_AnswerToItsPort)", "source shifted back (assert_MetaReturn_SourceShiftedBack)", "fields unchanged (assert_MetaReturn_FieldsUnchanged)", "taken with its port (assert_MetaReturn_TakenWithItsPort)", "only the meta SRAM's answer (assert_MetaReturn_OnlyTheMetaSRAMsAnswer)", "other ports never reach tags (assert_TagIsolation_OtherPortsNeverReachTags)"]
          why: '''The tag path checker proves the tag filter asks for the right word and bit and returns the meta answer's tag, the arbiter passes each request on unchanged and returns each answer to its input, and the RMW filter reads and writes only that bit, one operation at a time. The meta access checker proves the tag port passes those requests to the meta SRAM unchanged and no other port reaches the tag words. With the meta SRAM keeping what it is given (an assumption of the plan), the tag read back is the one last written.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TAG_02
          desc: '''A write to the main SRAM in CHERIoT mode shall set the addressed capability's tag to the write's tag sideband, so a non-capability write clears it.'''
          source: [
            '''[cheriot_mem_sys.hjson `TAG_CLEAR_ON_DATA_WRITE`](hw/ip/cheriot_mem_sys/data/cheriot_mem_sys.hjson)'''
            '''CHERIoT architecture specification v1.0, section 7.7'''
          ]
          kind: "spec"
          testpoint: "tag_read_after_write"
          checks: ["lookup in same cycle (assert_TfLookup_LookupInSameCycle)", "no unneeded lookup (assert_TfLookup_NoUnneededLookup)", "tag word and bit (assert_TfMetaRequest_TagWordAndBit)", "write carries its tag (assert_TfMetaRequest_WriteCarriesItsTag)", "Get only for a read (assert_TfMetaRequest_GetOnlyForARead)", "keeps its own sideband (assert_ArbForward_KeepsItsOwnSideband)", "from the named input (assert_ArbForward_FromTheNamedInput)", "core request unchanged (assert_ArbForward_CoreRequestUnchanged)", "full-word Get first (assert_RmwWriteSkip_FullWordGetFirst)", "answer after Get answer (assert_RmwWriteSkip_AnswerAfterGetAnswer)", "carries the updated word (assert_RmwWriteBack_CarriesTheUpdatedWord)", "full-word Put to same word (assert_RmwWriteBack_FullWordPutToSameWord)", "nothing else downstream (assert_RmwSingleOp_NothingElseDownstream)", "legal request forwarded (assert_MetaForward_LegalRequestForwarded)", "no extra meta SRAM request (assert_MetaForward_NoExtraMetaSramRequest)"]
          why: '''Every write is looked up once, at the right word and bit, with its sideband as the tag; the arbiter passes it on unchanged; the RMW filter reads the word first and writes back that bit set to the tag; the tag port passes the write-back to the meta SRAM unchanged. A non-capability write has sideband 0, so it clears the tag.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TAG_03
          desc: '''A plain store or an untagged capability store to the NVM shall clear the addressed capability's tag.'''
          source: [
            '''[Storing Capabilities in the NVM](hw/ip/cheriot_mem_sys/doc/programmers_guide.md#storing-capabilities-in-the-nvm)'''
          ]
          kind: "spec"
          testpoint: "tag_read_after_write"
          checks: ["lookup in same cycle (assert_TfLookup_LookupInSameCycle)", "no unneeded lookup (assert_TfLookup_NoUnneededLookup)", "tag word and bit (assert_TfMetaRequest_TagWordAndBit)", "write carries its tag (assert_TfMetaRequest_WriteCarriesItsTag)", "Get only for a read (assert_TfMetaRequest_GetOnlyForARead)", "keeps its own sideband (assert_ArbForward_KeepsItsOwnSideband)", "from the named input (assert_ArbForward_FromTheNamedInput)", "core request unchanged (assert_ArbForward_CoreRequestUnchanged)", "full-word Get first (assert_RmwWriteSkip_FullWordGetFirst)", "answer after Get answer (assert_RmwWriteSkip_AnswerAfterGetAnswer)", "carries the updated word (assert_RmwWriteBack_CarriesTheUpdatedWord)", "full-word Put to same word (assert_RmwWriteBack_FullWordPutToSameWord)", "nothing else downstream (assert_RmwSingleOp_NothingElseDownstream)", "legal request forwarded (assert_MetaForward_LegalRequestForwarded)", "no extra meta SRAM request (assert_MetaForward_NoExtraMetaSramRequest)"]
          why: '''A plain store or an untagged capability store to the NVM is not a capability store to the NVM: it needs a lookup and is a write with sideband 0, so the chain of `REQ_TAG_02` writes tag 0.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TAG_04
          desc: '''A tag write shall change no other capability's tag.'''
          source: [
            '''[cheriot_mem_sys.hjson `TAG_WRITE_RMW`](hw/ip/cheriot_mem_sys/data/cheriot_mem_sys.hjson)'''
          ]
          kind: "spec"
          testpoint: "tag_read_after_write"
          checks: ["tag word and bit (assert_TfMetaRequest_TagWordAndBit)", "keeps its own sideband (assert_ArbForward_KeepsItsOwnSideband)", "core request unchanged (assert_ArbForward_CoreRequestUnchanged)", "carries the updated word (assert_RmwWriteBack_CarriesTheUpdatedWord)", "nothing else downstream (assert_RmwSingleOp_NothingElseDownstream)", "legal request forwarded (assert_MetaForward_LegalRequestForwarded)", "no extra meta SRAM request (assert_MetaForward_NoExtraMetaSramRequest)", "other ports never reach tags (assert_TagIsolation_OtherPortsNeverReachTags)"]
          why: '''The write-back keeps every other bit of its word and is the only write the RMW filter sends; the tag port passes it unchanged and no other port reaches the tag words. So no other capability's tag changes.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TAG_09
          desc: '''Every core request shall be answered, whatever requests the revocation engine's tag filter makes on the shared RMW filter, given `xbar_main` and the meta SRAM answer.'''
          source: [
            '''[Tag Filter](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#tag-filter)'''
          ]
          kind: "spec"
          testpoint: "tag_no_deadlock"
          checks: ["meta answer taken (assert_TfFlow_MetaAnswerTaken)", "request eventually accepted (assert_TfFlow_RequestEventuallyAccepted)", "request eventually answered (assert_TfFlow_RequestEventuallyAnswered)", "no starvation (assert_ArbFlow_NoStarvation)", "one answer per operation (assert_RmwSingleOp_OneAnswerPerOperation)", "every operation answered (assert_RmwSingleOp_EveryOperationAnswered)", "access request accepted and answered (assert_Contracts_AccessRequestAcceptedAndAnswered)", "engine meta answer taken (assert_Contracts_EngineMetaAnswerTaken)"]
          why: '''The core's tag filter always takes its meta answers, so a meta answer never waits on a data answer; the arbiter starves neither input; the RMW filter answers every operation; the meta access accepts and answers, and the engine's tag filter takes its meta answers. So no request of the core waits for ever.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open: its checks follow the fairness of the 2:1 tag arbiter, which no specification states"
        }
        {
          name: REQ_TBRE_38
          desc: '''After a sweep during which no error set `TBRE_STATUS.sweep_err`, every swept capability that was revoked when read, and that no core write touched in its watch window, shall read back untagged until it is written again.'''
          source: [
            '''[cheriot_mem_sys.hjson `TBRE_SWEEP`](hw/ip/cheriot_mem_sys/data/cheriot_mem_sys.hjson)'''
            '''[Tracking Completed Sweeps](hw/ip/cheriot_mem_sys/doc/programmers_guide.md#tracking-completed-sweeps)'''
          ]
          kind: "spec"
          testpoint: "rev_end_to_end"
          checks: ["revoked gets cleared (assert_TbreDecision_RevokedGetsCleared)", "clears tracked bit once (assert_TbreClear_ClearsTrackedBitOnce)", "writes tag 0 (assert_TbreClear_WritesTag0)", "fresh clear stays write (assert_TbreWatch_FreshClearStaysWrite)", "keeps its own sideband (assert_ArbForward_KeepsItsOwnSideband)", "from the named input (assert_ArbForward_FromTheNamedInput)", "full-word Get first (assert_RmwWriteSkip_FullWordGetFirst)", "answer after Get answer (assert_RmwWriteSkip_AnswerAfterGetAnswer)", "carries the updated word (assert_RmwWriteBack_CarriesTheUpdatedWord)", "full-word Put to same word (assert_RmwWriteBack_FullWordPutToSameWord)", "legal request forwarded (assert_MetaForward_LegalRequestForwarded)", "no extra meta SRAM request (assert_MetaForward_NoExtraMetaSramRequest)"]
          why: '''The engine clears every capability revoked when read, as a write of tag 0 to its bit that stays a write while untouched; the arbiter and the RMW filter turn it into a write-back of that bit alone; the tag port passes it to the meta SRAM unchanged. With the meta SRAM keeping what it is given (an assumption of the plan), the capability reads back untagged until written again.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TBRE_39
          desc: '''A capability that a core write touched in its watch window shall keep the tag that write gave it.'''
          source: [
            '''[cheriot_mem_sys.hjson `TBRE_CORE_WRITE_SNOOP`](hw/ip/cheriot_mem_sys/data/cheriot_mem_sys.hjson)'''
          ]
          kind: "spec"
          testpoint: "rev_end_to_end"
          checks: ["clear only if untouched (assert_TbreWatch_ClearOnlyIfUntouched)", "stale clear becomes read (assert_TbreWatch_StaleClearBecomesRead)", "clear held unchanged (assert_TbreWatch_ClearHeldUnchanged)", "lookup in same cycle (assert_TfLookup_LookupInSameCycle)", "forwarded unchanged (assert_TfForward_ForwardedUnchanged)", "alone in same cycle (assert_ArbFlow_AloneInSameCycle)", "one operation at a time (assert_RmwSingleOp_OneOperationAtATime)", "nothing else downstream (assert_RmwSingleOp_NothingElseDownstream)"]
          why: '''The core's write is looked up and forwarded unchanged, passes the 2:1 tag arbiter, and the RMW filter does one operation at a time, so its tag write lands whole. A clear the core's write overtook is not presented, or reaches the RMW filter as a read; a clear at the RMW filter is held there. The RMW filter writes nothing for a read, so the core's tag stays.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_ALT_04
          desc: '''A meta SRAM access in ePMP mode, an access outside its port's region and a `PutPartialData` to the meta SRAM shall raise no alert.'''
          source: [
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
          ]
          kind: "spec"
          testpoint: "alert_causes"
          checks: ["alert only on a fault (assert_AlertCauses_AlertOnlyOnAFault)", "tag path faults have causes (assert_Contracts_TagPathFaultsHaveCauses)", "engine faults have causes (assert_Contracts_EngineFaultsHaveCauses)"]
          why: '''An alert needs a raised fault input, and each fault input rises only for its own listed causes; the three refusals of the meta access are not among them.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_ALT_05
          desc: '''`fatal_fault` shall be requested only for a cause that the Error Handling table of the theory of operation lists, or by `ALERT_TEST`.'''
          source: [
            '''[Error Handling](hw/ip/cheriot_mem_sys/doc/theory_of_operation.md#error-handling)'''
            '''[Security Alerts](hw/ip/cheriot_mem_sys/doc/interfaces.md#security-alerts)'''
          ]
          kind: "spec"
          testpoint: "alert_causes"
          checks: ["alert only on a fault (assert_AlertCauses_AlertOnlyOnAFault)", "tag path faults have causes (assert_Contracts_TagPathFaultsHaveCauses)", "engine faults have causes (assert_Contracts_EngineFaultsHaveCauses)"]
          why: '''The check ties the alert to a raised fault input; the contracts tie each fault input of the tag path and of the engine to its causes. A design that raised the alert with no cause fails one of the links. No check ties the fault input of an invalid tag sideband on a core request to that cause, so the checks decide this row for every other cause.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open: no check ties the fault input of an invalid tag sideband to its cause"
        }
      ]
    }
  ]
}
